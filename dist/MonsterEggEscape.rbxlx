<Item class="ModuleScript" referent="RBX1185"><Properties>
<string name="Name">Config</string>
<ProtectedString name="Source">local Config = {}
Config.Version = 1
Config.SafeZ = 80
Config.ZoneLength = 180
Config.Zones = {
 {Name=&quot;Forest&quot;, Color=Color3.fromRGB(62,185,103), Monster=&quot;Bramble Beast&quot;, Speed=19, Income=3},
 {Name=&quot;Desert&quot;, Color=Color3.fromRGB(244,185,77), Monster=&quot;Dune Scorpion&quot;, Speed=23, Income=8},
 {Name=&quot;Ice&quot;, Color=Color3.fromRGB(99,211,250), Monster=&quot;Frost Yeti&quot;, Speed=27, Income=18},
 {Name=&quot;Lava&quot;, Color=Color3.fromRGB(255,94,52), Monster=&quot;Magma Drake&quot;, Speed=31, Income=40},
 {Name=&quot;Toxic&quot;, Color=Color3.fromRGB(162,239,55), Monster=&quot;Venom Crawler&quot;, Speed=35, Income=85},
 {Name=&quot;Shadow&quot;, Color=Color3.fromRGB(155,91,245), Monster=&quot;Void Reaper&quot;, Speed=39, Income=180},
}
Config.Rarities = {
 {Name=&quot;Common&quot;, Color=Color3.fromRGB(229,241,247), Weight=48, Multiplier=1},
 {Name=&quot;Uncommon&quot;, Color=Color3.fromRGB(94,242,141), Weight=27, Multiplier=2},
 {Name=&quot;Rare&quot;, Color=Color3.fromRGB(74,170,255), Weight=15, Multiplier=4},
 {Name=&quot;Epic&quot;, Color=Color3.fromRGB(195,102,255), Weight=7, Multiplier=8},
 {Name=&quot;Legendary&quot;, Color=Color3.fromRGB(255,193,49), Weight=2.5, Multiplier=18},
 {Name=&quot;Divine&quot;, Color=Color3.fromRGB(255,113,194), Weight=0.5, Multiplier=45},
}
Config.Trails = {
 {Name=&quot;Mint&quot;, Cost=300, Multiplier=1.15, Color=Color3.fromRGB(87,255,184)},
 {Name=&quot;Prism&quot;, Cost=2500, Multiplier=1.35, Color=Color3.fromRGB(93,184,255)},
 {Name=&quot;Solar&quot;, Cost=15000, Multiplier=1.65, Color=Color3.fromRGB(255,195,68)},
 {Name=&quot;Void&quot;, Cost=80000, Multiplier=2, Color=Color3.fromRGB(194,112,255)},
}
return Config
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX1186"><Properties>
<string name="Name">World</string>
<ProtectedString name="Source">local C = require(script.Parent.Config)
local W = {}
function W.Part(parent,name,size,cf,color,material,shape)
 local p=Instance.new(&quot;Part&quot;); p.Name=name; p.Size=size; p.CFrame=cf; p.Color=color; p.Material=material or Enum.Material.SmoothPlastic; p.Anchored=true
 if shape then p.Shape=shape end
 p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth; p.Parent=parent; return p
end
local P=W.Part
function W.Label(part,text,color)
 local gui=Instance.new(&quot;BillboardGui&quot;); gui.Size=UDim2.fromScale(13,3.2); gui.StudsOffset=Vector3.new(0,4,0); gui.AlwaysOnTop=false; gui.MaxDistance=110; gui.Parent=part
 local t=Instance.new(&quot;TextLabel&quot;); t.Size=UDim2.fromScale(1,1); t.BackgroundTransparency=1; t.Font=Enum.Font.GothamBold; t.TextScaled=true; t.Text=text; t.TextColor3=color or Color3.new(1,1,1); t.TextStrokeTransparency=0.35; t.Parent=gui; return t
end
function W.Sign(part,text,color)
 for _,face in {Enum.NormalId.Front,Enum.NormalId.Back} do
  local gui=Instance.new(&quot;SurfaceGui&quot;); gui.Face=face; gui.CanvasSize=Vector2.new(800,300); gui.Parent=part
  local t=Instance.new(&quot;TextLabel&quot;); t.Size=UDim2.fromScale(0.92,0.86); t.Position=UDim2.fromScale(0.04,0.07); t.BackgroundTransparency=1; t.Font=Enum.Font.GothamBold; t.TextScaled=true; t.TextWrapped=true; t.Text=text; t.TextColor3=color or Color3.new(1,1,1); t.Parent=gui
 end
end
function W.Prompt(part,action,object,callback)
 local pr=Instance.new(&quot;ProximityPrompt&quot;); pr.ActionText=action; pr.ObjectText=object; pr.HoldDuration=0.45; pr.MaxActivationDistance=10; pr.RequiresLineOfSight=false; pr.Parent=part
 if callback then pr.Triggered:Connect(callback) end
 return pr
end
function W.Egg(parent,zone,rarity,position)
 local model=Instance.new(&quot;Model&quot;); model.Name=C.Rarities[rarity].Name..&quot;Egg&quot;
 local color=C.Rarities[rarity].Color
 local core=P(model,&quot;Shell&quot;,Vector3.new(2.8,3.7,2.8),CFrame.new(position),color,Enum.Material.SmoothPlastic,Enum.PartType.Ball); core.CanCollide=false
 for n=1,7 do
  local a=n*math.pi*2/7
  local spot=P(model,&quot;Gem&quot;,Vector3.new(0.48,0.65,0.24),CFrame.new(position+Vector3.new(math.sin(a)*1.3,0,math.cos(a)*1.3))*CFrame.Angles(0,a,0),C.Zones[zone].Color,Enum.Material.Neon,Enum.PartType.Ball); spot.CanCollide=false
 end
 local ring=P(model,&quot;Halo&quot;,Vector3.new(0.12,3.5,3.5),CFrame.new(position+Vector3.new(0,2.4,0))*CFrame.Angles(0,0,math.pi/2),color,Enum.Material.Neon,Enum.PartType.Cylinder); ring.CanCollide=false
 if rarity&gt;=4 then local light=Instance.new(&quot;PointLight&quot;); light.Color=color; light.Brightness=1.5; light.Range=12; light.Parent=core end
 if rarity&gt;=3 then
  local fx=Instance.new(&quot;ParticleEmitter&quot;); fx.Name=&quot;RaritySparkles&quot;; fx.Texture=&quot;rbxasset://textures/particles/sparkles_main.dds&quot;; fx.Color=ColorSequence.new(color); fx.LightEmission=0.8; fx.Rate=rarity*2; fx.Lifetime=NumberRange.new(0.5,1.2); fx.Speed=NumberRange.new(0.3,1.5); fx.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,0.3),NumberSequenceKeypoint.new(1,0)}); fx.Parent=core
 end
 model.PrimaryPart=core; model.Parent=parent; return model
end
function W.Monster(parent,index,position)
 local z=C.Zones[index]; local m=Instance.new(&quot;Model&quot;); m.Name=z.Monster
 local dark=z.Color:Lerp(Color3.new(0,0,0),0.5)
 local body=P(m,&quot;Body&quot;,Vector3.new(8,9,6),CFrame.new(position+Vector3.new(0,6,0)),dark,Enum.Material.SmoothPlastic,Enum.PartType.Ball)
 P(m,&quot;Head&quot;,Vector3.new(7,6,6),CFrame.new(position+Vector3.new(0,12,-1)),z.Color,nil,Enum.PartType.Ball)
 for _,s in {-1,1} do
  P(m,&quot;Arm&quot;,Vector3.new(3,7,3),CFrame.new(position+Vector3.new(s*5,6,0))*CFrame.Angles(0,0,s*0.25),dark,nil,Enum.PartType.Ball)
  P(m,&quot;Foot&quot;,Vector3.new(3,3,5),CFrame.new(position+Vector3.new(s*2.4,1.7,-1)),z.Color,nil,Enum.PartType.Ball)
  P(m,&quot;Eye&quot;,Vector3.new(1.6,1.3,0.7),CFrame.new(position+Vector3.new(s*1.7,12.5,-3.7)),Color3.fromRGB(255,69,92),Enum.Material.Neon,Enum.PartType.Ball)
  P(m,&quot;Pupil&quot;,Vector3.new(0.45,1,0.3),CFrame.new(position+Vector3.new(s*1.7,12.5,-4.1)),Color3.new(0.03,0.02,0.06),nil,Enum.PartType.Ball)
  for n=1,3 do P(m,&quot;Claw&quot;,Vector3.new(0.5,1.8,0.6),CFrame.new(position+Vector3.new(s*(4+n*0.5),2.5,-1)),Color3.fromRGB(255,238,205),nil,Enum.PartType.Ball) end
  local horn=P(m,&quot;Horn&quot;,Vector3.new(1.3,4,1.3),CFrame.new(position+Vector3.new(s*2.6,16,0))*CFrame.Angles(0,0,-s*0.4),Color3.fromRGB(255,225,163),nil,Enum.PartType.Ball)
 end
 P(m,&quot;Mouth&quot;,Vector3.new(3.5,1.1,0.6),CFrame.new(position+Vector3.new(0,10.3,-3.6)),Color3.fromRGB(33,16,38),nil,Enum.PartType.Ball)
 for n=1,5 do P(m,&quot;Tooth&quot;,Vector3.new(0.38,0.8,0.4),CFrame.new(position+Vector3.new(n*0.58-1.74,10.5,-4)),Color3.new(1,1,0.9),nil,Enum.PartType.Ball) end
 for n=1,5 do P(m,&quot;BackSpine&quot;,Vector3.new(1.5,2+n%2,2),CFrame.new(position+Vector3.new(0,5+n*1.7,3)),z.Color,Enum.Material.Neon,Enum.PartType.Ball) end
 if index==2 or index==5 then
  for _,s in {-1,1} do for n=1,4 do P(m,&quot;CrawlerLeg&quot;,Vector3.new(6,0.8,1),CFrame.new(position+Vector3.new(s*5,2,n*2-5))*CFrame.Angles(0,s*0.4,s*0.3),z.Color,nil,Enum.PartType.Ball) end end
 elseif index==4 then
  for _,s in {-1,1} do P(m,&quot;Wing&quot;,Vector3.new(9,1,7),CFrame.new(position+Vector3.new(s*6,10,3))*CFrame.Angles(0,0,s*0.5),dark,nil,Enum.PartType.Ball) end
 elseif index==6 then
  P(m,&quot;VoidCrown&quot;,Vector3.new(0.3,9,9),CFrame.new(position+Vector3.new(0,18,0))*CFrame.Angles(0,0,math.pi/2),z.Color,Enum.Material.Neon,Enum.PartType.Cylinder)
 end
 if index==1 then
  for _,s in {-1,1} do
   for n=1,4 do P(m,&quot;AntlerBranch&quot;,Vector3.new(0.7,3.8,0.7),CFrame.new(position+Vector3.new(s*(2.5+n*0.7),15+n*0.65,0))*CFrame.Angles(0,0,-s*(0.3+n*0.15)),Color3.fromRGB(139,95,53),Enum.Material.Wood,Enum.PartType.Ball) end
   for n=1,3 do P(m,&quot;LeafMane&quot;,Vector3.new(3,2,3),CFrame.new(position+Vector3.new(s*3.6,8+n*1.2,1)),Color3.fromRGB(102,210,90),Enum.Material.Grass,Enum.PartType.Ball) end
  end
 elseif index==2 then
  for n=1,6 do P(m,&quot;ArmoredTail&quot;,Vector3.new(2.7,2.7,2.7),CFrame.new(position+Vector3.new(0,2+n*1.5,3+n)),z.Color,Enum.Material.Sandstone,Enum.PartType.Ball) end
  P(m,&quot;VenomStinger&quot;,Vector3.new(1.5,4,1.5),CFrame.new(position+Vector3.new(0,12,8))*CFrame.Angles(0.7,0,0),Color3.fromRGB(72,30,91),Enum.Material.Neon,Enum.PartType.Ball)
 elseif index==3 then
  for _,s in {-1,1} do
   for n=1,5 do P(m,&quot;FrostFur&quot;,Vector3.new(2.2,3,2.2),CFrame.new(position+Vector3.new(s*(2+n*0.55),10-n*0.55,0)),Color3.fromRGB(231,251,255),Enum.Material.Snow,Enum.PartType.Ball) end
   P(m,&quot;IceTusk&quot;,Vector3.new(0.8,3,0.8),CFrame.new(position+Vector3.new(s*1.5,9.6,-4)),Color3.fromRGB(190,243,255),Enum.Material.Ice,Enum.PartType.Ball)
  end
 elseif index==4 then
  for n=1,7 do P(m,&quot;DrakeTail&quot;,Vector3.new(3-n*0.3,2.4-n*0.2,3),CFrame.new(position+Vector3.new(math.sin(n*0.5)*2,3,3+n*1.8)),dark,Enum.Material.Basalt,Enum.PartType.Ball) end
  for _,s in {-1,1} do P(m,&quot;Nostril&quot;,Vector3.new(0.7,0.7,0.7),CFrame.new(position+Vector3.new(s*0.7,11.8,-4)),Color3.fromRGB(255,210,65),Enum.Material.Neon,Enum.PartType.Ball) end
 elseif index==5 then
  for n=1,8 do P(m,&quot;ToxinBlister&quot;,Vector3.new(1.5,1.5,1.5),CFrame.new(position+Vector3.new(math.sin(n)*3.7,5+n*0.75,math.cos(n)*3)),Color3.fromRGB(220,255,53),Enum.Material.Neon,Enum.PartType.Ball) end
  for _,s in {-1,1} do P(m,&quot;Antenna&quot;,Vector3.new(0.5,5,0.5),CFrame.new(position+Vector3.new(s*2,17,-1))*CFrame.Angles(0,0,-s*0.35),dark,nil,Enum.PartType.Ball) end
 else
  for n=1,7 do P(m,&quot;ShadowWisp&quot;,Vector3.new(1.3,6,1.3),CFrame.new(position+Vector3.new(math.sin(n)*4,3,math.cos(n)*3))*CFrame.Angles(0,0,math.sin(n)*0.3),z.Color,Enum.Material.Neon,Enum.PartType.Ball) end
 end
 local aura=Instance.new(&quot;ParticleEmitter&quot;); aura.Name=&quot;RageAura&quot;; aura.Texture=&quot;rbxasset://textures/particles/sparkles_main.dds&quot;; aura.Color=ColorSequence.new(z.Color); aura.Rate=18; aura.Enabled=false; aura.Speed=NumberRange.new(2,5); aura.Lifetime=NumberRange.new(0.4,1); aura.LightEmission=1; aura.Parent=body
 for _,p in m:GetChildren() do if p:IsA(&quot;BasePart&quot;) then p.CanCollide=false; p.CanTouch=false end end
 m.PrimaryPart=body; W.Label(body,z.Monster..&quot;\nGUARDIAN&quot;,z.Color); m.Parent=parent; return m
end
function W.Build()
 local existing=workspace:FindFirstChild(&quot;MonsterEggEscape&quot;); if existing then return existing end
 local root=Instance.new(&quot;Folder&quot;); root.Name=&quot;MonsterEggEscape&quot;; root.Parent=workspace
 local baseplate=workspace:FindFirstChild(&quot;Baseplate&quot;); if baseplate and baseplate:IsA(&quot;BasePart&quot;) then baseplate.Transparency=1; baseplate.CanCollide=false end
 local hub=Instance.new(&quot;Folder&quot;); hub.Name=&quot;Sanctuary&quot;; hub.Parent=root
 P(hub,&quot;SafeFloor&quot;,Vector3.new(150,3,155),CFrame.new(0,-1.5,2.5),Color3.fromRGB(39,51,79))
 for _,x in {-74,74} do P(hub,&quot;NeonEdge&quot;,Vector3.new(1,0.3,155),CFrame.new(x,0.2,2.5),Color3.fromRGB(67,255,204),Enum.Material.Neon) end
 local spawn=Instance.new(&quot;SpawnLocation&quot;); spawn.Name=&quot;SanctuarySpawn&quot;; spawn.Size=Vector3.new(12,1,12); spawn.Position=Vector3.new(0,0.5,-48); spawn.Anchored=true; spawn.Neutral=true; spawn.Duration=0; spawn.Color=Color3.fromRGB(65,209,179); spawn.Parent=hub
 local gate=P(hub,&quot;SafeGate&quot;,Vector3.new(146,0.4,2),CFrame.new(0,0.3,80),Color3.fromRGB(72,255,197),Enum.Material.Neon)
 W.Label(gate,&quot;SANCTUARY • BANK YOUR EGGS&quot;,Color3.fromRGB(109,255,206))
 local sign=P(hub,&quot;Title&quot;,Vector3.new(50,10,2),CFrame.new(0,19,-69),Color3.fromRGB(22,28,48)); W.Sign(sign,&quot;MONSTER EGG ESCAPE\nSTEAL • RUN • GROW&quot;,Color3.fromRGB(255,217,103))
 for _,x in {-27,27} do P(hub,&quot;TitleSupport&quot;,Vector3.new(1,22,1),CFrame.new(x,10,-69),Color3.fromRGB(76,237,198),Enum.Material.Neon) end
 for n=1,12 do P(hub,&quot;CenterPaving&quot;,Vector3.new(20,0.1,8),CFrame.new(0,0.08,-58+n*11),n%2==0 and Color3.fromRGB(55,70,99) or Color3.fromRGB(48,62,89)) end
 for _,x in {-77,77} do P(hub,&quot;SanctuaryBoundary&quot;,Vector3.new(4,8,155),CFrame.new(x,3,2.5),Color3.fromRGB(34,45,66),Enum.Material.Slate) end
 P(hub,&quot;SanctuaryRear&quot;,Vector3.new(154,8,4),CFrame.new(0,3,-77),Color3.fromRGB(34,45,66),Enum.Material.Slate)
 for i=1,6 do
  local z=C.Zones[i]; local section=Instance.new(&quot;Folder&quot;); section.Name=z.Name; section.Parent=root
  local center=80+(i-0.5)*C.ZoneLength
  local materials={Enum.Material.Grass,Enum.Material.Sand,Enum.Material.Snow,Enum.Material.Basalt,Enum.Material.Mud,Enum.Material.Slate}
  P(section,&quot;Ground&quot;,Vector3.new(150,3,C.ZoneLength),CFrame.new(0,-1.5,center),z.Color,materials[i])
  P(section,&quot;Runway&quot;,Vector3.new(28,0.16,C.ZoneLength),CFrame.new(0,0.1,center),z.Color:Lerp(Color3.new(1,1,1),0.3))
  for _,x in {-77,77} do
   P(section,&quot;HighWall&quot;,Vector3.new(6,42,C.ZoneLength),CFrame.new(x,20,center),z.Color:Lerp(Color3.fromRGB(31,34,54),0.65),Enum.Material.Slate)
   P(section,&quot;WallGlow&quot;,Vector3.new(0.3,0.4,C.ZoneLength),CFrame.new(x&gt;0 and 73.8 or -73.8,11,center),z.Color,Enum.Material.Neon)
  end
  local arch=P(section,&quot;ZoneSign&quot;,Vector3.new(46,6,2),CFrame.new(0,24,center-83),z.Color:Lerp(Color3.new(0,0,0),0.6)); W.Sign(arch,string.upper(z.Name)..&quot;\n&quot;..z.Monster,z.Color)
  for _,x in {-24,24} do P(section,&quot;ArchColumn&quot;,Vector3.new(2,26,3),CFrame.new(x,12,center-83),z.Color,Enum.Material.Neon) end
  local rng=Random.new(120+i)
  for n=1,18 do
   local x=(n%2==0 and 1 or -1)*rng:NextNumber(36,65); local zz=center+rng:NextNumber(-75,75)
   if i==1 then
    P(section,&quot;Trunk&quot;,Vector3.new(12,3,3),CFrame.new(x,6,zz)*CFrame.Angles(0,0,math.pi/2),Color3.fromRGB(112,77,52),Enum.Material.Wood,Enum.PartType.Cylinder)
    for k=1,3 do P(section,&quot;Canopy&quot;,Vector3.new(13-k*2,10,13-k*2),CFrame.new(x,11+k*3,zz),z.Color:Lerp(Color3.fromRGB(20,80,56),k/5),Enum.Material.Grass,Enum.PartType.Ball) end
   else
    local crystal=P(section,&quot;Crystal&quot;,Vector3.new(rng:NextNumber(3,7),rng:NextNumber(5,17),4),CFrame.new(x,4,zz)*CFrame.Angles(0,rng:NextNumber(0,6),0.2),z.Color, i&gt;=4 and Enum.Material.Neon or Enum.Material.Glass); crystal.Transparency=i==3 and 0.2 or 0
    P(section,&quot;Stone&quot;,Vector3.new(8,3,8),CFrame.new(x,1,zz),z.Color:Lerp(Color3.new(0,0,0),0.45),Enum.Material.Slate,Enum.PartType.Ball)
   end
  end
  if i&gt;=3 then
   for n=1,6 do
    local x=n%2==0 and 52 or -52; local zz=center-80+n*24
    local pool=P(section,&quot;EnergyPool&quot;,Vector3.new(0.15,17,23),CFrame.new(x,0.15,zz)*CFrame.Angles(0,0,math.pi/2),z.Color, i==3 and Enum.Material.Ice or Enum.Material.Neon,Enum.PartType.Cylinder)
    pool.CanCollide=false
   end
  end
  for n=1,8 do P(section,&quot;PathLight&quot;,Vector3.new(1,0.2,4),CFrame.new(n%2==0 and 16 or -16,0.25,center-85+n*20),Color3.fromRGB(255,245,198),Enum.Material.Neon) end
  task.wait()
 end
 P(root,&quot;EndWall&quot;,Vector3.new(150,42,5),CFrame.new(0,20,1163),C.Zones[6].Color,Enum.Material.Slate)
 for i=1,8 do
  local x=i%2==0 and 51 or -51; local z=-48+math.floor((i-1)/2)*32
  local plot=Instance.new(&quot;Model&quot;); plot.Name=&quot;Plot&quot;..i; plot:SetAttribute(&quot;Owner&quot;,0); plot.Parent=hub
  local floor=P(plot,&quot;Floor&quot;,Vector3.new(32,0.5,27),CFrame.new(x,0.3,z),Color3.fromRGB(95,148,112),Enum.Material.Grass); W.Label(floor,&quot;AVAILABLE SANCTUARY&quot;,Color3.fromRGB(206,255,221))
  for _,dx in {-16,16} do
   for n=0,4 do P(plot,&quot;FencePost&quot;,Vector3.new(0.7,4,0.7),CFrame.new(x+dx,2,z-13+n*6.5),Color3.fromRGB(151,106,64),Enum.Material.Wood) end
   for _,y in {1.4,3} do P(plot,&quot;FenceRail&quot;,Vector3.new(0.5,0.5,26),CFrame.new(x+dx,y,z),Color3.fromRGB(185,135,81),Enum.Material.Wood) end
  end
  for _,y in {1.4,3} do P(plot,&quot;BackRail&quot;,Vector3.new(32,0.5,0.5),CFrame.new(x,y,z+13),Color3.fromRGB(185,135,81),Enum.Material.Wood) end
 end
 local light=game:GetService(&quot;Lighting&quot;); light.ClockTime=14; light.Brightness=2.5; light.Ambient=Color3.fromRGB(145,154,184)
 if not light:FindFirstChild(&quot;EggBloom&quot;) then local b=Instance.new(&quot;BloomEffect&quot;); b.Name=&quot;EggBloom&quot;; b.Intensity=0.3; b.Size=24; b.Threshold=1.3; b.Parent=light end
 return root
end
function W.Preview(root)
 local old=root:FindFirstChild(&quot;Preview&quot;); if old then old:Destroy() end
 local preview=Instance.new(&quot;Folder&quot;); preview.Name=&quot;Preview&quot;; preview.Parent=root
 for i=1,6 do
  W.Monster(preview,i,Vector3.new(0,0,80+(i-0.5)*180+35))
  for slot=1,3 do
   local e=W.Egg(preview,i,math.min(i,6),Vector3.new(slot%2==0 and -24 or 24,2.8,80+(i-1)*180+45+slot*28))
   W.Label(e.PrimaryPart,C.Rarities[math.min(i,6)].Name,C.Rarities[math.min(i,6)].Color)
  end
  task.wait()
 end
 for i=1,3 do
  local x=-18+(i-1)*18
  local belt=P(preview,&quot;Treadmill&quot;,Vector3.new(12,0.8,16),CFrame.new(x,0.5,14),Color3.fromRGB(28,32,49),Enum.Material.Metal)
  for n=1,8 do P(preview,&quot;BeltStripe&quot;,Vector3.new(10,0.1,0.25),CFrame.new(x,0.96,6+n*1.8),Color3.fromRGB(79,213,237),Enum.Material.Neon) end
  for _,dx in {-6,6} do P(preview,&quot;Handrail&quot;,Vector3.new(0.5,4,16),CFrame.new(x+dx,2,14),Color3.fromRGB(79,92,121),Enum.Material.Metal) end
  W.Label(belt,&quot;TREADMILL&quot;,Color3.fromRGB(108,226,255))
 end
 for i,t in C.Trails do local board=P(preview,t.Name..&quot;TrailBoard&quot;,Vector3.new(10,6,1),CFrame.new(-22+(i-1)*14,4,60),t.Color); W.Sign(board,t.Name..&quot; TRAIL\n&quot;..t.Multiplier..&quot;x - $&quot;..t.Cost) end
 for _,v in {{&quot;SPEED UPGRADE&quot;,-20,Color3.fromRGB(44,158,212)},{&quot;STORAGE UPGRADE&quot;,20,Color3.fromRGB(125,89,196)}} do local board=P(preview,v[1],Vector3.new(10,6,1),CFrame.new(v[2],4,-53),v[3]); W.Sign(board,v[1]) end
end
return W
</ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="ServerScriptService"><Properties><string name="Name">ServerScriptService</string></Properties>
<Item class="Script" referent="RBX1187"><Properties>
<string name="Name">MonsterEggServer</string>
<ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local DSS=game:GetService(&quot;DataStoreService&quot;)
local Http=game:GetService(&quot;HttpService&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local C=require(RS.MonsterEgg.Config)
local W=require(RS.MonsterEgg.World)
local world=W.Build()
local preview=world:FindFirstChild(&quot;Preview&quot;); if preview then preview:Destroy() end
local event=Instance.new(&quot;RemoteEvent&quot;); event.Name=&quot;Notice&quot;; event.Parent=RS.MonsterEgg
local profiles,carried,plots,eggs,monsters={},{},{},{},{}
local session=game.JobId~=&quot;&quot; and game.JobId or Http:GenerateGUID(false)
local store
local storeReady,storeError=pcall(function() store=DSS:GetDataStore(&quot;MonsterEggEscape_v1&quot;) end)
if not storeReady then warn(&quot;[MonsterEgg] DataStore unavailable: &quot;..tostring(storeError)) end
local function notice(p,s) event:FireClient(p,s) end
local function root(p) return p.Character and p.Character:FindFirstChild(&quot;HumanoidRootPart&quot;) end
local function alive(p) local h=p.Character and p.Character:FindFirstChildOfClass(&quot;Humanoid&quot;); return h and h.Health&gt;0 end
local function near(p,part,d) local r=root(p); return r and alive(p) and (r.Position-part.Position).Magnitude&lt;=d end
local function sync(p)
 local d=profiles[p]; if not d then return end
 for _,key in {&quot;Cash&quot;,&quot;Speed&quot;,&quot;Training&quot;,&quot;Trail&quot;,&quot;Capacity&quot;} do p:SetAttribute(key,d[key]) end
 local income=0; for _,e in d.Eggs do income+=C.Zones[e.Zone].Income*C.Rarities[e.Rarity].Multiplier end
 p:SetAttribute(&quot;Income&quot;,income); p:SetAttribute(&quot;EggCount&quot;,#d.Eggs)
 p.leaderstats.Cash.Value=math.floor(d.Cash)
 local h=p.Character and p.Character:FindFirstChildOfClass(&quot;Humanoid&quot;)
 if h then h.WalkSpeed=(20+d.Speed*2+math.min(d.Training,100)*0.15)*(d.Trail&gt;0 and C.Trails[d.Trail].Multiplier or 1) end
end
local function trail(p)
 local r=root(p); local d=profiles[p]; if not r or not d then return end
 for _,v in r:GetChildren() do if v.Name==&quot;EggTrail&quot; then v:Destroy() end end
 if d.Trail==0 then return end
 local a=Instance.new(&quot;Attachment&quot;); a.Name=&quot;EggTrail&quot;; a.Position=Vector3.new(-0.8,0.1,0); a.Parent=r
 local b=a:Clone(); b.Position=Vector3.new(0.8,0.1,0); b.Parent=r
 local t=Instance.new(&quot;Trail&quot;); t.Name=&quot;EggTrail&quot;; t.Attachment0=a; t.Attachment1=b; t.Lifetime=0.6; t.LightEmission=1; t.Color=ColorSequence.new(C.Trails[d.Trail].Color); t.Parent=r
end
local function redraw(p)
 local plot=plots[p]; local d=profiles[p]; if not plot or not d then return end
 local old=plot:FindFirstChild(&quot;BankedEggs&quot;); if old then old:Destroy() end
 local folder=Instance.new(&quot;Folder&quot;); folder.Name=&quot;BankedEggs&quot;; folder.Parent=plot
 for n,e in d.Eggs do
  local pos=plot.Floor.Position+Vector3.new(((n-1)%4-1.5)*6,2.5,math.floor((n-1)/4)*6-8)
  local m=W.Egg(folder,e.Zone,e.Rarity,pos)
  W.Label(m.PrimaryPart,C.Rarities[e.Rarity].Name..&quot; • $&quot;..C.Zones[e.Zone].Income*C.Rarities[e.Rarity].Multiplier..&quot;/s&quot;,C.Rarities[e.Rarity].Color)
 end
end
local function drop(p)
 local item=carried[p]; if not item then return end
 carried[p]=nil; if item.Model then item.Model:Destroy() end
 p:SetAttribute(&quot;Carrying&quot;,&quot;&quot;); p:SetAttribute(&quot;Rage&quot;,0)
end
local function carry(p,data)
 if carried[p] or not profiles[p] or #profiles[p].Eggs&gt;=profiles[p].Capacity then notice(p,&quot;Your sanctuary is full — upgrade storage!&quot;); return false end
 local r=root(p); if not r then return false end
 local model=W.Egg(world,data.Zone,data.Rarity,r.Position+Vector3.new(0,3.8,0))
 local pr=W.Prompt(model.PrimaryPart,&quot;Steal egg&quot;,p.DisplayName..&quot;'s egg&quot;)
 carried[p]={Zone=data.Zone,Rarity=data.Rarity,Model=model,Prompt=pr,Since=os.clock()}
 p:SetAttribute(&quot;Carrying&quot;,C.Rarities[data.Rarity].Name..&quot; &quot;..C.Zones[data.Zone].Name..&quot; Egg&quot;); p:SetAttribute(&quot;Rage&quot;,data.Rarity)
 pr.Triggered:Connect(function(thief)
  local item=carried[p]; local a=root(p); local b=root(thief)
  if thief==p or not item or item.Model~=model or not a or not b or not near(thief,model.PrimaryPart,12) then return end
  if a.Position.Z&lt;=C.SafeZ or b.Position.Z&lt;=C.SafeZ or os.clock()-item.Since&lt;2 then return end
  if carried[thief] or not profiles[thief] or #profiles[thief].Eggs&gt;=profiles[thief].Capacity then return end
  local payload={Zone=item.Zone,Rarity=item.Rarity}; drop(p)
  carry(thief,payload); notice(p,&quot;Your egg was stolen!&quot;); notice(thief,&quot;Stolen! Run to the sanctuary!&quot;)
 end)
 notice(p,&quot;EGG TAKEN! Run back to the green sanctuary!&quot;); return true
end
local function spawnEgg(zone,slot)
 local rarity=1; local roll=Random.new():NextNumber(0,100); local total=0
 for i,r in C.Rarities do total+=r.Weight; if roll&lt;=total then rarity=i; break end end
 local z=80+(zone-1)*180+45+slot*28
 local pos=Vector3.new(slot%2==0 and -24 or 24,2.8,z)
 local model=W.Egg(world,zone,rarity,pos)
 local pedestal=W.Part(model,&quot;Nest&quot;,Vector3.new(6,0.6,6),CFrame.new(pos.X,0.4,pos.Z),C.Zones[zone].Color:Lerp(Color3.new(0,0,0),0.4),Enum.Material.Slate,Enum.PartType.Cylinder)
 pedestal.CFrame=CFrame.new(pos.X,0.4,pos.Z)*CFrame.Angles(0,0,math.pi/2); pedestal.Size=Vector3.new(0.6,6,6)
 W.Label(model.PrimaryPart,C.Rarities[rarity].Name..&quot;\n$&quot;..C.Zones[zone].Income*C.Rarities[rarity].Multiplier..&quot;/s&quot;,C.Rarities[rarity].Color)
 local taken=false
 W.Prompt(model.PrimaryPart,&quot;Take egg&quot;,C.Zones[zone].Name..&quot; nest&quot;,function(p)
  if taken or not near(p,model.PrimaryPart,12) or carried[p] then return end
  if carry(p,{Zone=zone,Rarity=rarity}) then taken=true; eggs[model]=nil; model:Destroy(); task.delay(12,function() spawnEgg(zone,slot) end) end
 end)
 eggs[model]=pos
end
local function save(p,release)
 local d=profiles[p]; if not d or not d.Persistent or d.Saving then return end
 d.Saving=true
 local payload={Cash=d.Cash,Speed=d.Speed,Training=d.Training,Trail=d.Trail,Capacity=d.Capacity,Eggs=table.clone(d.Eggs)}
 local written
 local ok,err=pcall(function() written=store:UpdateAsync(&quot;p&quot;..p.UserId,function(old)
  if not old or not old.Lock or old.Lock.Id~=session then return nil end
  if release then payload.Lock=nil else payload.Lock={Id=session,Time=os.time()} end; return payload
 end) end)
 d.Saving=false
 if not ok then
  p:SetAttribute(&quot;SaveStatus&quot;,&quot;Save delayed - retrying next autosave&quot;)
  warn(&quot;[MonsterEgg] Save failed: &quot;..tostring(err))
 elseif not written then
  d.Persistent=false; p:SetAttribute(&quot;SaveStatus&quot;,&quot;Save session lost&quot;)
  if p.Parent==Players then p:Kick(&quot;Your save session changed. Please rejoin to protect progress.&quot;) end
 else p:SetAttribute(&quot;SaveStatus&quot;,&quot;Cloud save connected&quot;) end
end
local function load(p)
 local loaded
 local ok,err=pcall(function()
  assert(store,storeError or &quot;DataStore unavailable&quot;)
  loaded=store:UpdateAsync(&quot;p&quot;..p.UserId,function(old)
   old=old or {Cash=0,Speed=0,Training=0,Trail=0,Capacity=8,Eggs={}}
   if old.Lock and old.Lock.Id~=session and os.time()-old.Lock.Time&lt;180 then return nil end
   old.Lock={Id=session,Time=os.time()}; return old
  end)
 end)
 if not ok and not Run:IsStudio() then p:Kick(&quot;Progress could not load. Please rejoin; your saved data is safe.&quot;); return end
 if ok and not loaded then p:Kick(&quot;Your progress is open on another server. Please rejoin shortly.&quot;); return end
 local d=loaded or {Cash=0,Speed=0,Training=0,Trail=0,Capacity=8,Eggs={}}
 d.Persistent=ok; profiles[p]=d
 if p.Parent~=Players then save(p,true); profiles[p]=nil; return end
 p:SetAttribute(&quot;SaveStatus&quot;,ok and &quot;Cloud save connected&quot; or &quot;STUDIO: temporary progress (API unavailable)&quot;)
 if not ok then warn(&quot;[MonsterEgg] Studio temporary session: &quot;..tostring(err)) end
 local stats=Instance.new(&quot;Folder&quot;); stats.Name=&quot;leaderstats&quot;; stats.Parent=p
 local cash=Instance.new(&quot;IntValue&quot;); cash.Name=&quot;Cash&quot;; cash.Parent=stats
 for i=1,8 do local plot=world.Sanctuary:FindFirstChild(&quot;Plot&quot;..i); if (plot:GetAttribute(&quot;Owner&quot;) or 0)==0 then plots[p]=plot; plot:SetAttribute(&quot;Owner&quot;,p.UserId); plot.Floor.BillboardGui.TextLabel.Text=p.DisplayName..&quot;'S SANCTUARY&quot;; break end end
 if not plots[p] then save(p,true); profiles[p]=nil; p:Kick(&quot;Sanctuaries full. Please join another server.&quot;); return end
 local function character(char)
  local h=char:WaitForChild(&quot;Humanoid&quot;); char:WaitForChild(&quot;HumanoidRootPart&quot;); sync(p); trail(p)
  char:PivotTo(CFrame.lookAt(Vector3.new(0,4,-43),Vector3.new(0,4,80)))
  h.Died:Connect(function() drop(p) end)
 end
 p.CharacterAdded:Connect(character); if p.Character then task.spawn(character,p.Character) end
 redraw(p); sync(p)
end
for i=1,6 do
 local z=80+(i-0.5)*180
 local model=W.Monster(world,i,Vector3.new(0,0,z+35)); monsters[i]={Model=model,Home=model:GetPivot(),Phase=0}
 for s=1,3 do spawnEgg(i,s) end
end
local function board(name,pos,color,action,callback)
 local p=W.Part(world.Sanctuary,name,Vector3.new(10,6,1),CFrame.new(pos),color)
 W.Sign(p,name..&quot;\n&quot;..action,Color3.new(1,1,1)); W.Prompt(p,action,name,function(player) if near(player,p,12) and profiles[player] then callback(player,profiles[player]) end end); return p
end
board(&quot;SPEED UPGRADE&quot;,Vector3.new(-20,4,-53),Color3.fromRGB(44,158,212),&quot;Cost: $100 x (level+1)^2&quot;,function(p,d)
 local cost=100*(d.Speed+1)^2; if d.Speed&gt;=50 then notice(p,&quot;Speed maxed!&quot;); elseif d.Cash&gt;=cost then d.Cash-=cost; d.Speed+=1; sync(p); notice(p,&quot;Speed upgraded!&quot;); else notice(p,&quot;Need $&quot;..cost) end
end)
board(&quot;STORAGE UPGRADE&quot;,Vector3.new(20,4,-53),Color3.fromRGB(125,89,196),&quot;Buy 4 slots&quot;,function(p,d)
 local cost=500*2^((d.Capacity-8)/4); if d.Capacity&gt;=16 then notice(p,&quot;Storage maxed: 16 eggs&quot;); elseif d.Cash&gt;=cost then d.Cash-=cost; d.Capacity+=4; sync(p); else notice(p,&quot;Need $&quot;..cost) end
end)
for i,t in C.Trails do
 board(t.Name..&quot; TRAIL&quot;,Vector3.new(-22+(i-1)*14,4,60),t.Color,t.Multiplier..&quot;× • $&quot;..t.Cost,function(p,d)
  if d.Trail&gt;=i then notice(p,&quot;You already own an equal or faster trail&quot;); elseif d.Cash&gt;=t.Cost then d.Cash-=t.Cost; d.Trail=i; trail(p); sync(p); notice(p,t.Name..&quot; trail equipped!&quot;); else notice(p,&quot;Need $&quot;..t.Cost) end
 end)
end
for i=1,3 do
 local x=-18+(i-1)*18
 local belt=W.Part(world.Sanctuary,&quot;Treadmill&quot;..i,Vector3.new(12,0.8,16),CFrame.new(x,0.5,14),Color3.fromRGB(28,32,49),Enum.Material.Metal)
 for n=1,8 do W.Part(world.Sanctuary,&quot;BeltStripe&quot;,Vector3.new(10,0.1,0.25),CFrame.new(x,0.96,6+n*1.8),Color3.fromRGB(79,213,237),Enum.Material.Neon) end
 for _,dx in {-6,6} do W.Part(world.Sanctuary,&quot;Handrail&quot;,Vector3.new(0.5,4,16),CFrame.new(x+dx,2,14),Color3.fromRGB(79,92,121),Enum.Material.Metal) end
 W.Label(belt,&quot;TREADMILL\nStand here: +speed +cash&quot;,Color3.fromRGB(108,226,255))
end
Players.PlayerAdded:Connect(load); for _,p in Players:GetPlayers() do task.spawn(load,p) end
Players.PlayerRemoving:Connect(function(p)
 drop(p); while profiles[p] and profiles[p].Saving do task.wait(0.1) end; save(p,true)
 local plot=plots[p]; if plot then plot:SetAttribute(&quot;Owner&quot;,0); plot.Floor.BillboardGui.TextLabel.Text=&quot;AVAILABLE SANCTUARY&quot;; local f=plot:FindFirstChild(&quot;BankedEggs&quot;); if f then f:Destroy() end end
 profiles[p]=nil; plots[p]=nil
end)
local tickCount=0; local accumulated=0
Run.Heartbeat:Connect(function(dt)
 accumulated+=dt; dt=math.min(dt,0.1)
 for p,item in carried do
  local r=root(p)
  if r and alive(p) then
   item.Model:PivotTo(CFrame.new(r.Position+Vector3.new(0,3.8,0))*CFrame.Angles(0,os.clock(),0))
   if r.Position.Z&lt;=C.SafeZ and math.abs(r.Position.X)&lt;=73 and r.Position.Y&lt;20 then
    local d=profiles[p]; if d and #d.Eggs&lt;d.Capacity then table.insert(d.Eggs,{Zone=item.Zone,Rarity=item.Rarity}); drop(p); redraw(p); sync(p); notice(p,&quot;SAFE! Egg banked — passive income increased!&quot;) end
   end
  else drop(p) end
 end
 for index,m in monsters do
  local target,dist,rarity=nil,math.huge,1
  for p,item in carried do
   local r=root(p)
   if r and alive(p) and r.Position.Z&gt;C.SafeZ and item.Zone==index then
    local d=(r.Position-m.Model:GetPivot().Position).Magnitude; if d&lt;dist then target=p; dist=d; rarity=item.Rarity end
   end
  end
  local pivot=m.Model:GetPivot(); local pos=pivot.Position
  local destination=target and root(target).Position or m.Home.Position
  local delta=Vector3.new(destination.X-pos.X,0,destination.Z-pos.Z)
  if delta.Magnitude&gt;0.5 then
   local speed=target and C.Zones[index].Speed*(1+(rarity-1)*0.13) or 13
   local nextPos=pos+delta.Unit*math.min(delta.Magnitude,speed*dt); nextPos=Vector3.new(math.clamp(nextPos.X,-66,66),m.Home.Position.Y,math.max(C.SafeZ+8,nextPos.Z))
   m.Model:PivotTo(CFrame.lookAt(nextPos,nextPos+delta.Unit))
  end
  m.Model:SetAttribute(&quot;Raging&quot;,target~=nil and rarity&gt;=4)
  m.Model.PrimaryPart.RageAura.Enabled=target~=nil and rarity&gt;=4
  m.Model.PrimaryPart.BillboardGui.TextLabel.Text=C.Zones[index].Monster..(target and (rarity&gt;=4 and &quot;\nMONSTER RAGE!&quot; or &quot;\nCHASING!&quot;) or &quot;\nGUARDIAN&quot;)
  if target and dist&lt;8 then local h=target.Character and target.Character:FindFirstChildOfClass(&quot;Humanoid&quot;); drop(target); if h then h.Health=0 end; notice(target,&quot;The guardian caught you! Train speed and try again.&quot;) end
 end
 if accumulated&gt;=1 then
  accumulated-=1; tickCount+=1
  for p,d in profiles do
   local income=0; for _,e in d.Eggs do income+=C.Zones[e.Zone].Income*C.Rarities[e.Rarity].Multiplier end
   d.Cash+=income
   local r=root(p)
   if r and alive(p) and r.Position.Z&gt;=6 and r.Position.Z&lt;=22 and r.Position.Y&lt;6 then
    for i=1,3 do if math.abs(r.Position.X-(-18+(i-1)*18))&lt;5.5 then d.Training=math.min(100,d.Training+0.15); d.Cash+=2+d.Speed; break end end
   end
   sync(p)
  end
  if tickCount%60==0 then for p in profiles do task.spawn(save,p,false) end end
 end
end)
-- Server-only test seam. Never created on published servers.
if Run:IsStudio() then
 local qa=Instance.new(&quot;BindableFunction&quot;); qa.Name=&quot;MonsterEggStudioQA&quot;; qa.Parent=game:GetService(&quot;ServerStorage&quot;)
 qa.OnInvoke=function(action,p,arg)
  assert(p and profiles[p],&quot;Player profile not ready&quot;)
  if action==&quot;GrantCash&quot; then profiles[p].Cash+=arg; sync(p); return profiles[p].Cash
  elseif action==&quot;Carry&quot; then drop(p); return carry(p,arg)
  elseif action==&quot;Snapshot&quot; then return {Profile=profiles[p],Carried=carried[p],Plot=plots[p]} end
  error(&quot;Unknown QA action&quot;)
 end
end
game:BindToClose(function()
 local pending=0
 for p in profiles do pending+=1; task.spawn(function() while profiles[p] and profiles[p].Saving do task.wait(0.1) end; save(p,true); pending-=1 end) end
 local deadline=os.clock()+25
 while pending&gt;0 and os.clock()&lt;deadline do task.wait(0.1) end
end)
print(&quot;[MonsterEgg] Ready: 6 zones, 18 nests, 8 sanctuaries&quot;)
</ProtectedString>
</Properties>
</Item>
</Item>
<Item class="StarterPlayer"><Properties><string name="Name">StarterPlayer</string></Properties>
<Item class="StarterPlayerScripts"><Properties><string name="Name">StarterPlayerScripts</string></Properties>
<Item class="LocalScript" referent="RBX1188"><Properties>
<string name="Name">MonsterEggClient</string>
<ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Tween=game:GetService(&quot;TweenService&quot;)
local p=Players.LocalPlayer
local gui=Instance.new(&quot;ScreenGui&quot;); gui.Name=&quot;MonsterEggHUD&quot;; gui.ResetOnSpawn=false; gui.Parent=p:WaitForChild(&quot;PlayerGui&quot;)
local function label(name,size,pos,text,color)
 local t=Instance.new(&quot;TextLabel&quot;); t.Name=name; t.Size=size; t.Position=pos; t.BackgroundColor3=Color3.fromRGB(21,27,46); t.BackgroundTransparency=0.12; t.TextColor3=color or Color3.fromRGB(238,246,255); t.Font=Enum.Font.GothamBold; t.TextScaled=true; t.TextWrapped=true; t.Text=text; t.Parent=gui
 local c=Instance.new(&quot;UICorner&quot;); c.CornerRadius=UDim.new(0,12); c.Parent=t
 local pad=Instance.new(&quot;UIPadding&quot;); pad.PaddingLeft=UDim.new(0,12); pad.PaddingRight=UDim.new(0,12); pad.PaddingTop=UDim.new(0,8); pad.PaddingBottom=UDim.new(0,8); pad.Parent=t
 local stroke=Instance.new(&quot;UIStroke&quot;); stroke.Color=Color3.fromRGB(72,99,139); stroke.Transparency=0.4; stroke.Parent=t
 return t
end
label(&quot;Title&quot;,UDim2.fromScale(0.38,0.055),UDim2.fromScale(0.31,0.018),&quot;MONSTER EGG ESCAPE&quot;,Color3.fromRGB(255,214,94))
local money=label(&quot;Cash&quot;,UDim2.fromScale(0.23,0.09),UDim2.fromScale(0.02,0.12),&quot;$0&quot;,Color3.fromRGB(105,255,188))
local stats=label(&quot;Stats&quot;,UDim2.fromScale(0.23,0.13),UDim2.fromScale(0.02,0.22),&quot;Loading...&quot;)
local objective=label(&quot;Objective&quot;,UDim2.fromScale(0.5,0.08),UDim2.fromScale(0.25,0.83),&quot;Take an egg • escape to the green sanctuary&quot;)
local toast=label(&quot;Notice&quot;,UDim2.fromScale(0.6,0.07),UDim2.fromScale(0.2,0.73),&quot;&quot;); toast.Visible=false
local save=label(&quot;SaveStatus&quot;,UDim2.fromScale(0.4,0.035),UDim2.fromScale(0.3,0.94),&quot;&quot;); save.BackgroundTransparency=1
local rage=label(&quot;Rage&quot;,UDim2.fromScale(0.26,0.08),UDim2.fromScale(0.72,0.12),&quot;&quot;,Color3.fromRGB(255,103,117)); rage.Visible=false
local C=require(RS:WaitForChild(&quot;MonsterEgg&quot;):WaitForChild(&quot;Config&quot;))
local function update()
 local speed=p:GetAttribute(&quot;Speed&quot;) or 0
 money.Text=string.format(&quot;$%s  •  +$%s / sec&quot;,math.floor(p:GetAttribute(&quot;Cash&quot;) or 0),p:GetAttribute(&quot;Income&quot;) or 0)
 stats.Text=string.format(&quot;SPEED LV %d\nTRAINING %.1f / 100\nEGGS %d / %d&quot;,speed,p:GetAttribute(&quot;Training&quot;) or 0,p:GetAttribute(&quot;EggCount&quot;) or 0,p:GetAttribute(&quot;Capacity&quot;) or 8)
 local egg=p:GetAttribute(&quot;Carrying&quot;) or &quot;&quot;; local r=p:GetAttribute(&quot;Rage&quot;) or 0
 objective.Text=egg~=&quot;&quot; and (&quot;CARRYING: &quot;..egg..&quot;\nRUN TO SANCTUARY!&quot;) or &quot;Take an egg • escape to the green sanctuary&quot;
 rage.Visible=r&gt;0; rage.Text=r&gt;=4 and &quot;MONSTER RAGE!\nGuardian speed increased&quot; or &quot;GUARDIAN CHASING!&quot;
 save.Text=p:GetAttribute(&quot;SaveStatus&quot;) or &quot;Connecting progress...&quot;
end
p.AttributeChanged:Connect(update); update()
local serial=0
RS.MonsterEgg:WaitForChild(&quot;Notice&quot;).OnClientEvent:Connect(function(text)
 serial+=1; local current=serial; toast.Text=text; toast.Visible=true
 task.delay(5,function() if serial==current then toast.Visible=false end end)
end)
local Run=game:GetService(&quot;RunService&quot;)
Run.RenderStepped:Connect(function()
 local char=p.Character; local r=char and char:FindFirstChild(&quot;HumanoidRootPart&quot;); if not r then return end
 local zone=math.clamp(math.floor((r.Position.Z-80)/180)+1,1,6)
 objective.TextColor3=r.Position.Z&lt;=80 and Color3.fromRGB(113,255,202) or C.Zones[zone].Color
end)
