export type Rarity = { Name: string, Color: Color3, Shade: Color3, Weight: number, Multiplier: number }

Config.Rarities = {
	{ Name = "Common", Color = Color3.fromRGB(226, 230, 238), Shade = Color3.fromRGB(176, 184, 198), Weight = 50, Multiplier = 1 },
	{ Name = "Uncommon", Color = Color3.fromRGB(110, 232, 120), Shade = Color3.fromRGB(56, 170, 84), Weight = 25, Multiplier = 2 },
	{ Name = "Rare", Color = Color3.fromRGB(80, 170, 255), Shade = Color3.fromRGB(40, 104, 214), Weight = 13, Multiplier = 4 },
	{ Name = "Epic", Color = Color3.fromRGB(184, 98, 255), Shade = Color3.fromRGB(116, 50, 200), Weight = 7, Multiplier = 8 },
	{ Name = "Legendary", Color = Color3.fromRGB(255, 196, 46), Shade = Color3.fromRGB(226, 128, 24), Weight = 3.5, Multiplier = 16 },
	{ Name = "Mythic", Color = Color3.fromRGB(255, 74, 104), Shade = Color3.fromRGB(176, 24, 70), Weight = 1.2, Multiplier = 35 },
	{ Name = "Divine", Color = Color3.fromRGB(255, 246, 196), Shade = Color3.fromRGB(255, 170, 232), Weight = 0.3, Multiplier = 80 },
} :: { Rarity }

Config.RageRarity = 4 -- Epic and above enrage the guardian
Config.ChargeRarity = 5 -- Legendary and above add charge dashes

export type Trail = {
	Name: string,
	Rarity: string, -- matches a Config.Rarities name, used for the card colours
	Cost: number,
	Multiplier: number,
	Colors: { Color3 },
	Robux: number, -- display price; the real price comes from the developer product
	ProductId: number, -- Roblox developer product id (0 = Robux purchase not set up yet)
}

Config.Trails = {
	{ Name = "Mint", Rarity = "Common", Cost = 250, Multiplier = 1.1, Robux = 25, ProductId = 0, Colors = { Color3.fromRGB(120, 255, 200), Color3.fromRGB(60, 210, 160) } },
	{ Name = "Ocean", Rarity = "Uncommon", Cost = 1500, Multiplier = 1.2, Robux = 49, ProductId = 0, Colors = { Color3.fromRGB(80, 200, 255), Color3.fromRGB(40, 90, 255) } },
	{ Name = "Prism", Rarity = "Rare", Cost = 8000, Multiplier = 1.3, Robux = 99, ProductId = 0, Colors = { Color3.fromRGB(255, 90, 200), Color3.fromRGB(90, 220, 255) } },
	{ Name = "Solar", Rarity = "Epic", Cost = 40000, Multiplier = 1.45, Robux = 199, ProductId = 0, Colors = { Color3.fromRGB(255, 230, 80), Color3.fromRGB(255, 110, 40) } },
	{ Name = "Void", Rarity = "Legendary", Cost = 200000, Multiplier = 1.6, Robux = 399, ProductId = 0, Colors = { Color3.fromRGB(190, 100, 255), Color3.fromRGB(30, 10, 60) } },
	{ Name = "Divine", Rarity = "Divine", Cost = 1000000, Multiplier = 1.8, Robux = 799, ProductId = 0, Colors = { Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 200, 240) } },
} :: { Trail }

function Config.RarityInfo(name: string): Rarity
	for _, rarity in Config.Rarities do
		if rarity.Name == name then
			return rarity
		end
	end
	return Config.Rarities[1]
end

-- Robux shop packs. Each needs a developer product created in the Creator Hub (ProductId 0 = not set up yet).
export type Pack = { Amount: number, Robux: number, ProductId: number, Icon: string }

Config.CashPacks = {
	{ Amount = 5000, Robux = 45, ProductId = 0, Icon = "CashStack" },
	{ Amount = 25000, Robux = 90, ProductId = 0, Icon = "CashStack" },
	{ Amount = 100000, Robux = 225, ProductId = 0, Icon = "CashStack" },
	{ Amount = 500000, Robux = 450, ProductId = 0, Icon = "CashBag" },
	{ Amount = 2500000, Robux = 720, ProductId = 0, Icon = "CashChest" },
} :: { Pack }

-- Permanent walk speed added before the trail multiplier.
Config.SpeedPacks = {
	{ Amount = 2, Robux = 72, ProductId = 0, Icon = "Speed" },
	{ Amount = 5, Robux = 225, ProductId = 0, Icon = "Speed" },
	{ Amount = 10, Robux = 630, ProductId = 0, Icon = "ShoePile" },
	{ Amount = 15, Robux = 1350, ProductId = 0, Icon = "ShoePile" },
	{ Amount = 25, Robux = 1800, ProductId = 0, Icon = "ShoeChest" },
	{ Amount = 40, Robux = 2700, ProductId = 0, Icon = "ShoeChest" },
} :: { Pack }

-- One developer product that buys the next treadmill level (shown price only; the product sets the real one).
Config.TreadRobux = { ProductId = 0 }
function Config.TreadRobuxPrice(level: number): number
	return 49 + level * 18
end

-- Developer product id for a Robux purchase ("Trail", "Cash", "Speed" or "Tread"); 0 = not set up.
function Config.ProductFor(kind: string, index: number?): number
	local item: { ProductId: number }? = if kind == "Trail"
		then Config.Trails[index or 0]
		elseif kind == "Cash" then Config.CashPacks[index or 0]
		elseif kind == "Speed" then Config.SpeedPacks[index or 0]
		elseif kind == "Tread" then Config.TreadRobux
		else nil
	return if item then item.ProductId else 0
end

-- Fuse Machine: this many eggs of one rarity become one egg of the next rarity.
Config.FuseCount = 3

-- Free gift from the Rewards menu.
Config.RewardCooldown = 15 * 60
function Config.RewardCash(incomePerSecond: number): number
	return math.max(500, math.floor(incomePerSecond * 120))
end

function Config.SpeedCost(level: number): number
	return math.floor(60 * (level + 1) ^ 2.1)
end

function Config.StorageCost(capacity: number): number
	return math.floor(400 * 3 ^ ((capacity - Config.StartCapacity) / Config.CapacityStep))
end

-- Cost to upgrade a treadmill from `level` to `level + 1`.
function Config.TreadCost(level: number): number
	return math.floor(200 * 1.85 ^ (level - 1))
end

-- Training points per second while running on your own treadmill.
function Config.TreadPower(level: number): number
	return level
end

function Config.TreadCash(level: number, speedLevel: number): number
	return 2 * level + speedLevel
end

function Config.EggIncome(zone: number, rarity: number): number
	return Config.Zones[zone].Income * Config.Rarities[rarity].Multiplier
end

-- Deeper zones shift the weights toward rarer eggs.
function Config.RarityWeights(zone: number): { number }
	local luck = 1 + (zone - 1) * 0.12
	local weights = {}
	for index, rarity in Config.Rarities do
		weights[index] = rarity.Weight * luck ^ (index - 1)
	end
	return weights
end

function Config.RollRarity(zone: number, rng: Random): number
	local weights = Config.RarityWeights(zone)
	local total = 0
	for _, w in weights do
		total += w
	end
	local roll = rng:NextNumber(0, total)
	for index, w in weights do
		roll -= w
		if roll &lt;= 0 then
			return index
		end
	end
	return 1
end

function Config.WalkSpeed(speedLevel: number, training: number, trail: number, treadLevel: number, bonus: number?): number
	local base = Config.BaseWalkSpeed + speedLevel * Config.SpeedPerLevel
		+ math.min(training, Config.TrainingCap) / Config.TrainingDivisor
		+ (math.max(treadLevel, 1) - 1) * Config.TreadSpeedPerLevel
		+ (bonus or 0)
	local multiplier = if trail &gt; 0 then Config.Trails[trail].Multiplier else 1
	return base * multiplier
end

function Config.ZoneStart(index: number): number
	return Config.SafeZ + (index - 1) * Config.ZoneLength
end

function Config.ZoneCenter(index: number): number
	return Config.ZoneStart(index) + Config.ZoneLength / 2
end

-- Returns 0 inside the sanctuary, otherwise the zone index.
function Config.ZoneAt(z: number): number
	if z &lt;= Config.SafeZ then
		return 0
	end
	return math.clamp(math.floor((z - Config.SafeZ) / Config.ZoneLength) + 1, 1, #Config.Zones)
end

function Config.NestCenter(index: number): Vector3
	local nest = Config.Zones[index].Nest
	return Vector3.new(nest.X, 0, Config.ZoneStart(index) + nest.Y)
end

function Config.NestSlot(index: number, slot: number): Vector3
	local center = Config.NestCenter(index)
	return center + Vector3.new((slot - 2) * 6.5, 2.9, if slot == 2 then -1.5 else 0)
end

function Config.GuardianHome(index: number): CFrame
	local center = Config.NestCenter(index)
	-- Sleeps beside its nest (wall side), looking out over the path toward the sanctuary.
	local side = if center.X &lt; 0 then -1 else 1
	local position = center + Vector3.new(side * 12, 0, 14)
	return CFrame.lookAt(position, Vector3.new(center.X * 0.3, 0, position.Z - 40))
end

local suffixes = { "", "K", "M", "B", "T", "Qd", "Qn" }
function Config.Format(value: number): string
	value = math.floor(value)
	if value &lt; 1000 then
		return tostring(value)
	end
	local tier = math.min(math.floor(math.log10(value) / 3), #suffixes - 1)
	local scaled = value / 10 ^ (tier * 3)
	local text = if scaled &gt;= 100 then string.format("%d", scaled) else string.format("%.1f", scaled)
	text = text:gsub("%.0$", "")
	return text .. suffixes[tier + 1]
end

return Config
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Style</string>
          <ProtectedString name="Source">-- Small builders shared by the world, egg and monster modules.
local Style = {}

Style.CheckerTexture = "rbxassetid://6372755229"
Style.Font = Enum.Font.FredokaOne
Style.FontBold = Enum.Font.GothamBlack
Style.White = Color3.new(1, 1, 1)
Style.Ink = Color3.fromRGB(28, 22, 44)

local ALL_FACES = { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right, Enum.NormalId.Top }

function Style.Part(parent: Instance?, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	if shape then
		p.Shape = shape
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

function Style.Wedge(parent: Instance?, name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): WedgePart
	local p = Instance.new("WedgePart")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- Vertical cylinder (Roblox cylinders run along X, so rotate onto Y).
function Style.Cylinder(parent: Instance?, name: string, height: number, diameter: number, cf: CFrame, color: Color3, material: Enum.Material?): Part
	return Style.Part(parent, name, Vector3.new(height, diameter, diameter), cf * CFrame.Angles(0, 0, math.pi / 2), color, material, Enum.PartType.Cylinder)
end

-- Lego-style studs on top (and optionally sides) of a part.
function Style.Studs(part: BasePart, sides: boolean?)
	part.Material = Enum.Material.Plastic
	part.TopSurface = Enum.SurfaceType.Studs
	if sides then
		part.FrontSurface = Enum.SurfaceType.Studs
		part.BackSurface = Enum.SurfaceType.Studs
		part.LeftSurface = Enum.SurfaceType.Studs
		part.RightSurface = Enum.SurfaceType.Studs
	end
	return part
end

-- Two-tone checker tiles, like a classic obby wall.
function Style.Checker(part: BasePart, tile: number?, faces: { Enum.NormalId }?, transparency: number?)
	for _, face in faces or ALL_FACES do
		local t = Instance.new("Texture")
		t.Name = "Checker"
		t.Texture = Style.CheckerTexture
		t.Face = face
		t.StudsPerTileU = tile or 8
		t.StudsPerTileV = tile or 8
		t.Color3 = Color3.new(0, 0, 0)
		t.Transparency = transparency or 0.82
		t.Parent = part
	end
	return part
end

function Style.Weld(part0: BasePart, part1: BasePart): Weld
	local w = Instance.new("Weld")
	w.Name = "Weld"
	w.Part0 = part0
	w.Part1 = part1
	w.C0 = part0.CFrame:Inverse() * part1.CFrame
	w.Parent = part1
	return w
end

function Style.Light(part: BasePart, color: Color3, brightness: number?, range: number?): PointLight
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = brightness or 1.5
	l.Range = range or 14
	l.Shadows = false
	l.Parent = part
	return l
end

function Style.Particles(parent: Instance, name: string, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.LightEmission = 0.8
	e.Lifetime = NumberRange.new(0.6, 1.2)
	e.Speed = NumberRange.new(1, 3)
	e.Rate = 6
	for key, value in props do
		(e :: any)[key] = value
	end
	e.Parent = parent
	return e
end

-- Floating world label that keeps a fixed size in studs.
function Style.Label(adornee: BasePart, text: string, color: Color3?, width: number?, height: number?, offsetY: number?): BillboardGui
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromScale(width or 10, height or 2.4)
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY or 4, 0)
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.Adornee = adornee
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Style.Font
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color or Style.White
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2.5
	stroke.Color = Style.Ink
	stroke.Parent = label
	gui.Parent = adornee
	return gui
end

-- Sign text printed on a part face; returns the title and subtitle labels.
function Style.Sign(part: BasePart, title: string, subtitle: string?, color: Color3?, face: Enum.NormalId?, pixelsPerStud: number?)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Sign"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 40
	gui.LightInfluence = 0
	gui.Parent = part
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.BackgroundTransparency = 1
	titleLabel.Size = UDim2.fromScale(0.92, if subtitle then 0.58 else 0.84)
	titleLabel.Position = UDim2.fromScale(0.04, 0.08)
	titleLabel.Font = Style.Font
	titleLabel.TextScaled = true
	titleLabel.Text = title
	titleLabel.TextColor3 = color or Style.White
	titleLabel.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Color = Style.Ink
	stroke.Parent = titleLabel
	local sub
	if subtitle then
		sub = Instance.new("TextLabel")
		sub.Name = "Subtitle"
		sub.BackgroundTransparency = 1
		sub.Size = UDim2.fromScale(0.92, 0.28)
		sub.Position = UDim2.fromScale(0.04, 0.66)
		sub.Font = Style.Font
		sub.TextScaled = true
		sub.Text = subtitle
		sub.TextColor3 = Style.White
		sub.Parent = gui
		local s2 = stroke:Clone()
		s2.Thickness = 3
		s2.Parent = sub
	end
	return titleLabel, sub
end

function Style.Prompt(part: Instance, action: string, object: string, hold: number?, distance: number?): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = hold or 0.35
	prompt.MaxActivationDistance = distance or 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	return prompt
end

function Style.Darken(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(0, 0, 0), amount)
end

function Style.Lighten(color: Color3, amount: number): Color3
	return color:Lerp(Color3.new(1, 1, 1), amount)
end

return Style
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Eggs</string>
          <ProtectedString name="Source">-- Voxel-style eggs: stacked brick rings with rarity colours, glow and extras.
local Config = require(script.Parent.Config)
local Style = require(script.Parent.Style)

local Eggs = {}

local SLICES = 9

export type Options = {
	Scale: number?,
	Anchored: boolean?,
	Label: string?,
	Parent: Instance?,
	Light: boolean?,
}

local function decorate(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
end

function Eggs.Radius(scale: number, t: number): number
	-- t runs -1 (bottom) .. 1 (top); slightly wider at the bottom like a real egg.
	return math.max(0.32 * scale, 1.6 * scale * math.sqrt(math.max(0, 1 - t * t)) * (1 - 0.16 * t))
end

function Eggs.Build(zone: number, rarity: number, cf: CFrame, options: Options?): Model
	local opts = options or {}
	local scale = opts.Scale or 1
	local info = Config.Rarities[rarity]
	local zoneInfo = Config.Zones[zone]
	local model = Instance.new("Model")
	model.Name = info.Name .. "Egg"
	model:SetAttribute("Zone", zone)
	model:SetAttribute("Rarity", rarity)

	local core = Style.Part(model, "Core", Vector3.new(0.6, 0.6, 0.6) * scale, cf, info.Color)
	core.Transparency = 1
	core.CanCollide = false
	core.CanTouch = false
	core.Massless = true
	core.Anchored = opts.Anchored ~= false

	local height = 4.4 * scale
	local sliceHeight = height / SLICES
	local widest = 0
	local function add(part: BasePart)
		decorate(part)
		Style.Weld(core, part)
		return part
	end

	for k = 1, SLICES do
		local y = -height / 2 + (k - 0.5) * sliceHeight
		local t = y / (height / 2)
		local r = Eggs.Radius(scale, t)
		widest = math.max(widest, r)
		local color = info.Shade:Lerp(info.Color, (k - 1) / (SLICES - 1))
		if k % 2 == 0 then
			color = Style.Lighten(color, 0.1)
		end
		add(Style.Cylinder(model, "Slice", sliceHeight * 1.03, r * 2, cf * CFrame.new(0, y, 0), color))
		if k == 3 or k == 6 then
			for n = 0, 5 do
				local angle = n * math.pi / 3 + (if k == 6 then math.pi / 6 else 0)
				local brick = Style.Part(model, "Brick", Vector3.new(0.95, sliceHeight * 0.9, 0.45) * Vector3.new(scale, 1, scale),
					cf * CFrame.new(0, y, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, r - 0.08 * scale),
					if n % 2 == 0 then zoneInfo.Color else Style.Lighten(info.Color, 0.35))
				Style.Studs(brick)
				add(brick)
			end
		end
	end

	add(Style.Part(model, "Cap", Vector3.new(0.75, 0.75, 0.75) * scale, cf * CFrame.new(0, height / 2 - 0.1 * scale, 0),
		Style.Lighten(info.Color, 0.3), Enum.Material.SmoothPlastic, Enum.PartType.Ball))

	if rarity &gt;= 3 then
		local band = add(Style.Cylinder(model, "Band", 0.2 * scale, widest * 2 + 0.16 * scale, cf * CFrame.new(0, -0.35 * scale, 0),
			Style.Lighten(info.Color, 0.25), Enum.Material.Neon))
		band.Transparency = 0.1
		Style.Particles(core, "Sparkles", {
			Color = ColorSequence.new(info.Color, Color3.new(1, 1, 1)),
			Rate = rarity * 2,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35 * scale), NumberSequenceKeypoint.new(1, 0) }),
			SpreadAngle = Vector2.new(180, 180),
			Speed = NumberRange.new(0.5, 2),
		})
	end
	if rarity &gt;= 4 and opts.Light ~= false then
		Style.Light(core, info.Color, 0.6 + (rarity - 4) * 0.3, 8 + rarity)
	end
	if rarity == 5 then
		for n = 0, 4 do
			local angle = n * math.pi * 2 / 5
			local spike = Style.Part(model, "CrownSpike", Vector3.new(0.35, 0.9, 0.35) * scale,
				cf * CFrame.new(0, height / 2 - 0.25 * scale, 0) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, 0.45 * scale) * CFrame.Angles(-0.35, 0, 0),
				Color3.fromRGB(255, 220, 70), Enum.Material.Neon)
			add(spike)
		end
	elseif rarity == 6 then
		for n = 0, 2 do
			local angle = n * math.pi * 2 / 3
			add(Style.Part(model, "Shard", Vector3.new(0.4, 1.3, 0.4) * scale,
				cf * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0.3 * scale, widest + 0.9 * scale) * CFrame.Angles(0.4, 0, 0.3),
				info.Color, Enum.Material.Neon))
		end
		Style.Particles(core, "Flames", {
			Texture = "rbxasset://textures/particles/fire_main.dds",
			Color = ColorSequence.new(info.Color, Color3.fromRGB(255, 160, 60)),
			Rate = 10,
			Lifetime = NumberRange.new(0.4, 0.8),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9 * scale), NumberSequenceKeypoint.new(1, 0) }),
			Speed = NumberRange.new(1, 2),
			Acceleration = Vector3.new(0, 4, 0),
		})
	elseif rarity == 7 then
		for n = 0, 11 do
			local angle = n * math.pi * 2 / 12
			add(Style.Part(model, "Halo", Vector3.new(0.32, 0.32, 0.32) * scale,
				cf * CFrame.new(math.cos(angle) * 1.1 * scale, height / 2 + 0.9 * scale, math.sin(angle) * 1.1 * scale),
				Color3.fromRGB(255, 240, 150), Enum.Material.Neon, Enum.PartType.Ball))
		end
		for _, side in { -1, 1 } do
			for n = 0, 2 do
				add(Style.Part(model, "Wing", Vector3.new(0.18, 0.55, 1.9 - n * 0.4) * scale,
					cf * CFrame.new(side * (widest + 0.15 * scale), (0.6 - n * 0.55) * scale, 0.5 * scale) * CFrame.Angles(0.5 + n * 0.15, side * 0.5, 0),
					Color3.new(1, 1, 1), Enum.Material.Neon))
			end
		end
		local sparkles = core:FindFirstChild("Sparkles") :: ParticleEmitter
		sparkles.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 120)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 240, 120)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(120, 255, 200)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 140, 255)),
		})
	end

	if opts.Label then
		Style.Label(core, opts.Label, Style.Lighten(info.Color, 0.15), 7 * scale, 1.9 * scale, height / 2 + 1.6 * scale)
	end

	model.PrimaryPart = core
	model.Parent = opts.Parent
	return model
end

function Eggs.Title(zone: number, rarity: number): string
	return Config.Rarities[rarity].Name .. " " .. Config.Zones[zone].Name .. " Egg"
end

function Eggs.LabelText(zone: number, rarity: number): string
	return string.format("%s\n$%s/s", Config.Rarities[rarity].Name, Config.Format(Config.EggIncome(zone, rarity)))
end

return Eggs
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Monsters</string>
          <ProtectedString name="Source">-- Guardian models: one AI-generated slime mesh per zone (ids in Config), animated on each client
-- with squash &amp; stretch, leaning and a red rage glow. Every guardian has an anchored invisible
-- Root that the server moves; the body hangs off it on a Motor6D that clients animate.
local AssetService = game:GetService("AssetService")

local Config = require(script.Parent.Config)
local Style = require(script.Parent.Style)

local Monsters = {}

local meshCache: { [number]: MeshPart | false } = {}

local function soften(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
end

-- Loads (once) the zone's generated mesh. Returns nil if the asset can't be loaded.
local function meshTemplate(zone: number): MeshPart?
	local cached = meshCache[zone]
	if cached ~= nil then
		return cached or nil
	end
	local info = Config.Zones[zone]
	local ok, result = pcall(function()
		return AssetService:CreateMeshPartAsync(info.MeshId)
	end)
	if not ok or not result then
		warn(string.format("[MonsterEgg] Mesh for %s could not load (%s); using fallback blob", info.Monster, tostring(result)))
		meshCache[zone] = false
		return nil
	end
	local part = result :: MeshPart
	part.TextureID = info.TextureId
	meshCache[zone] = part
	return part
end

-- Simple glossy blob with eyes, used when a mesh asset is unavailable.
local function fallbackBody(zone: number, height: number): Part
	local info = Config.Zones[zone]
	local body = Style.Part(nil, "Body", Vector3.new(height * 1.15, height, height * 0.9), CFrame.identity, info.Color, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	body.Reflectance = 0.1
	for _, s in { -1, 1 } do
		local eye = Style.Part(body, "Eye", Vector3.new(1.6, 1.6, 0.8) * height / 12, CFrame.new(s * height * 0.17, height * 0.15, -height * 0.42), Color3.fromRGB(255, 230, 80), Enum.Material.Neon, Enum.PartType.Ball)
		soften(eye)
		Style.Weld(body, eye)
	end
	local mouth = Style.Part(body, "Mouth", Vector3.new(height * 0.35, height * 0.1, 0.6), CFrame.new(0, -height * 0.08, -height * 0.44), Color3.fromRGB(30, 10, 20), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	soften(mouth)
	Style.Weld(body, mouth)
	return body
end

function Monsters.Build(zone: number, home: CFrame, parent: Instance?): Model
	local info = Config.Zones[zone]
	local height = info.Height
	local hip = height / 2
	local model = Instance.new("Model")
	model.Name = info.Monster
	model:SetAttribute("Zone", zone)
	model:SetAttribute("Hip", hip)
	model:SetAttribute("SleepDrop", 0)
	model:SetAttribute("Sleeping", true)
	model:SetAttribute("Rage", 0)

	local root = Style.Part(model, "Root", Vector3.new(2, 2, 2), CFrame.new(0, hip, 0), Color3.new(1, 1, 1))
	root.Transparency = 1
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	model.PrimaryPart = root

	local facing = CFrame.Angles(0, info.MeshYaw, 0)
	local template = meshTemplate(zone)
	local body: BasePart
	if template then
		local mesh = template:Clone()
		mesh.Name = "Body"
		mesh.Size = template.Size * (height / template.Size.Y)
		body = mesh
	else
		body = fallbackBody(zone, height)
		facing = CFrame.identity
	end
	body.CFrame = root.CFrame * facing
	soften(body)
	body.CastShadow = true
	body.Parent = model
	for _, extra in body:GetChildren() do
		if extra:IsA("BasePart") then
			extra.Parent = model
		end
	end

	local motor = Instance.new("Motor6D")
	motor.Name = "Body"
	motor.Part0 = root
	motor.Part1 = body
	motor.C0 = facing
	motor:SetAttribute("Rest", facing)
	motor:SetAttribute("Kind", "Blob")
	motor:SetAttribute("BaseSize", body.Size)
	motor.Parent = root

	Style.Particles(body, "Drips", {
		Color = ColorSequence.new(info.Color),
		Rate = 6,
		Speed = NumberRange.new(0),
		Acceleration = Vector3.new(0, -30, 0),
		Lifetime = NumberRange.new(0.6, 0.9),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0.2) }),
		LightEmission = 0.3,
		Texture = "rbxasset://textures/particles/sparkles_main.dds",
	})

	local glow = Instance.new("Highlight")
	glow.Name = "RageGlow"
	glow.Adornee = body
	glow.FillColor = Color3.fromRGB(255, 40, 40)
	glow.FillTransparency = 0.7
	glow.OutlineColor = Color3.fromRGB(255, 120, 80)
	glow.DepthMode = Enum.HighlightDepthMode.Occluded
	glow.Enabled = false
	glow.Parent = model

	local fire = Style.Particles(root, "RageFire", {
		Texture = "rbxasset://textures/particles/fire_main.dds",
		Color = ColorSequence.new(Color3.fromRGB(255, 70, 50), info.Color),
		Rate = 40,
		Lifetime = NumberRange.new(0.4, 0.9),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 0.5) }),
		Speed = NumberRange.new(2, 6),
		SpreadAngle = Vector2.new(60, 60),
		Acceleration = Vector3.new(0, 8, 0),
		LightEmission = 1,
		Enabled = false,
	})
	fire:SetAttribute("Rage", true)
	local light = Style.Light(root, Color3.fromRGB(255, 60, 60), 3, 26)
	light.Name = "RageLight"
	light.Enabled = false
	Style.Light(root, info.Color, 1.2, height * 1.4).Name = "ZoneGlow"

	local status = Style.Label(root, "Zzz", Color3.fromRGB(170, 220, 255), 7, 2.6, hip + 2.4)
	status.Name = "Status"
	status.MaxDistance = 220
	local nameplate = Style.Label(root, info.Monster, info.Color, 14, 1.8, hip + 5.4)
	nameplate.Name = "Nameplate"
	nameplate.MaxDistance = 160

	model:PivotTo(home * CFrame.new(0, hip, 0))
	model.Parent = parent
	return model
end

-- Root CFrame for a standing (awake) guardian at a ground-level CFrame.
function Monsters.StandCFrame(model: Model, ground: CFrame): CFrame
	return ground * CFrame.new(0, model:GetAttribute("Hip") :: number, 0)
end

function Monsters.SleepCFrame(model: Model, ground: CFrame): CFrame
	local hip = model:GetAttribute("Hip") :: number
	local drop = model:GetAttribute("SleepDrop") :: number
	return ground * CFrame.new(0, hip - drop, 0)
end

function Monsters.SetStatus(model: Model, text: string, color: Color3)
	local root = model.PrimaryPart
	local gui = root and root:FindFirstChild("Status") :: BillboardGui?
	local label = gui and gui:FindFirstChild("Text") :: TextLabel?
	if label then
		label.Text = text
		label.TextColor3 = color
	end
end

function Monsters.SetRage(model: Model, on: boolean)
	for _, item in model:GetDescendants() do
		if item:IsA("ParticleEmitter") and item:GetAttribute("Rage") then
			item.Enabled = on
		elseif item:IsA("PointLight") and item.Name == "RageLight" then
			item.Enabled = on
		elseif item:IsA("Highlight") and item.Name == "RageGlow" then
			item.Enabled = on
		end
	end
end

-- Animation ----------------------------------------------------------------

export type Pose = {
	Motors: { Motor6D },
}

function Monsters.Collect(model: Model): Pose
	local pose: Pose = { Motors = {} }
	for _, item in model:GetDescendants() do
		if item:IsA("Motor6D") and item:GetAttribute("Rest") then
			table.insert(pose.Motors, item)
		end
	end
	return pose
end

-- sleep: 0 awake .. 1 asleep; move: 0 idle .. 1 full speed; rage: 0 .. 1.
function Monsters.Animate(pose: Pose, t: number, sleep: number, move: number, rage: number)
	for _, motor in pose.Motors do
		local body = motor.Part1
		local base = motor:GetAttribute("BaseSize") :: Vector3?
		if not body or not base then
			continue
		end
		local rest = motor:GetAttribute("Rest") :: CFrame
		local breath = math.sin(t * 1.4) * 0.035
		local wobble = math.sin(t * (4 + move * 9 + rage * 6)) * (0.035 + 0.07 * move + 0.05 * rage)
		local awakeY, awakeX = 1 + wobble + breath * 0.5, 1 - wobble * 0.6
		local sleepY, sleepX = 0.8 + breath, 1.12 - breath * 0.5
		local sy = awakeY + (sleepY - awakeY) * sleep
		local sx = awakeX + (sleepX - awakeX) * sleep
		body.Size = base * Vector3.new(sx, sy, sx)
		local lean = (move * 0.2 + rage * 0.08) * (1 - sleep)
		local sway = math.sin(t * 2.1) * 0.05 * (1 + move) * (1 - sleep)
		local drop = (1 - sy) * base.Y / 2
		motor.C0 = CFrame.new(0, -drop, 0) * CFrame.Angles(-lean, 0, sway) * rest
	end
end

return Monsters
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">-- Builds the static map: sanctuary (safe zone) with seven personal bases, shops and six themed zones.
local Lighting = game:GetService("Lighting")

local Config = require(script.Parent.Config)
local Style = require(script.Parent.Style)
local Eggs = require(script.Parent.Eggs)
local Monsters = require(script.Parent.Monsters)

local P = Style.Part
local W = {}

W.RootName = "MonsterEggEscape"
W.Boards = {
	Info = Vector3.new(-24, 0, -40),
	Speed = Vector3.new(-8, 0, -40),
	Storage = Vector3.new(8, 0, -40),
	Index = Vector3.new(24, 0, -40),
}
W.ShopCFrame = CFrame.new(50, 0, 28) * CFrame.Angles(0, math.pi / 2, 0) -- faces the path
W.FountainPosition = Vector3.new(0, 0, -68)
W.PenColumns = 4

local WOOD = Color3.fromRGB(158, 104, 60)
local WOOD_LIGHT = Color3.fromRGB(196, 140, 84)
local NAVY = Color3.fromRGB(34, 30, 70)
local SAFE = Color3.fromRGB(80, 255, 170)
local HEDGE = Color3.fromRGB(70, 175, 80)

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function noCollide(part: BasePart): BasePart
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	return part
end

-- Base geometry ---------------------------------------------------------------------
-- Odd bases line the left wall, even bases the right wall; the right side's last slot holds the shop.

function W.BaseLayout(index: number): (number, Vector3)
	local side = if index % 2 == 1 then -1 else 1
	local row = math.floor((index - 1) / 2)
	return side, Vector3.new(side * 53, 0, -80 + row * 36)
end

-- The personal treadmill: belt along Z, the runner faces the zones.
function W.TreadmillCFrame(index: number): CFrame
	local side, center = W.BaseLayout(index)
	return CFrame.new(center.X - side * 8, 0, center.Z - 4)
end

function W.SpawnPoint(index: number): Vector3
	local side, center = W.BaseLayout(index)
	return Vector3.new(center.X - side * 8, 3.5, center.Z + 11)
end

function W.PenCenter(index: number): Vector3
	local side, center = W.BaseLayout(index)
	return Vector3.new(center.X + side * 9, 0, center.Z)
end

function W.SlotPosition(index: number, slot: number): Vector3
	local side = W.BaseLayout(index)
	local pen = W.PenCenter(index)
	local col = (slot - 1) % W.PenColumns
	local row = math.floor((slot - 1) / W.PenColumns)
	return pen + Vector3.new(side * (col - 1.5) * 3.9, 2.2, (row - 3.5) * 3.7)
end

-- Reusable props ----------------------------------------------------------------

local function board(parent: Instance, name: string, position: Vector3, color: Color3, title: string, subtitle: string?): Part
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	local face = P(model, "Board", Vector3.new(11, 7, 0.8), CFrame.new(position + Vector3.new(0, 6.5, 0)), color)
	Style.Studs(face)
	for _, x in { -5.9, 5.9 } do
		P(model, "Post", Vector3.new(0.9, 10, 0.9), CFrame.new(position + Vector3.new(x, 5, 0)), Style.Darken(color, 0.45))
	end
	P(model, "Trim", Vector3.new(11.6, 0.4, 1), CFrame.new(position + Vector3.new(0, 10.1, 0)), Style.Lighten(color, 0.5), Enum.Material.Neon)
	P(model, "Trim", Vector3.new(11.6, 0.4, 1), CFrame.new(position + Vector3.new(0, 2.9, 0)), Style.Lighten(color, 0.5), Enum.Material.Neon)
	local titleLabel, sub = Style.Sign(face, title, subtitle or " ", Color3.new(1, 1, 1), Enum.NormalId.Front, 36)
	titleLabel.Name = "Title"
	if sub then
		sub.Name = "Price"
	end
	model.PrimaryPart = face
	return face
end

local function fenceLine(parent: Instance, from: Vector3, to: Vector3, height: number)
	local delta = to - from
	local length = delta.Magnitude
	local posts = math.max(2, math.floor(length / 4.5) + 1)
	for n = 0, posts - 1 do
		local at = from + delta * (n / (posts - 1))
		local post = P(parent, "FencePost", Vector3.new(0.9, height + 0.6, 0.9), CFrame.new(at + Vector3.new(0, (height + 0.6) / 2, 0)), WOOD)
		Style.Studs(post)
	end
	local mid = (from + to) / 2
	local cf = CFrame.lookAt(mid, mid + delta)
	for _, y in { height * 0.38, height * 0.85 } do
		P(parent, "FenceRail", Vector3.new(0.45, 0.6, length), cf + Vector3.new(0, y, 0), WOOD_LIGHT)
	end
end

local FLOWERS = { Color3.fromRGB(255, 120, 190), Color3.fromRGB(255, 230, 80), Color3.fromRGB(150, 120, 255), Color3.new(1, 1, 1) }

local function planter(parent: Instance, cf: CFrame, length: number, rng: Random)
	local box = P(parent, "Planter", Vector3.new(3, 1.6, length), cf * CFrame.new(0, 0.8, 0), WOOD)
	Style.Studs(box)
	P(parent, "Soil", Vector3.new(2.4, 0.3, length - 0.6), cf * CFrame.new(0, 1.65, 0), Color3.fromRGB(96, 64, 44))
	for n = 1, math.floor(length / 1.6) do
		local z = -length / 2 + n * 1.6 - 0.6
		noCollide(P(parent, "Bloom", Vector3.new(0.9, 0.9, 0.9), cf * CFrame.new(rng:NextNumber(-0.6, 0.6), 2.3, z), FLOWERS[rng:NextInteger(1, #FLOWERS)], Enum.Material.SmoothPlastic, Enum.PartType.Ball))
		noCollide(P(parent, "Leaf", Vector3.new(0.7, 0.5, 0.7), cf * CFrame.new(rng:NextNumber(-0.7, 0.7), 1.95, z + 0.6), HEDGE))
	end
end

local function lamp(parent: Instance, position: Vector3, color: Color3)
	P(parent, "LampPost", Vector3.new(0.8, 9, 0.8), CFrame.new(position + Vector3.new(0, 4.5, 0)), Color3.fromRGB(50, 52, 80))
	P(parent, "LampCap", Vector3.new(2.2, 0.4, 2.2), CFrame.new(position + Vector3.new(0, 10.7, 0)), Color3.fromRGB(50, 52, 80))
	local bulb = P(parent, "Lamp", Vector3.new(1.8, 1.8, 1.8), CFrame.new(position + Vector3.new(0, 9.6, 0)), color, Enum.Material.Neon, Enum.PartType.Ball)
	Style.Light(bulb, color, 1.2, 16)
end

-- Base props: treadmill upgrade board, sell stall, fuse machine ------------------------

local function uiText(parent: Instance, name: string, text: string, color: Color3, size: UDim2, position: UDim2): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Font = Style.Font
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Style.Ink
	stroke.Parent = label
	label.Parent = parent
	return label
end

local function uiButton(parent: Instance, name: string, color: Color3, size: UDim2, position: UDim2, text: string): TextButton
	local b = Instance.new("TextButton")
	b.Name = name
	b.Text = ""
	b.BackgroundColor3 = color
	b.Size = size
	b.Position = position
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = b
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 4
	stroke.Color = Style.Ink
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = b
	uiText(b, "Label", text, Style.White, UDim2.fromScale(0.9, 0.76), UDim2.fromScale(0.05, 0.12))
	b.Parent = parent
	return b
end

-- Black "Upgrade  Level 1 &gt; Level 2  [$ cash] [R$]" board beside the treadmill. The server fills in the
-- owner's numbers; the owner's client wires the two buttons.
local function upgradeBoard(base: Model, at: CFrame)
	local m = Instance.new("Model")
	m.Name = "UpgradeBoard"
	P(m, "Post", Vector3.new(1.2, 3.6, 1.2), at * CFrame.new(0, 1.8, 0.4), Color3.fromRGB(26, 26, 34))
	local board = P(m, "Board", Vector3.new(7.6, 4.8, 0.6), at * CFrame.new(0, 5.8, 0), Color3.fromRGB(14, 14, 20))
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Screen"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 50
	gui.LightInfluence = 0
	gui.Parent = board
	uiText(gui, "Title", "Upgrade", Style.White, UDim2.fromScale(0.9, 0.24), UDim2.fromScale(0.05, 0.05))
	uiText(gui, "Levels", "Level 1 &gt; Level 2", Color3.fromRGB(110, 255, 90), UDim2.fromScale(0.9, 0.2), UDim2.fromScale(0.05, 0.31))
	uiButton(gui, "CashButton", Color3.fromRGB(230, 40, 50), UDim2.fromScale(0.56, 0.33), UDim2.fromScale(0.04, 0.6), "$0")
	uiButton(gui, "RobuxButton", Color3.fromRGB(165, 55, 225), UDim2.fromScale(0.34, 0.33), UDim2.fromScale(0.62, 0.6), "R$ 0")
	m.PrimaryPart = board
	m.Parent = base
end

local function sellStall(base: Model, at: CFrame)
	local m = Instance.new("Model")
	m.Name = "SellStall"
	for _, x in { -2.7, 2.7 } do
		for _, z in { -1.4, 1.4 } do
			P(m, "Post", Vector3.new(0.5, 7, 0.5), at * CFrame.new(x, 3.5, z), Color3.fromRGB(86, 86, 104))
		end
	end
	local counter = P(m, "Counter", Vector3.new(6, 2.6, 1.3), at * CFrame.new(0, 1.3, -1.1), WOOD)
	Style.Studs(counter)
	P(m, "CounterTop", Vector3.new(6.4, 0.3, 1.7), at * CFrame.new(0, 2.75, -1.1), WOOD_LIGHT)
	for n = 0, 7 do
		local color = if n % 2 == 0 then Color3.fromRGB(230, 40, 50) else Color3.new(1, 1, 1)
		P(m, "Awning", Vector3.new(0.78, 0.3, 3.9), at * CFrame.new(-2.73 + n * 0.78, 7.2, -0.2) * CFrame.Angles(0.22, 0, 0), color)
	end
	local label = Style.Label(counter, "SELL", Color3.fromRGB(255, 60, 70), 7, 2.6, 7.6)
	label.Name = "SellLabel"
	label.MaxDistance = 90
	m.PrimaryPart = counter
	m.Parent = base
end

local function fuseMachine(base: Model, at: CFrame)
	local m = Instance.new("Model")
	m.Name = "FuseMachine"
	local plate = P(m, "Plate", Vector3.new(5.2, 0.6, 4.6), at * CFrame.new(0, 0.3, 0), Color3.fromRGB(150, 156, 170))
	Style.Studs(plate)
	local body = P(m, "Body", Vector3.new(4.2, 4, 3.6), at * CFrame.new(0, 2.6, 0.2), Color3.fromRGB(40, 110, 230))
	Style.Studs(body, true)
	for n = -1, 1 do
		Style.Cylinder(m, "Funnel", 1.4, 1, at * CFrame.new(n * 1.3, 5.3, 0.6), Color3.fromRGB(70, 74, 92))
		Style.Cylinder(m, "FunnelTop", 0.4, 1.5, at * CFrame.new(n * 1.3, 6.1, 0.6), Color3.fromRGB(50, 52, 66))
	end
	local door = P(m, "Door", Vector3.new(2.2, 2.6, 0.2), at * CFrame.new(0.4, 2.3, -1.65), Color3.new(1, 1, 1), Enum.Material.Neon)
	Style.Light(door, Color3.fromRGB(200, 230, 255), 1, 10)
	local screen = P(m, "Screen", Vector3.new(1.4, 0.8, 0.2), at * CFrame.new(-1.45, 3.5, -1.65), Color3.fromRGB(20, 20, 28))
	for n = -1, 1 do
		noCollide(P(m, "Heart", Vector3.new(0.3, 0.3, 0.1), screen.CFrame * CFrame.new(n * 0.4, 0, -0.12), Color3.fromRGB(255, 50, 70), Enum.Material.Neon))
	end
	P(m, "Button", Vector3.new(0.7, 0.3, 0.7), at * CFrame.new(-1.45, 2.4, -1.85), Color3.fromRGB(230, 40, 50))
	P(m, "Lever", Vector3.new(0.25, 2.4, 0.25), at * CFrame.new(-2.3, 5.2, 1) * CFrame.Angles(0, 0, 0.25), Color3.fromRGB(60, 62, 80))
	P(m, "LeverKnob", Vector3.new(0.7, 0.7, 0.7), at * CFrame.new(-2.6, 6.4, 1), Color3.fromRGB(40, 40, 52), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	local title = Style.Label(body, "Fuse Machine", Color3.fromRGB(90, 200, 255), 7, 1.5, 6)
	title.Name = "Title"
	title.MaxDistance = 90
	local count = Style.Label(body, "0/" .. Config.FuseCount, Color3.new(1, 1, 1), 3.5, 1.3, 4.6)
	count.Name = "Count"
	count.MaxDistance = 90
	m.PrimaryPart = body
	m.Parent = base
end

-- Personal treadmills -------------------------------------------------------------------
-- Every level has its own colours; features stack up as the level rises.

function W.BuildTreadmill(base: Model, index: number, level: number): Model
	local old = base:FindFirstChild("Treadmill")
	if old then
		old:Destroy()
	end
	local design = Config.TreadmillDesigns[level]
	local accent, frameColor = design.Accent, design.Frame
	local cf = W.TreadmillCFrame(index)
	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end
	local m = Instance.new("Model")
	m.Name = "Treadmill"
	m:SetAttribute("Level", level)

	local frame = P(m, "Frame", Vector3.new(11, 1, 17), at(0, 0.5, 0), frameColor)
	Style.Studs(frame)
	local belt = P(m, "Belt", Vector3.new(8.4, 0.3, 15), at(0, 1.12, 0), Color3.fromRGB(26, 26, 34))
	local stripes = Instance.new("Texture")
	stripes.Name = "Stripes"
	stripes.Texture = Style.CheckerTexture
	stripes.Face = Enum.NormalId.Top
	stripes.StudsPerTileU = 8.4
	stripes.StudsPerTileV = 3
	stripes.Color3 = accent
	stripes.Transparency = math.max(0.15, 0.6 - level * 0.03)
	stripes.Parent = belt
	for _, x in { -4.9, 4.9 } do
		P(m, "Rail", Vector3.new(0.7, 0.6, 17), at(x, 1.3, 0), if level &gt;= 4 then accent else Style.Lighten(frameColor, 0.3), if level &gt;= 4 then Enum.Material.Neon else Enum.Material.Metal)
		P(m, "Handle", Vector3.new(0.5, 3.6, 0.5), at(x, 3, 7.4), Color3.fromRGB(70, 76, 100), Enum.Material.Metal)
	end
	P(m, "HandleBar", Vector3.new(10.3, 0.5, 0.5), at(0, 4.8, 7.4), if level &gt;= 6 then accent else Color3.fromRGB(70, 76, 100), if level &gt;= 6 then Enum.Material.Neon else Enum.Material.Metal)
	local console = P(m, "Console", Vector3.new(7, 3, 0.6), at(0, 6.6, 8.2) * CFrame.Angles(-0.35, 0, 0), Color3.fromRGB(22, 22, 36))
	P(m, "ConsoleFrame", Vector3.new(7.6, 3.6, 0.4), console.CFrame * CFrame.new(0, 0, 0.35), frameColor)
	local title, sub = Style.Sign(console, string.format("LV %d • %s", level, design.Name:upper()), "+0 speed", accent, Enum.NormalId.Front, 40)
	title.Name = "Title"
	if sub then
		sub.Name = "Info"
	end
	local step = Style.Label(console, "", Color3.fromRGB(255, 255, 255), 6, 1.5, 4.6)
	step.Name = "StepLabel"
	step.MaxDistance = 80

	if level &gt;= 3 then
		for _, x in { -5.6, 5.6 } do
			for n = 0, 4 do
				noCollide(P(m, "SideLight", Vector3.new(0.4, 0.5, 1.4), at(x, 0.8, -6 + n * 3), accent, Enum.Material.Neon))
			end
		end
	end
	if level &gt;= 5 then
		Style.Particles(belt, "Sparkles", {
			Color = ColorSequence.new(accent, Color3.new(1, 1, 1)), Rate = 2 + level,
			Speed = NumberRange.new(1, 3), EmissionDirection = Enum.NormalId.Top,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) }),
		})
	end
	if level &gt;= 7 then
		for _, x in { -5.4, 5.4 } do
			Style.Studs(P(m, "Pylon", Vector3.new(1.2, 6, 1.2), at(x, 3.5, -8), frameColor))
			local orb = noCollide(P(m, "PylonOrb", Vector3.new(1.8, 1.8, 1.8), at(x, 7.4, -8), accent, Enum.Material.Neon, Enum.PartType.Ball))
			Style.Light(orb, accent, 1, 12)
		end
	end
	if level &gt;= 9 then
		for _, x in { -5.8, 5.8 } do
			Style.Studs(P(m, "ArchPost", Vector3.new(1, 10, 1), at(x, 6, -1), frameColor))
		end
		noCollide(P(m, "ArchTop", Vector3.new(12.6, 1, 1.4), at(0, 11.4, -1), accent, Enum.Material.Neon))
	end
	if level &gt;= 11 then
		for _, z in { -5, 3 } do
			for n = 0, 11 do
				local angle = n * math.pi / 6
				noCollide(P(m, "SpeedRing", Vector3.new(0.7, 0.7, 0.4), at(math.cos(angle) * 4.4, 4.6 + math.sin(angle) * 4.4, z) * CFrame.Angles(0, 0, angle), accent, Enum.Material.Neon))
			end
		end
	end
	if level &gt;= 13 then
		for _, x in { -5.2, 5.2 } do
			for _, z in { -8, 8 } do
				local holder = noCollide(P(m, "FlameHolder", Vector3.new(0.6, 0.6, 0.6), at(x, 1.2, z), accent, Enum.Material.Neon))
				Style.Particles(holder, "Flames", {
					Texture = "rbxasset://textures/particles/fire_main.dds", Color = ColorSequence.new(accent, Color3.fromRGB(255, 255, 255)),
					Rate = 14, Speed = NumberRange.new(2, 4), Acceleration = Vector3.new(0, 6, 0), LightEmission = 1,
					Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0) }),
				})
			end
		end
		Style.Light(frame, accent, 0.8, 14)
	end
	if level &gt;= 15 then
		for _, x in { -1, 1 } do
			for n = 0, 2 do
				noCollide(P(m, "Wing", Vector3.new(0.3, 1, 4 - n * 0.9), at(x * (4.6 + n * 0.3), 8 - n * 0.9, 9) * CFrame.Angles(0.5, x * 0.6, x * (0.5 + n * 0.25)), Color3.new(1, 1, 1), Enum.Material.Neon))
			end
		end
		for n = 0, 11 do
			local angle = n * math.pi / 6
			noCollide(P(m, "Halo", Vector3.new(0.5, 0.5, 0.5), at(math.cos(angle) * 2.4, 10.2, 8.6 + math.sin(angle) * 1), Color3.fromRGB(255, 230, 120), Enum.Material.Neon, Enum.PartType.Ball))
		end
		local beam = noCollide(Style.Cylinder(m, "LightBeam", 40, 3, at(0, 20, -1), accent, Enum.Material.Neon))
		beam.Transparency = 0.75
	end

	m.PrimaryPart = frame
	m.Parent = base
	return m
end

-- Sanctuary -------------------------------------------------------------------------

local function buildBase(parent: Instance, index: number)
	local side, c = W.BaseLayout(index)
	local color = Config.BaseColors[index]
	local base = Instance.new("Model")
	base.Name = "Base" .. index
	base:SetAttribute("Owner", 0)
	base:SetAttribute("Index", index)
	base.Parent = parent
	local rng = Random.new(300 + index)
	local function local3(x: number, y: number, z: number): Vector3
		return Vector3.new(c.X + side * x, y, c.Z + z)
	end

	local floor = P(base, "Floor", Vector3.new(36, 0.6, 34), CFrame.new(local3(0, 0.3, 0)), Style.Lighten(color, 0.45))
	Style.Studs(floor)
	for _, edge in { { 0, -16.8, 36, 0.4 }, { 0, 16.8, 36, 0.4 }, { -17.8, 0, 0.4, 34 }, { 17.8, 0, 0.4, 34 } } do
		noCollide(P(base, "Trim", Vector3.new(edge[3], 0.2, edge[4]), CFrame.new(local3(edge[1], 0.65, edge[2])), color, Enum.Material.Neon))
	end

	-- Egg pen.
	local pen = W.PenCenter(index)
	local penFloor = P(base, "PenFloor", Vector3.new(16, 0.62, 32), CFrame.new(pen + Vector3.new(0, 0.31, 0)), Color3.fromRGB(226, 196, 120))
	Style.Studs(penFloor)
	local inner, outer = c.X + side * 1, c.X + side * 17
	local back, front = c.Z - 16, c.Z + 16
	fenceLine(base, Vector3.new(outer, 0.6, back), Vector3.new(outer, 0.6, front), 3.2)
	fenceLine(base, Vector3.new(inner, 0.6, back), Vector3.new(outer, 0.6, back), 3.2)
	fenceLine(base, Vector3.new(inner, 0.6, front), Vector3.new(outer, 0.6, front), 3.2)
	fenceLine(base, Vector3.new(inner, 0.6, back), Vector3.new(inner, 0.6, c.Z - 3.5), 3.2)
	fenceLine(base, Vector3.new(inner, 0.6, c.Z + 3.5), Vector3.new(inner, 0.6, front), 3.2)
	for slot = 1, Config.MaxCapacity do
		local at = W.SlotPosition(index, slot)
		noCollide(Style.Cylinder(base, "Pad", 0.3, 3.1, CFrame.new(at.X, 0.72, at.Z), Color3.fromRGB(240, 214, 140)))
	end
	local income = Style.Label(penFloor, "Free base", Color3.fromRGB(220, 255, 220), 14, 2.2, 10)
	income.Name = "Income"
	income.MaxDistance = 90

	-- Entrance arch with the owner's name, facing the path.
	for _, dz in { 6, 16 } do
		Style.Studs(P(base, "ArchPost", Vector3.new(1.6, 11, 1.6), CFrame.new(local3(-17.2, 5.5, dz)), color))
	end
	local sign = P(base, "OwnerSign", Vector3.new(1, 3, 12), CFrame.new(local3(-17.2, 11.6, 11)), NAVY)
	Style.Studs(sign)
	for _, face in { Enum.NormalId.Left, Enum.NormalId.Right } do
		local title = Style.Sign(sign, "FREE BASE", nil, color, face, 30)
		title.Name = "Owner"
	end

	-- Spawn pad.
	local pad = Style.Cylinder(base, "SpawnPad", 0.4, 7, CFrame.new(W.SpawnPoint(index) - Vector3.new(0, 2.9, 0)), color, Enum.Material.Neon)
	noCollide(pad).Transparency = 0.3
	Style.Particles(pad, "Glow", {
		Color = ColorSequence.new(color), Rate = 3, Speed = NumberRange.new(1, 2), EmissionDirection = Enum.NormalId.Right,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) }),
	})

	-- Hedge between neighbouring bases, banner on the wall, flowers and a lamp.
	local hedge = P(base, "Hedge", Vector3.new(36, 3, 1.8), CFrame.new(local3(0, 1.5, -17.6)), HEDGE)
	Style.Studs(hedge)
	for n = 0, 7 do
		noCollide(P(base, "HedgeFlower", Vector3.new(0.8, 0.8, 0.8), CFrame.new(local3(-15 + n * 4.3, 3.1, -17.6)), FLOWERS[n % #FLOWERS + 1], Enum.Material.SmoothPlastic, Enum.PartType.Ball))
	end
	local banner = P(base, "Banner", Vector3.new(0.6, 14, 9), CFrame.new(Vector3.new(side * (Config.HalfWidth - 0.4), 22, c.Z)), color)
	Style.Studs(banner, true)
	Style.Sign(banner, tostring(index), nil, Color3.new(1, 1, 1), if side &lt; 0 then Enum.NormalId.Right else Enum.NormalId.Left, 20)
	planter(base, CFrame.new(local3(-15.5, 0.6, -10)), 9, rng)
	lamp(base, local3(-16.5, 0.6, -16), Style.Lighten(color, 0.4))

	-- Upgrade board faces the treadmill; the stall and fuse machine face the spawn pad.
	local inward = Vector3.new(side, 0, 0)
	local boardAt = local3(-15.4, 0.6, -0.5)
	upgradeBoard(base, CFrame.lookAt(boardAt, boardAt + inward))
	local stallAt = local3(-12, 0.6, 15.2)
	sellStall(base, CFrame.lookAt(stallAt, stallAt - Vector3.new(0, 0, 1)))
	local fuseAt = local3(-2.4, 0.6, 12.4)
	fuseMachine(base, CFrame.lookAt(fuseAt, fuseAt - inward))

	W.BuildTreadmill(base, index, 1)
	base.PrimaryPart = floor
	return base
end

local function buildShop(parent: Instance)
	local model = Instance.new("Model")
	model.Name = "TrailShop"
	model.Parent = parent
	local cf = W.ShopCFrame
	local function at(x: number, y: number, z: number): CFrame
		return cf * CFrame.new(x, y, z)
	end
	local deck = P(model, "Deck", Vector3.new(24, 0.6, 18), at(0, 0.3, 2), Color3.fromRGB(255, 220, 240))
	Style.Studs(deck)
	local counter = P(model, "Counter", Vector3.new(14, 3.4, 4), at(0, 1.7, -2), Color3.fromRGB(255, 120, 190))
	Style.Studs(counter)
	P(model, "CounterTop", Vector3.new(14.6, 0.5, 4.6), at(0, 3.65, -2), Color3.fromRGB(255, 240, 250))
	for _, x in { -6.8, 6.8 } do
		for _, z in { -3.8, 3.8 } do
			P(model, "Pole", Vector3.new(0.8, 11, 0.8), at(x, 5.5, z), Color3.new(1, 1, 1))
		end
	end
	for n = 0, 7 do
		local stripe = P(model, "Awning", Vector3.new(2, 0.8, 10), at(-7 + n * 2, 11.4, 0) * CFrame.Angles(0.12, 0, 0),
			if n % 2 == 0 then Color3.fromRGB(255, 90, 170) else Color3.new(1, 1, 1))
		Style.Studs(stripe)
	end
	local sign = P(model, "Sign", Vector3.new(15, 3.4, 0.8), at(0, 14, -4.2), NAVY)
	Style.Sign(sign, "TRAIL SHOP", nil, Color3.fromRGB(255, 160, 220), Enum.NormalId.Front, 30)
	for i, trail in Config.Trails do
		local orb = noCollide(P(model, "TrailOrb", Vector3.new(1.4, 1.4, 1.4), at(-6.2 + (i - 1) * 2.5, 5, -2), trail.Colors[1], Enum.Material.Neon, Enum.PartType.Ball))
		Style.Light(orb, trail.Colors[1], 0.6, 6)
	end
	-- Display mannequin pads with trail ribbons.
	for i = 1, 3 do
		local trail = Config.Trails[i * 2]
		local podium = Style.Cylinder(model, "Podium", 1, 3.4, at(-8 + (i - 1) * 8, 0.8, 8), Color3.fromRGB(255, 240, 250))
		Style.Studs(podium)
		local ribbon = noCollide(P(model, "Ribbon", Vector3.new(0.4, 6, 1.6), at(-8 + (i - 1) * 8, 4.3, 8) * CFrame.Angles(0, 0, 0.3), trail.Colors[1], Enum.Material.Neon))
		ribbon.Transparency = 0.2
	end
	local promptPart = noCollide(P(model, "PromptPart", Vector3.new(2, 2, 2), at(0, 3, -4.6), Color3.new(1, 1, 1)))
	promptPart.Transparency = 1
	model.PrimaryPart = counter
	return model
end

local function buildIndex(parent: Instance)
	local model = Instance.new("Model")
	model.Name = "EggIndex"
	model.Parent = parent
	local c = W.Boards.Index
	local face = P(model, "Board", Vector3.new(12, 11, 0.8), CFrame.new(c + Vector3.new(0, 7.5, 0)), NAVY)
	for _, x in { -6.4, 6.4 } do
		P(model, "Post", Vector3.new(1, 13, 1), CFrame.new(c + Vector3.new(x, 6.5, 0)), Color3.fromRGB(80, 70, 140))
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = face
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 2)
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.Parent = gui
	local header = Instance.new("TextLabel")
	header.Size = UDim2.new(1, 0, 0, 50)
	header.BackgroundTransparency = 1
	header.Font = Style.Font
	header.TextScaled = true
	header.Text = "EGG RARITIES"
	header.TextColor3 = Color3.fromRGB(255, 220, 100)
	header.Parent = gui
	for _, rarity in Config.Rarities do
		local row = Instance.new("TextLabel")
		row.Size = UDim2.new(0.92, 0, 0, 36)
		row.BackgroundTransparency = 1
		row.Font = Style.Font
		row.TextScaled = true
		row.Text = string.format("%s  •  x%d income", rarity.Name, rarity.Multiplier)
		row.TextColor3 = rarity.Color
		row.Parent = gui
		local s = Instance.new("UIStroke")
		s.Thickness = 2
		s.Color = Style.Ink
		s.Parent = row
	end
	local footer = header:Clone()
	footer.Size = UDim2.new(0.92, 0, 0, 30)
	footer.Text = "Deeper zones = rarer eggs!"
	footer.TextColor3 = Color3.fromRGB(150, 255, 200)
	footer.Parent = gui
	return model
end

local function buildFountain(parent: Instance)
	local c = W.FountainPosition
	local f = Instance.new("Model")
	f.Name = "Fountain"
	f.Parent = parent
	local basin = Style.Cylinder(f, "Basin", 1.8, 20, CFrame.new(c + Vector3.new(0, 0.9, 0)), Color3.fromRGB(240, 244, 255))
	Style.Studs(basin)
	local water = noCollide(Style.Cylinder(f, "Water", 0.3, 18, CFrame.new(c + Vector3.new(0, 1.7, 0)), Color3.fromRGB(90, 200, 255), Enum.Material.Glass))
	water.Transparency = 0.35
	Style.Cylinder(f, "Pillar", 5, 3.4, CFrame.new(c + Vector3.new(0, 3.6, 0)), Color3.fromRGB(220, 226, 245))
	local bowl = Style.Cylinder(f, "Bowl", 1, 9, CFrame.new(c + Vector3.new(0, 6.4, 0)), Color3.fromRGB(240, 244, 255))
	Style.Studs(bowl)
	local spray = noCollide(Style.Cylinder(f, "Spray", 0.2, 8, CFrame.new(c + Vector3.new(0, 7, 0)), Color3.fromRGB(150, 230, 255), Enum.Material.Neon))
	spray.Transparency = 0.5
	Style.Particles(spray, "Splash", {
		Color = ColorSequence.new(Color3.fromRGB(180, 240, 255)), Rate = 30, Speed = NumberRange.new(6, 9),
		SpreadAngle = Vector2.new(25, 25), EmissionDirection = Enum.NormalId.Right, Acceleration = Vector3.new(0, -25, 0),
		Lifetime = NumberRange.new(0.6, 0.9), Size = NumberSequence.new(0.3), LightEmission = 0.4,
	})
	local egg = Eggs.Build(6, 7, CFrame.new(c + Vector3.new(0, 11.4, 0)), { Scale = 1.7, Parent = f })
	egg.Name = "FountainEgg"
	for _, part in egg:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
		end
	end
	for n = 0, 7 do
		local angle = n * math.pi / 4
		local seat = Vector3.new(math.cos(angle) * 16, 0, math.sin(angle) * 16)
		if n % 2 == 0 then
			planter(f, CFrame.lookAt(c + seat + Vector3.new(0, 0, 0), c) * CFrame.Angles(0, math.pi / 2, 0), 6, Random.new(n))
		else
			local bench = P(f, "Bench", Vector3.new(6, 0.6, 2), CFrame.lookAt(c + seat + Vector3.new(0, 1.6, 0), c + Vector3.new(0, 1.6, 0)) * CFrame.Angles(0, math.pi / 2, 0), WOOD_LIGHT)
			Style.Studs(bench)
			P(f, "BenchLeg", Vector3.new(5, 1.3, 1.2), bench.CFrame * CFrame.new(0, -0.95, 0), WOOD)
		end
	end
end

local function buildSanctuary(root: Instance)
	local hub = folder(root, "Sanctuary")
	local length = Config.SafeZ - Config.SanctuaryStart
	local midZ = (Config.SafeZ + Config.SanctuaryStart) / 2
	local floor = P(hub, "Floor", Vector3.new(156, 4, length), CFrame.new(0, -2, midZ), Color3.fromRGB(120, 214, 196))
	Style.Checker(floor, 8, { Enum.NormalId.Top }, 0.86)
	local path = P(hub, "Path", Vector3.new(22, 0.2, length), CFrame.new(0, 0.1, midZ), Color3.fromRGB(236, 250, 244))
	Style.Checker(path, 5.5, { Enum.NormalId.Top }, 0.9)
	for _, x in { -11.4, 11.4 } do
		Style.Studs(P(hub, "PathEdge", Vector3.new(0.8, 0.5, length), CFrame.new(x, 0.25, midZ), Color3.fromRGB(255, 214, 80)))
	end

	for _, x in { -1, 1 } do
		local wall = P(hub, "Wall", Vector3.new(6, Config.WallHeight, length + 6), CFrame.new(x * (Config.HalfWidth + 3), Config.WallHeight / 2, midZ - 3), Color3.fromRGB(110, 196, 236))
		Style.Checker(wall, 8, nil, 0.82)
		local trim = P(hub, "WallTrim", Vector3.new(8, 3, length + 6), CFrame.new(x * (Config.HalfWidth + 3), Config.WallHeight + 1.5, midZ - 3), Color3.fromRGB(96, 214, 96))
		Style.Studs(trim)
		P(hub, "Glow", Vector3.new(0.4, 0.8, length), CFrame.new(x * (Config.HalfWidth - 0.1), 3, midZ), SAFE, Enum.Material.Neon)
	end
	local rear = P(hub, "RearWall", Vector3.new(Config.HalfWidth * 2 + 12, Config.WallHeight, 6), CFrame.new(0, Config.WallHeight / 2, Config.SanctuaryStart - 3), Color3.fromRGB(110, 196, 236))
	Style.Checker(rear, 8, nil, 0.82)
	local rearTrim = P(hub, "RearTrim", Vector3.new(Config.HalfWidth * 2 + 12, 3, 8), CFrame.new(0, Config.WallHeight + 1.5, Config.SanctuaryStart - 3), Color3.fromRGB(96, 214, 96))
	Style.Studs(rearTrim)

	-- Title board with giant eggs.
	local title = P(hub, "TitleBoard", Vector3.new(78, 20, 2), CFrame.new(0, 36, Config.SanctuaryStart + 0.6), NAVY)
	Style.Sign(title, "MONSTER EGG ESCAPE", "STEAL  •  RUN  •  GROW", Color3.fromRGB(255, 214, 80), Enum.NormalId.Front, 12)
	for _, edge in { { 0, 10.4, 79, 1 }, { 0, -10.4, 79, 1 }, { -39.6, 0, 1, 21.8 }, { 39.6, 0, 1, 21.8 } } do
		P(hub, "TitleGlow", Vector3.new(edge[3], edge[4], 1.4), CFrame.new(edge[1], 36 + edge[2], Config.SanctuaryStart + 1.2), Color3.fromRGB(255, 120, 200), Enum.Material.Neon)
	end
	for n, rarity in { 5, 7, 4 } do
		local egg = Eggs.Build(1 + n, rarity, CFrame.new((n - 2) * 34, 52, Config.SanctuaryStart + 2), { Scale = 2.6, Parent = hub })
		egg.Name = "GiantEgg"
		for _, part in egg:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = true
			end
		end
	end

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SanctuarySpawn"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(Config.SpawnPosition) * CFrame.Angles(0, math.pi, 0) -- face the zones
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Color = Color3.fromRGB(255, 214, 80)
	spawn.Material = Enum.Material.Plastic
	spawn.TopSurface = Enum.SurfaceType.Studs
	spawn.Parent = hub
	noCollide(Style.Cylinder(hub, "SpawnRing", 0.3, 15, CFrame.new(Config.SpawnPosition - Vector3.new(0, 0.4, 0)), Color3.fromRGB(255, 120, 200), Enum.Material.Neon))

	-- Safe zone gate.
	local line = P(hub, "SafeLine", Vector3.new(Config.HalfWidth * 2, 0.3, 1.6), CFrame.new(0, 0.15, Config.SafeZ), SAFE, Enum.Material.Neon)
	noCollide(line)
	local barrier = P(hub, "SafeBarrier", Vector3.new(Config.HalfWidth * 2, 40, 0.4), CFrame.new(0, 20, Config.SafeZ), SAFE, Enum.Material.ForceField)
	barrier.Transparency = 0.5
	noCollide(barrier)
	for _, x in { -22, 22 } do
		local pillar = P(hub, "GatePillar", Vector3.new(6, 28, 6), CFrame.new(x, 14, Config.SafeZ), Color3.fromRGB(255, 255, 255))
		Style.Studs(pillar, true)
		P(hub, "GateCap", Vector3.new(7, 2, 7), CFrame.new(x, 29, Config.SafeZ), SAFE, Enum.Material.Neon)
		local orb = noCollide(P(hub, "GateOrb", Vector3.new(3, 3, 3), CFrame.new(x, 31.6, Config.SafeZ), SAFE, Enum.Material.Neon, Enum.PartType.Ball))
		Style.Light(orb, SAFE, 2, 24)
	end
	local beam = P(hub, "GateBeam", Vector3.new(50, 7, 5), CFrame.new(0, 32, Config.SafeZ), Color3.fromRGB(40, 150, 110))
	Style.Studs(beam)
	Style.Sign(beam, "SAFE ZONE", "Monsters can't enter • Eggs are banked", Color3.fromRGB(180, 255, 220), Enum.NormalId.Front, 20)
	Style.Sign(beam, "SAFE ZONE", "Run back here with your egg!", Color3.fromRGB(180, 255, 220), Enum.NormalId.Back, 20)

	local bases = folder(hub, "Bases")
	for index = 1, Config.MaxPlayers do
		buildBase(bases, index)
		task.wait()
	end
	local boards = folder(hub, "Boards")
	board(boards, "SpeedBoard", W.Boards.Speed, Color3.fromRGB(46, 160, 230), "SPEED +", "Loading...")
	board(boards, "StorageBoard", W.Boards.Storage, Color3.fromRGB(140, 90, 220), "STORAGE +4", "Loading...")
	board(boards, "InfoBoard", W.Boards.Info, Color3.fromRGB(60, 190, 120), "HOW TO PLAY", "Steal eggs • Run back here")
	buildIndex(hub)
	buildShop(hub)
	buildFountain(hub)

	-- Lamps and planters along the path.
	local rng = Random.new(5)
	for _, x in { -14, 14 } do
		for n = 0, 4 do
			local z = -88 + n * 40
			lamp(hub, Vector3.new(x, 0, z), Color3.fromRGB(255, 236, 170))
			if n &gt; 0 and n &lt; 4 then
				planter(hub, CFrame.new(x, 0, z + 18), 10, rng)
			end
		end
	end
	return hub
end

-- Zone decor ---------------------------------------------------------------------------

-- Circles (x, z, radius) that decor must stay out of: the current zone's nest and guardian bed.
local keepClear: { Vector3 } = {}

local function isClear(position: Vector3): boolean
	for _, circle in keepClear do
		if (Vector2.new(position.X, position.Z) - Vector2.new(circle.X, circle.Y)).Magnitude &lt; circle.Z then
			return false
		end
	end
	return true
end

local function scatter(rng: Random, start: number, count: number, minX: number?, maxX: number?)
	local out = {}
	for n = 1, count do
		local side = if n % 2 == 0 then 1 else -1
		local x = side * rng:NextNumber(minX or 22, maxX or 68)
		local z = start + 10 + (n - 0.5) / count * (Config.ZoneLength - 20) + rng:NextNumber(-5, 5)
		local position = Vector3.new(x, 0, z)
		if isClear(position) then
			table.insert(out, position)
		end
	end
	return out
end

local function forest(f: Instance, rng: Random, start: number)
	local greens = { Color3.fromRGB(70, 190, 70), Color3.fromRGB(96, 214, 80), Color3.fromRGB(56, 160, 64) }
	for _, at in scatter(rng, start, 14, 30, 66) do
		local h = rng:NextNumber(8, 12)
		Style.Studs(P(f, "Trunk", Vector3.new(3, h, 3), CFrame.new(at + Vector3.new(0, h / 2, 0)), Color3.fromRGB(126, 82, 50)))
		for k, s in { 11, 8, 5 } do
			local leaf = P(f, "Canopy", Vector3.new(s, 3.4, s), CFrame.new(at + Vector3.new(0, h + (k - 1) * 3.2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 1), 0), greens[k])
			Style.Studs(leaf)
		end
		for _ = 1, 2 do
			noCollide(P(f, "Apple", Vector3.new(1, 1, 1), CFrame.new(at + Vector3.new(rng:NextNumber(-4, 4), h - 0.4, rng:NextNumber(-4, 4))), Color3.fromRGB(230, 50, 50), nil, Enum.PartType.Ball))
		end
	end
	for _, at in scatter(rng, start, 18, 18, 70) do
		local s = rng:NextNumber(3, 5)
		Style.Studs(P(f, "Bush", Vector3.new(s * 1.4, s, s), CFrame.new(at + Vector3.new(0, s / 2, 0)), greens[2]))
		Style.Studs(P(f, "Bush", Vector3.new(s, s * 0.8, s), CFrame.new(at + Vector3.new(s * 0.6, s * 1.1, 0.4)), greens[1]))
	end
	for _, at in scatter(rng, start, 10, 16, 60) do
		P(f, "MushroomStem", Vector3.new(1.2, 2.4, 1.2), CFrame.new(at + Vector3.new(0, 1.2, 0)), Color3.fromRGB(250, 240, 220))
		Style.Studs(P(f, "MushroomCap", Vector3.new(4, 1.4, 4), CFrame.new(at + Vector3.new(0, 2.9, 0)), Color3.fromRGB(230, 60, 60)))
		for d = -1, 1, 2 do
			P(f, "Dot", Vector3.new(0.8, 0.2, 0.8), CFrame.new(at + Vector3.new(d * 1, 3.65, d * 0.6)), Color3.new(1, 1, 1))
		end
	end
	local flowerColors = { Color3.fromRGB(255, 120, 190), Color3.fromRGB(255, 230, 80), Color3.fromRGB(150, 120, 255), Color3.new(1, 1, 1) }
	for _, at in scatter(rng, start, 26, 14, 72) do
		for k = 1, 3 do
			local p = at + Vector3.new(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2))
			noCollide(P(f, "Stem", Vector3.new(0.2, 1.2, 0.2), CFrame.new(p + Vector3.new(0, 0.6, 0)), Color3.fromRGB(60, 150, 60)))
			noCollide(P(f, "Bloom", Vector3.new(0.9, 0.5, 0.9), CFrame.new(p + Vector3.new(0, 1.3, 0)), flowerColors[(k + math.floor(p.Z)) % 4 + 1]))
		end
	end
end

local function desert(f: Instance, rng: Random, start: number)
	local cactus = Color3.fromRGB(86, 176, 82)
	for _, at in scatter(rng, start, 14, 20, 68) do
		local h = rng:NextNumber(6, 10)
		Style.Studs(P(f, "Cactus", Vector3.new(2.4, h, 2.4), CFrame.new(at + Vector3.new(0, h / 2, 0)), cactus))
		for _, s in { -1, 1 } do
			local y = rng:NextNumber(h * 0.35, h * 0.6)
			Style.Studs(P(f, "CactusArm", Vector3.new(2, 1.8, 1.8), CFrame.new(at + Vector3.new(s * 2, y, 0)), cactus))
			Style.Studs(P(f, "CactusArm", Vector3.new(1.8, 3.4, 1.8), CFrame.new(at + Vector3.new(s * 2.9, y + 2.4, 0)), Style.Lighten(cactus, 0.1)))
		end
		noCollide(P(f, "CactusFlower", Vector3.new(1.2, 0.8, 1.2), CFrame.new(at + Vector3.new(0, h + 0.4, 0)), Color3.fromRGB(255, 110, 170)))
	end
	for _, s in { -1, 1 } do
		for _, dz in { 45, 135 } do
			local at = Vector3.new(s * 54, 0, start + dz + s * 10)
			for k = 0, 5 do
				local size = 26 - k * 4.4
				Style.Studs(P(f, "Pyramid", Vector3.new(size, 3, size), CFrame.new(at + Vector3.new(0, 1.5 + k * 3, 0)), if k % 2 == 0 then Color3.fromRGB(236, 196, 120) else Color3.fromRGB(220, 176, 100)))
			end
			P(f, "PyramidDoor", Vector3.new(4, 5, 0.4), CFrame.new(at + Vector3.new(0, 2.5, -13.1)), Color3.fromRGB(60, 40, 30))
		end
	end
	for _, at in scatter(rng, start, 10, 24, 66) do
		Style.Wedge(f, "Dune", Vector3.new(12, 3.5, 7), CFrame.new(at + Vector3.new(0, 1.75, -3.5)), Color3.fromRGB(246, 214, 140))
		Style.Wedge(f, "Dune", Vector3.new(12, 3.5, 7), CFrame.new(at + Vector3.new(0, 1.75, 3.5)) * CFrame.Angles(0, math.pi, 0), Color3.fromRGB(240, 204, 128))
	end
	for _, at in scatter(rng, start, 5, 18, 40) do
		Style.Studs(P(f, "Skull", Vector3.new(3.4, 2.8, 3.4), CFrame.new(at + Vector3.new(0, 1.4, 0)), Color3.fromRGB(250, 244, 226)))
		for _, s in { -1, 1 } do
			P(f, "EyeSocket", Vector3.new(0.9, 0.9, 0.2), CFrame.new(at + Vector3.new(s * 0.8, 1.8, -1.71)), Color3.fromRGB(40, 30, 30))
			P(f, "Horn", Vector3.new(0.6, 2, 0.6), CFrame.new(at + Vector3.new(s * 2, 3, 0)) * CFrame.Angles(0, 0, -s * 0.6), Color3.fromRGB(250, 244, 226))
		end
	end
	for _, at in scatter(rng, start, 6, 56, 70) do
		for k = 0, 4 do
			P(f, "PalmTrunk", Vector3.new(1.6, 2.4, 1.6), CFrame.new(at + Vector3.new(k * 0.4, 1.2 + k * 2.3, 0)) * CFrame.Angles(0, 0, -0.15), Color3.fromRGB(150, 104, 60))
		end
		for n = 0, 4 do
			local angle = n * math.pi * 2 / 5
			local leaf = P(f, "PalmLeaf", Vector3.new(1.6, 0.5, 6), CFrame.new(at + Vector3.new(2, 12.2, 0)) * CFrame.Angles(0, angle, 0) * CFrame.new(0, 0, -2.8) * CFrame.Angles(-0.35, 0, 0), Color3.fromRGB(70, 180, 70))
			Style.Studs(leaf)
		end
	end
end

local function ice(f: Instance, rng: Random, start: number)
	local snow = Color3.fromRGB(246, 252, 255)
	for _, at in scatter(rng, start, 14, 26, 68) do
		P(f, "PineTrunk", Vector3.new(1.6, 3, 1.6), CFrame.new(at + Vector3.new(0, 1.5, 0)), Color3.fromRGB(110, 76, 50))
		for k, s in { 9, 7, 5, 3 } do
			local y = 3 + (k - 1) * 2.6
			Style.Studs(P(f, "PineLayer", Vector3.new(s, 2.4, s), CFrame.new(at + Vector3.new(0, y + 1.2, 0)) * CFrame.Angles(0, k * 0.4, 0), Color3.fromRGB(40, 120, 90)))
			noCollide(P(f, "SnowCap", Vector3.new(s * 0.8, 0.4, s * 0.8), CFrame.new(at + Vector3.new(0, y + 2.6, 0)) * CFrame.Angles(0, k * 0.4, 0), snow))
		end
	end
	for _, at in scatter(rng, start, 16, 18, 70) do
		for k = 1, 3 do
			local spike = P(f, "IceSpike", Vector3.new(1.6, rng:NextNumber(4, 9), 1.6), CFrame.new(at + Vector3.new(k - 2, 2.5, rng:NextNumber(-1, 1))) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 3), rng:NextNumber(-0.3, 0.3)), Color3.fromRGB(140, 220, 255), Enum.Material.Glass)
			spike.Transparency = 0.25
		end
	end
	for _, at in scatter(rng, start, 4, 26, 44) do
		for k, s in { 4, 3, 2.2 } do
			P(f, "Snowball", Vector3.new(s, s, s), CFrame.new(at + Vector3.new(0, ({ 2, 5.2, 7.6 })[k], 0)), snow, Enum.Material.Snow, Enum.PartType.Ball)
		end
		P(f, "Hat", Vector3.new(1.4, 1.4, 1.4), CFrame.new(at + Vector3.new(0, 9.2, 0)), Color3.fromRGB(30, 30, 40))
		P(f, "Carrot", Vector3.new(0.4, 0.4, 1.4), CFrame.new(at + Vector3.new(0, 7.6, -1.5)), Color3.fromRGB(255, 140, 40))
	end
	for _, s in { -1, 1 } do
		local at = Vector3.new(s * 56, 0, start + 90)
		P(f, "Igloo", Vector3.new(16, 16, 16), CFrame.new(at), snow, Enum.Material.Snow, Enum.PartType.Ball)
		P(f, "IglooDoor", Vector3.new(4, 5, 4), CFrame.new(at + Vector3.new(-s * 7, 2.5, 0)), Color3.fromRGB(70, 110, 160))
	end
	for _, at in scatter(rng, start, 12, 16, 72) do
		noCollide(P(f, "SnowPile", Vector3.new(6, 1.6, 4), CFrame.new(at + Vector3.new(0, 0.3, 0)), snow, Enum.Material.Snow, Enum.PartType.Ball))
	end
end

local function lava(f: Instance, rng: Random, start: number)
	local basalt = Color3.fromRGB(58, 42, 46)
	local molten = Color3.fromRGB(255, 110, 30)
	for _, s in { -1, 1 } do
		local river = P(f, "LavaRiver", Vector3.new(14, 0.3, Config.ZoneLength - 10), CFrame.new(s * 44, 0.12, start + Config.ZoneLength / 2), molten, Enum.Material.Neon)
		river.CanCollide = false
		Style.Particles(river, "Embers", {
			Texture = "rbxasset://textures/particles/fire_sparks_main.dds", Color = ColorSequence.new(Color3.fromRGB(255, 200, 80), molten),
			Rate = 25, Lifetime = NumberRange.new(1, 2), Speed = NumberRange.new(2, 6), EmissionDirection = Enum.NormalId.Top,
			Size = NumberSequence.new(0.4), LightEmission = 1,
		})
		for _, dz in { 50, 135 } do
			local at = Vector3.new(s * 60, 0, start + dz)
			for k, d in { 26, 20, 14, 9 } do
				Style.Studs(P(f, "Volcano", Vector3.new(d, 4, d), CFrame.new(at + Vector3.new(0, 2 + (k - 1) * 4, 0)) * CFrame.Angles(0, k * 0.3, 0), if k % 2 == 0 then basalt else Style.Lighten(basalt, 0.1)))
			end
			local crater = P(f, "Crater", Vector3.new(6, 1, 6), CFrame.new(at + Vector3.new(0, 16.4, 0)), molten, Enum.Material.Neon)
			Style.Light(crater, molten, 3, 30)
			Style.Particles(crater, "Smoke", {
				Texture = "rbxasset://textures/particles/smoke_main.dds", Color = ColorSequence.new(Color3.fromRGB(90, 70, 70)),
				Rate = 6, Lifetime = NumberRange.new(3, 5), Speed = NumberRange.new(6, 9), EmissionDirection = Enum.NormalId.Top,
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 12) }),
				Transparency = NumberSequence.new(0.3, 1), LightEmission = 0.1,
			})
		end
	end
	for _, at in scatter(rng, start, 14, 20, 34) do
		local h = rng:NextNumber(5, 14)
		Style.Studs(P(f, "BasaltPillar", Vector3.new(4, h, 4), CFrame.new(at + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 1.5), 0), basalt))
		P(f, "PillarGlow", Vector3.new(4.2, 0.4, 4.2), CFrame.new(at + Vector3.new(0, h * 0.6, 0)), molten, Enum.Material.Neon)
	end
	for _, at in scatter(rng, start, 12, 16, 70) do
		local rock = P(f, "LavaRock", Vector3.new(3, 2, 3), CFrame.new(at + Vector3.new(0, 1, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), basalt)
		Style.Studs(rock)
		noCollide(P(f, "RockCrack", Vector3.new(3.1, 0.3, 0.4), rock.CFrame * CFrame.new(0, 0.2, 0), molten, Enum.Material.Neon))
	end
end

local function toxic(f: Instance, rng: Random, start: number)
	local purple = Color3.fromRGB(110, 60, 170)
	local lime = Color3.fromRGB(90, 220, 30)
	local hazard = Color3.fromRGB(252, 204, 40)
	for _, s in { -1, 1 } do
		for _, dz in { 40, 130 } do
			local at = Vector3.new(s * 54, 0, start + dz)
			local building = P(f, "Factory", Vector3.new(24, 16, 20), CFrame.new(at + Vector3.new(0, 8, 0)), purple)
			Style.Studs(building, true)
			for k = 0, 5 do
				P(f, "RoofStripe", Vector3.new(24.4, 1, 3.3), CFrame.new(at + Vector3.new(0, 16.5, -8.3 + k * 3.3)), if k % 2 == 0 then lime else Color3.fromRGB(70, 150, 40))
			end
			local doorX = -s * 12.05
			for k = 0, 4 do
				P(f, "Door", Vector3.new(0.3, 1.6, 8), CFrame.new(at + Vector3.new(doorX, 0.8 + k * 1.6, 0)), if k % 2 == 0 then hazard else Color3.fromRGB(30, 30, 36))
			end
			for _, dz2 in { -6.5, 6.5 } do
				P(f, "Window", Vector3.new(0.3, 3, 3.4), CFrame.new(at + Vector3.new(doorX, 11, dz2)), lime, Enum.Material.Neon)
			end
			local signPart = P(f, "RadSign", Vector3.new(0.4, 4, 4), CFrame.new(at + Vector3.new(doorX * 1.02, 11, 0)), hazard)
			Style.Sign(signPart, "☢", nil, Color3.fromRGB(30, 30, 36), if s &gt; 0 then Enum.NormalId.Left else Enum.NormalId.Right, 30)
			local chimney = Style.Cylinder(f, "Chimney", 10, 3, CFrame.new(at + Vector3.new(s * 6, 21, 5)), Color3.fromRGB(70, 70, 82), Enum.Material.Metal)
			Style.Particles(chimney, "Smog", {
				Texture = "rbxasset://textures/particles/smoke_main.dds", Color = ColorSequence.new(Color3.fromRGB(140, 220, 90)),
				Rate = 5, Lifetime = NumberRange.new(3, 4), Speed = NumberRange.new(5, 8), EmissionDirection = Enum.NormalId.Right,
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 7) }), Transparency = NumberSequence.new(0.4, 1),
			})
		end
	end
	for _, at in scatter(rng, start, 10, 18, 36) do
		for k = 0, 2 do
			local p = at + Vector3.new((k - 1) * 3.2, 0, (k % 2) * 2)
			local barrel = Style.Cylinder(f, "Barrel", 3.6, 3, CFrame.new(p + Vector3.new(0, 1.8, 0)), if k == 1 then hazard else Color3.fromRGB(60, 140, 50))
			Style.Studs(barrel)
			noCollide(Style.Cylinder(f, "Goo", 0.3, 2.4, CFrame.new(p + Vector3.new(0, 3.65, 0)), lime, Enum.Material.Neon))
		end
	end
	for _, at in scatter(rng, start, 12, 20, 70) do
		local h = rng:NextNumber(4, 8)
		P(f, "ShroomStem", Vector3.new(1, h, 1), CFrame.new(at + Vector3.new(0, h / 2, 0)), Color3.fromRGB(230, 240, 200))
		local cap = P(f, "ShroomCap", Vector3.new(5, 1.4, 5), CFrame.new(at + Vector3.new(0, h + 0.4, 0)), Color3.fromRGB(120, 230, 40), Enum.Material.Neon)
		Style.Light(cap, lime, 1.2, 14)
	end
	for _, at in scatter(rng, start, 6, 24, 40) do
		local pool = Style.Cylinder(f, "SludgePool", 0.3, 10, CFrame.new(at + Vector3.new(0, 0.12, 0)), lime, Enum.Material.Neon)
		pool.CanCollide = false
		Style.Particles(pool, "Bubbles", {
			Color = ColorSequence.new(lime), Rate = 6, Speed = NumberRange.new(1, 3), EmissionDirection = Enum.NormalId.Right,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }), Lifetime = NumberRange.new(0.6, 1.2),
		})
	end
	for _, s in { -1, 1 } do
		local pipe = P(f, "Pipe", Vector3.new(Config.ZoneLength, 3, 3), CFrame.new(s * 72.6, 10, start + Config.ZoneLength / 2) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(90, 90, 104), Enum.Material.Metal, Enum.PartType.Cylinder)
		pipe.CanCollide = false
	end
end

local function shadow(f: Instance, rng: Random, start: number)
	local obsidian = Color3.fromRGB(60, 30, 100)
	local glow = Color3.fromRGB(180, 96, 255)
	for _, at in scatter(rng, start, 16, 20, 70) do
		for k = 1, 3 do
			local h = rng:NextNumber(5, 13)
			local crystal = P(f, "Crystal", Vector3.new(2.2, h, 2.2), CFrame.new(at + Vector3.new((k - 2) * 1.6, h / 2 - 0.5, rng:NextNumber(-1, 1))) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, 3), rng:NextNumber(-0.3, 0.3)),
				if k == 2 then glow else obsidian, if k == 2 then Enum.Material.Neon else Enum.Material.Glass)
			crystal.Transparency = if k == 2 then 0.1 else 0.2
		end
	end
	for _, at in scatter(rng, start, 8, 30, 66) do
		Style.Studs(P(f, "DeadTrunk", Vector3.new(2.2, 12, 2.2), CFrame.new(at + Vector3.new(0, 6, 0)), Color3.fromRGB(40, 30, 44)))
		for k = 1, 3 do
			P(f, "DeadBranch", Vector3.new(1, 5, 1), CFrame.new(at + Vector3.new(0, 7 + k * 1.6, 0)) * CFrame.Angles(0, k * 2.1, 0) * CFrame.new(0, 0, -2) * CFrame.Angles(-0.8, 0, 0), Color3.fromRGB(40, 30, 44))
		end
	end
	for _, at in scatter(rng, start, 12, 18, 40) do
		local stone = P(f, "Gravestone", Vector3.new(3, 4, 1), CFrame.new(at + Vector3.new(0, 2, 0)) * CFrame.Angles(0, rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.1, 0.1)), Color3.fromRGB(110, 104, 130))
		Style.Studs(stone)
		P(f, "GraveTop", Vector3.new(1, 3, 3), stone.CFrame * CFrame.new(0, 2, 0) * CFrame.Angles(0, math.pi / 2, math.pi / 2), Color3.fromRGB(110, 104, 130), nil, Enum.PartType.Cylinder)
	end
	for _, s in { -1, 1 } do
		local at = Vector3.new(s * 58, 0, start + 70)
		for n = 0, 15 do
			local angle = n * math.pi * 2 / 16
			P(f, "PortalRing", Vector3.new(2, 2, 2), CFrame.new(at + Vector3.new(0, 10 + math.sin(angle) * 8, math.cos(angle) * 8)), if n % 2 == 0 then glow else obsidian, Enum.Material.Neon)
		end
		local disc = P(f, "PortalVoid", Vector3.new(0.4, 15, 15), CFrame.new(at + Vector3.new(0, 10, 0)), Color3.fromRGB(120, 40, 220), Enum.Material.ForceField, Enum.PartType.Cylinder)
		disc.CanCollide = false
		Style.Light(disc, glow, 3, 30)
		Style.Particles(disc, "Swirl", {
			Color = ColorSequence.new(glow, Color3.fromRGB(70, 230, 255)), Rate = 20, Speed = NumberRange.new(2, 5),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) }), SpreadAngle = Vector2.new(180, 180),
		})
	end
	for n = 1, 10 do
		local side = if n % 2 == 0 then 1 else -1
		local orb = P(f, "FloatingOrb", Vector3.new(2, 2, 2), CFrame.new(side * rng:NextNumber(20, 66), rng:NextNumber(10, 26), start + rng:NextNumber(10, 170)), if n % 3 == 0 then Color3.fromRGB(70, 230, 255) else glow, Enum.Material.Neon, Enum.PartType.Ball)
		noCollide(orb)
		Style.Light(orb, orb.Color, 1.5, 18)
	end
end

local DECOR = { forest, desert, ice, lava, toxic, shadow }

-- One big ForgeGUI-generated landmark per zone, across the path from the nest, facing the path.
local function buildLandmark(f: Instance, index: number)
	local info = Config.Zones[index].Landmark
	if info.AssetId == 0 then
		return
	end
	local ok, asset = pcall(function()
		return game:GetService("InsertService"):LoadAsset(info.AssetId)
	end)
	local mesh = ok and asset:FindFirstChildWhichIsA("MeshPart", true)
	if not mesh then
		warn(string.format("[MonsterEgg] Landmark %d for %s could not load: %s", info.AssetId, Config.Zones[index].Name, tostring(asset)))
		return
	end
	mesh.Name = "Landmark"
	mesh.Size *= info.Height / mesh.Size.Y
	mesh.Anchored = true
	mesh.CanCollide = true
	local position = Vector3.new(info.Spot.X, mesh.Size.Y / 2, Config.ZoneStart(index) + info.Spot.Y)
	mesh.CFrame = CFrame.lookAt(position, Vector3.new(0, position.Y, position.Z - 25))
	mesh.Parent = f
	asset:Destroy()
end

-- Ambient particles per zone: falling leaves, drifting sand, snow, rising embers, bubbles, motes.
local AMBIENT = {
	{ Falling = true, Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = Color3.fromRGB(140, 230, 90), Rate = 18, Speed = NumberRange.new(2, 4), Size = 0.6 },
	{ Falling = true, Texture = "rbxasset://textures/particles/smoke_main.dds", Color = Color3.fromRGB(245, 215, 150), Rate = 10, Speed = NumberRange.new(3, 6), Size = 5 },
	{ Falling = true, Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = Color3.fromRGB(255, 255, 255), Rate = 60, Speed = NumberRange.new(3, 5), Size = 0.5 },
	{ Falling = false, Texture = "rbxasset://textures/particles/fire_sparks_main.dds", Color = Color3.fromRGB(255, 150, 50), Rate = 30, Speed = NumberRange.new(3, 7), Size = 0.5 },
	{ Falling = false, Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = Color3.fromRGB(150, 255, 60), Rate = 16, Speed = NumberRange.new(2, 4), Size = 0.8 },
	{ Falling = false, Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = Color3.fromRGB(190, 110, 255), Rate = 22, Speed = NumberRange.new(0.5, 1.5), Size = 0.7 },
}

local function wallDetail(f: Instance, index: number, side: number, z: number, n: number)
	local x = side * (Config.HalfWidth - 0.6)
	local inward = -side
	local zone = Config.Zones[index]
	if index == 1 then
		for k = 0, 2 do
			local length = 18 + (k * 7 + n * 5) % 20
			local vineX = x + inward * 0.3
			noCollide(P(f, "Vine", Vector3.new(0.4, length, 0.8), CFrame.new(vineX, Config.WallHeight - length / 2, z + (k - 1) * 3), Color3.fromRGB(60, 150, 60)))
			for leaf = 1, 3 do
				noCollide(Style.Studs(P(f, "VineLeaf", Vector3.new(1.4, 1.2, 1.6), CFrame.new(vineX + inward * 0.5, Config.WallHeight - length * leaf / 3.2, z + (k - 1) * 3 + 0.6), Color3.fromRGB(100, 210, 80))))
			end
		end
	elseif index == 2 then
		local panel = P(f, "Hieroglyphs", Vector3.new(0.6, 12, 9), CFrame.new(x, 12, z), Color3.fromRGB(200, 150, 90))
		Style.Studs(panel, true)
		for k = 0, 5 do
			noCollide(P(f, "Glyph", Vector3.new(0.3, 1.4, 1.4), CFrame.new(x + inward * 0.4, 8 + (k % 3) * 3, z - 2.2 + math.floor(k / 3) * 4.4) * CFrame.Angles((k % 2) * 0.785, 0, 0), Color3.fromRGB(110, 70, 40)))
		end
		noCollide(P(f, "GlyphEye", Vector3.new(0.3, 1.6, 3.2), CFrame.new(x + inward * 0.45, 16.4, z), Color3.fromRGB(40, 140, 170), Enum.Material.Neon))
	elseif index == 3 then
		for k = 0, 4 do
			local length = 3 + (k * 3 + n) % 6
			local icicle = noCollide(Style.Wedge(f, "Icicle", Vector3.new(1.2, length, 1.2), CFrame.new(x + inward * 0.6, Config.WallHeight - length / 2, z - 4 + k * 2) * CFrame.Angles(math.pi, 0, 0), Color3.fromRGB(190, 240, 255), Enum.Material.Glass))
			icicle.Transparency = 0.2
		end
		local frost = noCollide(P(f, "Frost", Vector3.new(0.3, 9, 12), CFrame.new(x + inward * 0.1, 6, z), Color3.fromRGB(235, 250, 255), Enum.Material.Snow))
		frost.Transparency = 0.1
	elseif index == 4 then
		if n % 2 == 0 then
			local fall = noCollide(P(f, "Lavafall", Vector3.new(0.5, Config.WallHeight, 4), CFrame.new(x + inward * 0.2, Config.WallHeight / 2, z), zone.Color, Enum.Material.Neon))
			fall.Transparency = 0.05
			local pool = noCollide(Style.Cylinder(f, "LavaPool", 0.4, 8, CFrame.new(x + inward * 4, 0.2, z), zone.Accent, Enum.Material.Neon))
			Style.Particles(pool, "Steam", {
				Texture = "rbxasset://textures/particles/fire_main.dds", Color = ColorSequence.new(zone.Accent, zone.Color),
				Rate = 10, Speed = NumberRange.new(2, 4), EmissionDirection = Enum.NormalId.Right, LightEmission = 1,
				Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 0) }),
			})
			Style.Light(pool, zone.Color, 2, 18)
		else
			Style.Studs(P(f, "Brazier", Vector3.new(2.4, 4, 2.4), CFrame.new(x + inward * 2, 2, z), Color3.fromRGB(60, 40, 44)))
		end
	elseif index == 5 then
		for k = 0, 4 do
			noCollide(P(f, "HazardStripe", Vector3.new(0.4, 6, 1.6), CFrame.new(x + inward * 0.3, 9, z - 3.2 + k * 1.6) * CFrame.Angles(0.5, 0, 0), if k % 2 == 0 then Color3.fromRGB(252, 204, 40) else Color3.fromRGB(30, 30, 36)))
		end
		local valve = P(f, "Valve", Vector3.new(1.2, 3, 3), CFrame.new(x + inward * 0.8, 15, z), Color3.fromRGB(200, 40, 40))
		valve.Shape = Enum.PartType.Cylinder
		local glow = noCollide(P(f, "PipeLight", Vector3.new(0.4, 0.8, 6), CFrame.new(x + inward * 0.3, 18, z), Color3.fromRGB(110, 240, 40), Enum.Material.Neon))
		Style.Light(glow, Color3.fromRGB(110, 240, 40), 1, 12)
	else
		for k = 0, 2 do
			noCollide(P(f, "WallCrystal", Vector3.new(1.4, 5 - k, 1.4), CFrame.new(x + inward * 0.9, 14 + k * 2, z + (k - 1) * 2) * CFrame.Angles(0.4 * (k - 1), 0, side * 0.6), zone.Color, Enum.Material.Neon))
		end
		Style.Studs(P(f, "Torch", Vector3.new(0.8, 4, 0.8), CFrame.new(x + inward * 1, 7, z + 5), Color3.fromRGB(40, 30, 44)))
		local flame = noCollide(P(f, "TorchFlame", Vector3.new(1, 1, 1), CFrame.new(x + inward * 1, 9.4, z + 5), zone.Accent, Enum.Material.Neon))
		Style.Particles(flame, "Fire", {
			Texture = "rbxasset://textures/particles/fire_main.dds", Color = ColorSequence.new(zone.Accent, zone.Color),
			Rate = 12, Speed = NumberRange.new(1, 2), Acceleration = Vector3.new(0, 4, 0), LightEmission = 1,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) }),
		})
		Style.Light(flame, zone.Accent, 1.5, 14)
	end
end

local function zoneDetails(f: Instance, index: number, start: number)
	local zone = Config.Zones[index]
	local mid = start + Config.ZoneLength / 2
	for _, x in { -11.4, 11.4 } do
		Style.Studs(P(f, "PathEdge", Vector3.new(0.8, 0.5, Config.ZoneLength), CFrame.new(x, 0.25, mid), Style.Lighten(zone.Trim, 0.15)))
	end
	for _, side in { -1, 1 } do
		for n = 0, 5 do
			wallDetail(f, index, side, start + 18 + n * 29 + (if side &gt; 0 then 12 else 0), n)
		end
	end
	local ambient = AMBIENT[index]
	local sheet = noCollide(P(f, "Ambient", Vector3.new(Config.HalfWidth * 2 - 6, 1, Config.ZoneLength - 6), CFrame.new(0, if ambient.Falling then 46 else 0.5, mid), Color3.new(1, 1, 1)))
	sheet.Transparency = 1
	Style.Particles(sheet, "Ambient", {
		Texture = ambient.Texture,
		Color = ColorSequence.new(ambient.Color),
		Rate = ambient.Rate,
		Speed = ambient.Speed,
		EmissionDirection = if ambient.Falling then Enum.NormalId.Bottom else Enum.NormalId.Top,
		Lifetime = NumberRange.new(if ambient.Falling then 10 else 3, if ambient.Falling then 14 else 6),
		SpreadAngle = Vector2.new(20, 20),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, ambient.Size), NumberSequenceKeypoint.new(1, ambient.Size * 0.6) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(0.8, 0.4), NumberSequenceKeypoint.new(1, 1) }),
		LightEmission = if index &gt;= 4 then 1 else 0.3,
		RotSpeed = NumberRange.new(-60, 60),
	})
end

local function buildNest(f: Instance, index: number)
	local zone = Config.Zones[index]
	local center = Config.NestCenter(index)
	local nest = folder(f, "Nest")
	local straw = Style.Cylinder(nest, "Straw", 0.7, 20, CFrame.new(center + Vector3.new(0, 0.35, 0)), Color3.fromRGB(226, 192, 110))
	Style.Studs(straw)
	for n = 0, 17 do
		local angle = n * math.pi * 2 / 18
		local twig = P(nest, "Twig", Vector3.new(3.6, 1.6, 1.2), CFrame.new(center + Vector3.new(math.cos(angle) * 10, 1, math.sin(angle) * 10)) * CFrame.Angles(0, -angle + math.pi / 2, (n % 2) * 0.25), if n % 2 == 0 then Color3.fromRGB(140, 92, 50) else Color3.fromRGB(170, 116, 64))
		Style.Studs(twig)
	end
	local glowRing = Style.Cylinder(nest, "NestGlow", 0.2, 23, CFrame.new(center + Vector3.new(0, 0.1, 0)), zone.Color, Enum.Material.Neon)
	glowRing.Transparency = 0.4
	noCollide(glowRing)
	for slot = 1, Config.NestSlots do
		local at = Config.NestSlot(index, slot)
		local pedestal = Style.Cylinder(nest, "Pedestal", 0.8, 4, CFrame.new(at.X, 0.9, at.Z), zone.Accent)
		Style.Studs(pedestal)
	end
	local home = Config.GuardianHome(index)
	local bed = P(nest, "GuardianBed", Vector3.new(18, 0.5, 22), home * CFrame.new(0, 0.25, 0), Style.Darken(zone.Color, 0.35))
	Style.Studs(bed)
	noCollide(bed)
end

local function buildZone(root: Instance, index: number)
	local zone = Config.Zones[index]
	local start = Config.ZoneStart(index)
	local mid = Config.ZoneCenter(index)
	local f = folder(root, zone.Name)
	f:SetAttribute("Zone", index)

	local ground = P(f, "Ground", Vector3.new(Config.HalfWidth * 2 + 6, 4, Config.ZoneLength), CFrame.new(0, -2, mid), zone.Ground)
	Style.Checker(ground, 8, { Enum.NormalId.Top }, 0.86)
	local path = P(f, "Path", Vector3.new(22, 0.2, Config.ZoneLength), CFrame.new(0, 0.1, mid), Style.Lighten(zone.Ground, 0.3))
	Style.Checker(path, 5.5, { Enum.NormalId.Top }, 0.88)

	for _, x in { -1, 1 } do
		local wall = P(f, "Wall", Vector3.new(6, Config.WallHeight, Config.ZoneLength), CFrame.new(x * (Config.HalfWidth + 3), Config.WallHeight / 2, mid), zone.Wall)
		Style.Checker(wall, 8, nil, 0.8)
		local trim = P(f, "WallTrim", Vector3.new(8, 3, Config.ZoneLength), CFrame.new(x * (Config.HalfWidth + 3), Config.WallHeight + 1.5, mid), zone.Trim)
		Style.Studs(trim)
		P(f, "Glow", Vector3.new(0.4, 0.8, Config.ZoneLength), CFrame.new(x * (Config.HalfWidth - 0.1), 3, mid), zone.Color, Enum.Material.Neon)
		local plaque = P(f, "Plaque", Vector3.new(0.8, 12, 44), CFrame.new(x * (Config.HalfWidth - 0.4), 24, mid), Style.Darken(zone.Color, 0.55))
		Style.Studs(plaque, true)
		Style.Sign(plaque, zone.Name:upper(), nil, Style.Lighten(zone.Color, 0.2), if x &lt; 0 then Enum.NormalId.Right else Enum.NormalId.Left, 10)
	end

	-- Entry arch (the first zone shares the safe zone gate).
	for _, x in (if index == 1 then {} else { -30, 30 }) do
		local pillar = P(f, "ArchPillar", Vector3.new(6, 34, 6), CFrame.new(x, 17, start), zone.Wall)
		Style.Studs(pillar, true)
		P(f, "ArchCap", Vector3.new(7, 2, 7), CFrame.new(x, 35, start), zone.Color, Enum.Material.Neon)
	end
	local beam = P(f, "ArchBeam", Vector3.new(66, 9, 5), CFrame.new(0, if index == 1 then 46 else 39, start), Style.Darken(zone.Color, 0.55))
	Style.Studs(beam)
	local subtitle = string.format("Guardian: %s  •  Eggs from $%s/s", zone.Monster, Config.Format(zone.Income))
	Style.Sign(beam, zone.Name:upper() .. " ZONE", subtitle, Style.Lighten(zone.Color, 0.15), Enum.NormalId.Front, 14)
	Style.Sign(beam, "SAFE ZONE ←", "Bank your egg behind you!", Color3.fromRGB(180, 255, 220), Enum.NormalId.Back, 14)

	local nest = Config.NestCenter(index)
	local home = Config.GuardianHome(index).Position
	local landmark = Config.Zones[index].Landmark
	keepClear = {
		Vector3.new(nest.X, nest.Z, 18),
		Vector3.new(home.X, home.Z, 16),
		Vector3.new(landmark.Spot.X, start + landmark.Spot.Y, landmark.Height * 0.7),
	}
	local decor = folder(f, "Decor")
	DECOR[index](decor, Random.new(index * 97), start)
	keepClear = {}
	zoneDetails(decor, index, start)
	buildLandmark(decor, index)
	buildNest(f, index)
	task.wait()
	return f
end

local function setupLighting()
	Lighting.ClockTime = 14.2
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(110, 110, 130)
	Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 170)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.GlobalShadows = true
	local function effect(class: string, name: string): Instance
		local existing = Lighting:FindFirstChild(name)
		if existing then
			existing:Destroy()
		end
		local e = Instance.new(class)
		e.Name = name
		e.Parent = Lighting
		return e
	end
	local cc = effect("ColorCorrectionEffect", "EggColor") :: ColorCorrectionEffect
	cc.Saturation = 0.18
	cc.Contrast = 0.06
	cc.Brightness = 0.02
	local bloom = effect("BloomEffect", "EggBloom") :: BloomEffect
	bloom.Intensity = 0.25
	bloom.Size = 20
	bloom.Threshold = 1.5
	local rays = effect("SunRaysEffect", "EggSunRays") :: SunRaysEffect
	rays.Intensity = 0.06
	rays.Spread = 0.6
	local atmosphere = effect("Atmosphere", "EggAtmosphere") :: Atmosphere
	atmosphere.Density = 0.22
	atmosphere.Offset = 0.1
	atmosphere.Haze = 0.8
	atmosphere.Glare = 0.2
	atmosphere.Color = Color3.fromRGB(200, 230, 255)
	atmosphere.Decay = Color3.fromRGB(120, 140, 200)
end

function W.Build(): Folder
	local existing = workspace:FindFirstChild(W.RootName)
	if existing then
		return existing :: Folder
	end
	local root = Instance.new("Folder")
	root.Name = W.RootName
	-- Hide the template baseplate/spawn so they don't fight with the map.
	for _, child in workspace:GetChildren() do
		if child.Name == "Baseplate" and child:IsA("BasePart") then
			child.Transparency = 1
			child.CanCollide = false
			child.CanQuery = false
			for _, d in child:GetChildren() do
				if d:IsA("Texture") then
					d.Transparency = 1
				end
			end
		elseif child:IsA("SpawnLocation") then
			child.Enabled = false
			child.Transparency = 1
			child.CanCollide = false
			for _, d in child:GetChildren() do
				if d:IsA("Decal") then
					d.Transparency = 1
				end
			end
		end
	end
	buildSanctuary(root)
	root.Parent = workspace
	local zones = folder(root, "Zones")
	for index = 1, #Config.Zones do
		buildZone(zones, index)
	end
	local endWall = P(root, "EndWall", Vector3.new(Config.HalfWidth * 2 + 12, Config.WallHeight, 6), CFrame.new(0, Config.WallHeight / 2, Config.ZoneStart(#Config.Zones + 1) + 3), Config.Zones[#Config.Zones].Wall)
	Style.Checker(endWall, 8, nil, 0.8)
	setupLighting()
	return root
end

-- Edit-time preview: sleeping guardians and nest eggs so the place looks complete in Studio.
function W.Preview(root: Instance)
	local old = root:FindFirstChild("Preview")
	if old then
		old:Destroy()
	end
	local preview = folder(root, "Preview")
	local rng = Random.new(7)
	for index = 1, #Config.Zones do
		local home = Config.GuardianHome(index)
		local guardian = Monsters.Build(index, home, preview)
		guardian:PivotTo(Monsters.SleepCFrame(guardian, home))
		Monsters.Animate(Monsters.Collect(guardian), 0, 1, 0, 0)
		for slot = 1, Config.NestSlots do
			local rarity = Config.RollRarity(index, rng)
			Eggs.Build(index, rarity, CFrame.new(Config.NestSlot(index, slot)), { Parent = preview, Label = Eggs.LabelText(index, rarity) })
		end
		task.wait()
	end
	return preview
end

return W
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script">
      <Properties>
        <string name="Name">MonsterEggServer</string>
        <ProtectedString name="Source">-- MONSTER EGG ESCAPE server: eggs, theft, banking, personal bases and treadmills, upgrades, trails and saving.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("MonsterEgg")
local Config = require(Shared.Config)
local Style = require(Shared.Style)
local Eggs = require(Shared.Eggs)
local World = require(Shared.World)
local Data = require(script.Data)
local Guardian = require(script.Guardians)

local world = World.Build()
local preview = world:FindFirstChild("Preview")
if preview then
	preview:Destroy()
end
local sanctuary = world:WaitForChild("Sanctuary")

local function folder(parent: Instance, name: string): Folder
	local f = parent:FindFirstChild(name) or Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f :: Folder
end

local runtime = folder(world, "Runtime")
local monsterFolder = folder(runtime, "Monsters")
local nestFolder = folder(runtime, "NestEggs")
local carriedFolder = folder(runtime, "CarriedEggs")

local remotes = folder(Shared, "Remotes")
local function remote(class: string, name: string)
	local r = remotes:FindFirstChild(name) or Instance.new(class)
	r.Name = name
	r.Parent = remotes
	return r
end
local NoticeEvent = remote("RemoteEvent", "Notice") :: RemoteEvent
local EffectEvent = remote("RemoteEvent", "Effect") :: RemoteEvent
local ShopFunction = remote("RemoteFunction", "Shop") :: RemoteFunction

type Carried = { Zone: number, Rarity: number, Model: Model, Since: number }

local profiles: { [Player]: Data.Profile } = {}
local carried: { [Player]: Carried } = {}
local bases: { [Player]: Model } = {}
local guardians = {}
local rng = Random.new()
local refreshBaseProps: (Player) -&gt; ()
local clearBaseProps: (Model) -&gt; ()

-- Helpers ----------------------------------------------------------------------

local function notice(player: Player, text: string, kind: string?)
	NoticeEvent:FireClient(player, text, kind or "info")
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health &lt;= 0 then
		return nil
	end
	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function near(player: Player, position: Vector3, range: number): boolean
	local root = rootOf(player)
	return root ~= nil and (root.Position - position).Magnitude &lt;= range
end

local function incomeOf(profile: Data.Profile): number
	local total = 0
	for _, egg in profile.Eggs do
		total += Config.EggIncome(egg.Z, egg.R)
	end
	return total
end

local function ownsTrail(profile: Data.Profile, index: number): boolean
	return table.find(profile.Trails, index) ~= nil
end

local function sync(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	player:SetAttribute("Cash", profile.Cash)
	player:SetAttribute("Income", incomeOf(profile))
	player:SetAttribute("SpeedLevel", profile.SpeedLevel)
	player:SetAttribute("Training", profile.Training)
	player:SetAttribute("Capacity", profile.Capacity)
	player:SetAttribute("EggCount", #profile.Eggs)
	player:SetAttribute("TreadLevel", profile.TreadLevel)
	player:SetAttribute("Trail", profile.Trail)
	player:SetAttribute("OwnedTrails", table.concat(profile.Trails, ","))
	player:SetAttribute("NextReward", profile.LastReward + Config.RewardCooldown)
	local walk = Config.WalkSpeed(profile.SpeedLevel, profile.Training, profile.Trail, profile.TreadLevel, profile.BonusSpeed)
	player:SetAttribute("WalkSpeed", walk)
	player:SetAttribute("BonusSpeed", profile.BonusSpeed)
	local stats = player:FindFirstChild("leaderstats")
	if stats then
		local cashValue = stats:FindFirstChild("Cash") :: IntValue
		local eggsValue = stats:FindFirstChild("Eggs") :: IntValue
		cashValue.Value = math.floor(profile.Cash)
		eggsValue.Value = #profile.Eggs
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = if player:GetAttribute("SlowMode") then Config.BaseWalkSpeed else walk
	end
	refreshBaseProps(player)
end

local function applyTrail(player: Player)
	local profile = profiles[player]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not profile or not root then
		return
	end
	for _, child in root:GetChildren() do
		if child.Name == "EggTrail" then
			child:Destroy()
		end
	end
	if profile.Trail == 0 then
		return
	end
	local info = Config.Trails[profile.Trail]
	local top = Instance.new("Attachment")
	top.Name = "EggTrail"
	top.Position = Vector3.new(0, 0.9, 0.4)
	top.Parent = root
	local bottom = Instance.new("Attachment")
	bottom.Name = "EggTrail"
	bottom.Position = Vector3.new(0, -1.8, 0.4)
	bottom.Parent = root
	local trail = Instance.new("Trail")
	trail.Name = "EggTrail"
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Lifetime = 0.55
	trail.LightEmission = 0.8
	trail.FaceCamera = true
	trail.Color = ColorSequence.new(info.Colors[1], info.Colors[2])
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.2) })
	trail.Parent = root
end

-- Personal bases -----------------------------------------------------------------

local sellEgg: (Player, number) -&gt; ()
local refreshTreadmill: (Model, Player?) -&gt; ()

local function setSign(base: Model, text: string)
	for _, gui in (base:FindFirstChild("OwnerSign") :: BasePart):GetChildren() do
		local label = (gui :: SurfaceGui):FindFirstChild("Owner") :: TextLabel?
		if label then
			label.Text = text
		end
	end
end

local function setIncomeLabel(base: Model, text: string)
	local gui = (base:FindFirstChild("PenFloor") :: BasePart):FindFirstChild("Income") :: BillboardGui
	local label = gui:FindFirstChild("Text") :: TextLabel
	label.Text = text
end

local function redrawBase(player: Player)
	local base, profile = bases[player], profiles[player]
	if not base or not profile then
		return
	end
	local index = base:GetAttribute("Index") :: number
	local old = base:FindFirstChild("Eggs")
	if old then
		old:Destroy()
	end
	local eggsFolder = Instance.new("Folder")
	eggsFolder.Name = "Eggs"
	for slot, egg in profile.Eggs do
		local model = Eggs.Build(egg.Z, egg.R, CFrame.new(World.SlotPosition(index, slot)) * CFrame.Angles(0, rng:NextNumber(-0.4, 0.4), 0), {
			Scale = 0.75,
			Light = false, -- many lit eggs side by side overexpose the pen
			Parent = eggsFolder,
		})
		model:SetAttribute("Slot", slot)
		local earning = Style.Label(model.PrimaryPart :: BasePart, "+$" .. Config.Format(Config.EggIncome(egg.Z, egg.R)) .. "/s", Color3.fromRGB(120, 255, 90), 4, 1.1, 2.4)
		earning.Name = "Earning"
		earning.MaxDistance = 60
		local prompt = Style.Prompt(model.PrimaryPart :: BasePart, "Sell $" .. Config.Format(Config.EggIncome(egg.Z, egg.R) * Config.SellSeconds), Eggs.Title(egg.Z, egg.R), 0.8, 7)
		prompt.Name = "SellPrompt"
		prompt.Enabled = false -- the owner's client enables its own sell prompts
		prompt.Triggered:Connect(function(who)
			if who == player then
				sellEgg(player, slot)
			end
		end)
	end
	eggsFolder.Parent = base
	setIncomeLabel(base, string.format("$%s/s  •  %d/%d eggs", Config.Format(incomeOf(profile)), #profile.Eggs, profile.Capacity))
end

local function assignBase(player: Player): Model?
	for index = 1, Config.MaxPlayers do
		local base = sanctuary.Bases:FindFirstChild("Base" .. index) :: Model
		if (base:GetAttribute("Owner") or 0) == 0 then
			base:SetAttribute("Owner", player.UserId)
			setSign(base, string.upper(player.DisplayName) .. "'S BASE")
			bases[player] = base
			player:SetAttribute("Base", index)
			return base
		end
	end
	return nil
end

local function releaseBase(player: Player)
	local base = bases[player]
	if not base then
		return
	end
	base:SetAttribute("Owner", 0)
	setSign(base, "FREE BASE")
	local eggsFolder = base:FindFirstChild("Eggs")
	if eggsFolder then
		eggsFolder:Destroy()
	end
	setIncomeLabel(base, "Free base")
	bases[player] = nil
	refreshTreadmill(base, nil)
	clearBaseProps(base)
end

sellEgg = function(player: Player, slot: number)
	local profile = profiles[player]
	local base = bases[player]
	local egg = profile and profile.Eggs[slot]
	if not egg or not base or not near(player, World.SlotPosition(base:GetAttribute("Index") :: number, slot), 12) then
		return
	end
	local value = Config.EggIncome(egg.Z, egg.R) * Config.SellSeconds
	table.remove(profile.Eggs, slot)
	profile.Cash += value
	redrawBase(player)
	sync(player)
	notice(player, string.format("Sold %s for $%s", Eggs.Title(egg.Z, egg.R), Config.Format(value)), "good")
	EffectEvent:FireClient(player, "Cash", value)
end

-- Carrying, stealing and banking ---------------------------------------------------

local function dropEgg(player: Player)
	local item = carried[player]
	if not item then
		return
	end
	carried[player] = nil
	item.Model:Destroy()
	player:SetAttribute("Carrying", "")
	player:SetAttribute("CarryRarity", 0)
	player:SetAttribute("Chaser", "")
	player:SetAttribute("Rage", 0)
end

local attachEgg: (Player, number, number) -&gt; boolean

local function steal(thief: Player, victim: Player, model: Model)
	local item = carried[victim]
	local thiefRoot, victimRoot = rootOf(thief), rootOf(victim)
	if thief == victim or not item or item.Model ~= model or not thiefRoot or not victimRoot then
		return
	end
	if carried[thief] or not profiles[thief] then
		return
	end
	if victimRoot.Position.Z &lt;= Config.SafeZ or thiefRoot.Position.Z &lt;= Config.SafeZ then
		notice(thief, "Eggs can't be stolen inside the safe zone!", "bad")
		return
	end
	if os.clock() - item.Since &lt; Config.StealProtection then
		notice(thief, "That egg was just grabbed — try again!", "bad")
		return
	end
	if (thiefRoot.Position - victimRoot.Position).Magnitude &gt; Config.StealRange then
		return
	end
	if #profiles[thief].Eggs &gt;= profiles[thief].Capacity then
		notice(thief, "Your base is full! Upgrade storage or sell eggs.", "bad")
		return
	end
	local zone, rarity = item.Zone, item.Rarity
	dropEgg(victim)
	if attachEgg(thief, zone, rarity) then
		profiles[thief].Stats.Stolen += 1
		notice(victim, thief.DisplayName .. " stole your " .. Eggs.Title(zone, rarity) .. "!", "bad")
		notice(thief, "STOLEN! Run to the safe zone!", "rare")
		EffectEvent:FireClient(victim, "Stolen")
		EffectEvent:FireClient(thief, "Pickup", rarity)
	end
end

attachEgg = function(player: Player, zone: number, rarity: number): boolean
	local profile = profiles[player]
	local root = rootOf(player)
	if not profile or not root or carried[player] then
		return false
	end
	if #profile.Eggs &gt;= profile.Capacity then
		notice(player, "Your base is full! Upgrade storage or sell eggs.", "bad")
		return false
	end
	local offset = CFrame.new(0, 4, 0)
	local model = Eggs.Build(zone, rarity, root.CFrame * offset, {
		Scale = 0.7,
		Anchored = false,
		Light = false, -- a light this close to the camera washes out the screen
		Label = Config.Rarities[rarity].Name,
	})
	model:SetAttribute("Carrier", player.UserId)
	local core = model.PrimaryPart :: BasePart
	local weld = Instance.new("Weld")
	weld.Part0 = root
	weld.Part1 = core
	weld.C0 = offset
	weld.Parent = core
	local prompt = Style.Prompt(core, "Steal Egg", player.DisplayName .. "'s " .. Config.Rarities[rarity].Name, 0.5, 10)
	prompt.Name = "StealPrompt"
	prompt.Triggered:Connect(function(thief)
		steal(thief, player, model)
	end)
	model.Parent = carriedFolder
	carried[player] = { Zone = zone, Rarity = rarity, Model = model, Since = os.clock() }
	player:SetAttribute("Carrying", Eggs.Title(zone, rarity))
	player:SetAttribute("CarryRarity", rarity)
	player:SetAttribute("CarryZone", zone)
	return true
end

local function bank(player: Player)
	local item = carried[player]
	local profile = profiles[player]
	if not item or not profile then
		return
	end
	if #profile.Eggs &gt;= profile.Capacity then
		return
	end
	table.insert(profile.Eggs, { Z = item.Zone, R = item.Rarity })
	profile.Stats.Banked += 1
	local bonus = Config.EggIncome(item.Zone, item.Rarity) * Config.BankBonusSeconds
	profile.Cash += bonus
	local title = Eggs.Title(item.Zone, item.Rarity)
	local rarity = item.Rarity
	dropEgg(player)
	redrawBase(player)
	sync(player)
	notice(player, string.format("SAFE! %s banked  +$%s", title, Config.Format(bonus)), if rarity &gt;= 5 then "rare" else "good")
	EffectEvent:FireClient(player, "Banked", rarity, bonus)
end

local function caught(player: Player, guardian)
	local item = carried[player]
	if not item then
		return
	end
	local profile = profiles[player]
	if profile then
		profile.Stats.Caught += 1
	end
	local from = guardian.Root.Position
	dropEgg(player)
	notice(player, Config.Zones[guardian.Zone].Monster .. " caught you! The egg is lost — train speed and try again.", "bad")
	EffectEvent:FireClient(player, "Caught", from)
end

-- Nest eggs --------------------------------------------------------------------------

local function spawnNestEgg(zone: number, slot: number)
	local rarity = Config.RollRarity(zone, rng)
	local model = Eggs.Build(zone, rarity, CFrame.new(Config.NestSlot(zone, slot)), {
		Label = Eggs.LabelText(zone, rarity),
		Parent = nestFolder,
	})
	model.Name = string.format("%s_%d", Config.Zones[zone].Name, slot)
	local prompt = Style.Prompt(model.PrimaryPart :: BasePart, "Steal Egg", Config.Rarities[rarity].Name .. " • " .. Config.Zones[zone].Monster .. "'s nest", 0.4, 10)
	prompt.Name = "TakePrompt"
	local taken = false
	prompt.Triggered:Connect(function(player)
		if taken or carried[player] or not near(player, (model.PrimaryPart :: BasePart).Position, 13) then
			return
		end
		if attachEgg(player, zone, rarity) then
			taken = true
			model:Destroy()
			notice(player, if rarity &gt;= Config.RageRarity then "RARE EGG! The guardian is FURIOUS — RUN!" else "Egg grabbed! Run back to the safe zone!", if rarity &gt;= Config.RageRarity then "rare" else "info")
			EffectEvent:FireClient(player, "Pickup", rarity)
			task.delay(Config.NestRespawn, spawnNestEgg, zone, slot)
		end
	end)
end

-- Purchases --------------------------------------------------------------------------

local function spend(player: Player, profile: Data.Profile, cost: number): boolean
	if profile.Cash &lt; cost then
		notice(player, "You need $" .. Config.Format(cost - profile.Cash) .. " more!", "bad")
		return false
	end
	profile.Cash -= cost
	EffectEvent:FireClient(player, "Purchase")
	return true
end

local purchases = {}

function purchases.Speed(player: Player, profile: Data.Profile)
	if profile.SpeedLevel &gt;= Config.MaxSpeedLevel then
		return notice(player, "Speed is maxed out!", "info")
	end
	if spend(player, profile, Config.SpeedCost(profile.SpeedLevel)) then
		profile.SpeedLevel += 1
		notice(player, "Speed upgraded to level " .. profile.SpeedLevel .. "!", "good")
	end
end

function purchases.Storage(player: Player, profile: Data.Profile)
	if profile.Capacity &gt;= Config.MaxCapacity then
		return notice(player, "Storage is maxed out!", "info")
	end
	if spend(player, profile, Config.StorageCost(profile.Capacity)) then
		profile.Capacity += Config.CapacityStep
		redrawBase(player)
		notice(player, "Base expanded to " .. profile.Capacity .. " eggs!", "good")
	end
end

refreshTreadmill = function(base: Model, player: Player?)
	local index = base:GetAttribute("Index") :: number
	local profile = player and profiles[player]
	local level = if profile then profile.TreadLevel else 1
	local model = World.BuildTreadmill(base, index, level)
	local console = model:FindFirstChild("Console") :: BasePart
	local sign = console:FindFirstChild("Sign")
	local info = sign and sign:FindFirstChild("Info") :: TextLabel?
	local bonus = (level - 1) * Config.TreadSpeedPerLevel
	local maxed = level &gt;= Config.MaxTreadLevel
	if info then
		info.Text = if maxed
			then string.format("MAX LEVEL  •  +%.1f speed", bonus)
			else string.format("+%.1f speed  •  next $%s", bonus, Config.Format(Config.TreadCost(level)))
	end
	if player then
		local prompt = Style.Prompt(console, if maxed then "Max level" else "Upgrade $" .. Config.Format(Config.TreadCost(level)), "Treadmill Lv " .. level, 0.4, 16)
		prompt.Name = "UpgradePrompt"
		prompt.Enabled = false -- the owner's client enables its own upgrade prompt
		prompt.Triggered:Connect(function(who)
			local current = profiles[player]
			if who == player and current and bases[player] == base then
				purchases.Treadmill(player, current)
				sync(player)
			end
		end)
	end
end

function purchases.Treadmill(player: Player, profile: Data.Profile)
	if profile.TreadLevel &gt;= Config.MaxTreadLevel then
		return notice(player, "Your treadmill is already max level!", "info")
	end
	if spend(player, profile, Config.TreadCost(profile.TreadLevel)) then
		profile.TreadLevel += 1
		local design = Config.TreadmillDesigns[profile.TreadLevel]
		local base = bases[player]
		if base then
			refreshTreadmill(base, player)
		end
		notice(player, string.format("Treadmill level %d: %s! +%.1f walk speed", profile.TreadLevel, design.Name, Config.TreadSpeedPerLevel), "rare")
		EffectEvent:FireClient(player, "TreadUp", profile.TreadLevel)
	end
end

local function boardPrompt(model: Instance, action: string, callback: (Player, Data.Profile) -&gt; ())
	local face = model:FindFirstChild("Board") :: BasePart
	local prompt = Style.Prompt(face, action, model.Name, 0.25, 12)
	prompt.Triggered:Connect(function(player)
		local profile = profiles[player]
		if profile and near(player, face.Position, 16) then
			callback(player, profile)
			sync(player)
		end
	end)
end

local boards = sanctuary:WaitForChild("Boards")
boardPrompt(boards:WaitForChild("SpeedBoard"), "Buy Speed", purchases.Speed)
boardPrompt(boards:WaitForChild("StorageBoard"), "Buy Storage", purchases.Storage)

local shopPart = sanctuary.TrailShop:WaitForChild("PromptPart") :: BasePart
local shopPrompt = Style.Prompt(shopPart, "Open Shop", "Trail Shop", 0, 12)
shopPrompt.Triggered:Connect(function(player)
	EffectEvent:FireClient(player, "OpenShop")
end)

-- Base props: sell stall (sell every egg), fuse machine and the treadmill upgrade board ----

local function sellAll(player: Player, profile: Data.Profile): (boolean, string)
	if #profile.Eggs == 0 then
		return false, "No eggs to sell"
	end
	local value = 0
	for _, egg in profile.Eggs do
		value += Config.EggIncome(egg.Z, egg.R) * Config.SellSeconds
	end
	local count = #profile.Eggs
	table.clear(profile.Eggs)
	profile.Cash += value
	redrawBase(player)
	sync(player)
	EffectEvent:FireClient(player, "Cash", value)
	local message = string.format("Sold %d eggs for $%s", count, Config.Format(value))
	notice(player, message, "good")
	return true, message
end

-- Lowest rarity (below the top one) that has enough eggs to fuse, and how many eggs the best candidate has.
local function fuseCandidate(profile: Data.Profile): (number?, number)
	local counts = {}
	for _, egg in profile.Eggs do
		counts[egg.R] = (counts[egg.R] or 0) + 1
	end
	local best = 0
	for rarity = 1, #Config.Rarities - 1 do
		local count = counts[rarity] or 0
		if count &gt;= Config.FuseCount then
			return rarity, count
		end
		best = math.max(best, count)
	end
	return nil, best
end

local function fuse(player: Player, profile: Data.Profile): (boolean, string)
	local rarity = fuseCandidate(profile)
	if not rarity then
		return false, "Need " .. Config.FuseCount .. " eggs of the same rarity"
	end
	local zone, removed = 1, 0
	for slot = #profile.Eggs, 1, -1 do
		local egg = profile.Eggs[slot]
		if egg.R == rarity and removed &lt; Config.FuseCount then
			zone = math.max(zone, egg.Z)
			table.remove(profile.Eggs, slot)
			removed += 1
		end
	end
	table.insert(profile.Eggs, { Z = zone, R = rarity + 1 })
	redrawBase(player)
	sync(player)
	local result = Config.Rarities[rarity + 1]
	EffectEvent:FireClient(player, "Fused", rarity + 1)
	local article = if result.Name:match("^[AEIOU]") then "an" else "a"
	local message = string.format("Fused %d %s eggs into %s %s egg!", Config.FuseCount, Config.Rarities[rarity].Name, article, result.Name)
	notice(player, message, "rare")
	return true, message
end

local function setBoard(base: Model, levels: string, cash: string, robux: string)
	local board = base:FindFirstChild("UpgradeBoard")
	local screen = board and board.Board:FindFirstChild("Screen")
	if screen then
		screen.Levels.Text = levels
		screen.CashButton.Label.Text = cash
		screen.RobuxButton.Label.Text = robux
	end
end

refreshBaseProps = function(player: Player)
	local base, profile = bases[player], profiles[player]
	if not base or not profile then
		return
	end
	local level = profile.TreadLevel
	if level &gt;= Config.MaxTreadLevel then
		setBoard(base, "MAX LEVEL " .. level, "MAXED", "MAXED")
	else
		setBoard(base, string.format("Level %d &gt; Level %d", level, level + 1), "$" .. Config.Format(Config.TreadCost(level)), "R$ " .. Config.TreadRobuxPrice(level))
	end
	local treadmill = base:FindFirstChild("Treadmill")
	local step = treadmill and treadmill.Console:FindFirstChild("StepLabel")
	if step then
		step.Text.Text = "+$" .. Config.Format(Config.TreadCash(level, profile.SpeedLevel)) .. "/step"
	end
	local machine = base:FindFirstChild("FuseMachine")
	if machine then
		local rarity, count = fuseCandidate(profile)
		machine.Body.Count.Text.Text = if rarity then "READY!" else string.format("%d/%d", count, Config.FuseCount)
	end
end

clearBaseProps = function(base: Model)
	setBoard(base, "Free base", "-", "-")
	local machine = base:FindFirstChild("FuseMachine")
	if machine then
		machine.Body.Count.Text.Text = "0/" .. Config.FuseCount
	end
end

-- One prompt per base prop; only the owner's client enables its own.
for _, base in sanctuary.Bases:GetChildren() do
	local function ownerOf(): Player?
		for player, owned in bases do
			if owned == base then
				return player
			end
		end
		return nil
	end
	local stall = base:WaitForChild("SellStall").Counter
	local sellPrompt = Style.Prompt(stall, "Sell all eggs", "Sell", 0.5, 10)
	sellPrompt.Name = "SellAllPrompt"
	sellPrompt.Enabled = false
	sellPrompt.Triggered:Connect(function(who)
		local profile = profiles[who]
		if profile and ownerOf() == who then
			sellAll(who, profile)
		end
	end)
	local machine = base:WaitForChild("FuseMachine").Body
	local fusePrompt = Style.Prompt(machine, "Fuse " .. Config.FuseCount .. " eggs", "Fuse Machine", 0.6, 10)
	fusePrompt.Name = "FusePrompt"
	fusePrompt.Enabled = false
	fusePrompt.Triggered:Connect(function(who)
		local profile = profiles[who]
		if profile and ownerOf() == who then
			local _, message = fuse(who, profile)
			notice(who, message, "info")
		end
	end)
	clearBaseProps(base :: Model)
end

local function claimReward(player: Player, profile: Data.Profile): (boolean, string)
	local now = os.time()
	local remaining = profile.LastReward + Config.RewardCooldown - now
	if remaining &gt; 0 then
		return false, string.format("Next gift in %d:%02d", remaining // 60, remaining % 60)
	end
	local amount = Config.RewardCash(incomeOf(profile))
	profile.LastReward = now
	profile.Cash += amount
	EffectEvent:FireClient(player, "Purchase")
	sync(player)
	return true, "+$" .. Config.Format(amount) .. " free gift!"
end

local function upgrade(player: Player, profile: Data.Profile, kind: any): (boolean, string)
	local before = profile.SpeedLevel + profile.Capacity + profile.TreadLevel
	if kind == "Speed" then
		purchases.Speed(player, profile)
	elseif kind == "Storage" then
		purchases.Storage(player, profile)
	elseif kind == "Treadmill" then
		purchases.Treadmill(player, profile)
	else
		return false, "Invalid request"
	end
	sync(player)
	local ok = profile.SpeedLevel + profile.Capacity + profile.TreadLevel ~= before
	return ok, if ok then kind .. " upgraded!" else "Upgrade failed"
end

local function handleShop(player: Player, action: any, index: any): (boolean, string)
	local profile = profiles[player]
	if not profile then
		return false, "Still loading — try again"
	end
	if action == "Claim" then
		return claimReward(player, profile)
	elseif action == "Upgrade" then
		return upgrade(player, profile, index)
	elseif action == "SlowMode" then
		player:SetAttribute("SlowMode", index == true)
		sync(player)
		return true, if index == true then "Slow mode on" else "Slow mode off"
	elseif action == "SellAll" then
		return sellAll(player, profile)
	elseif action == "Fuse" then
		return fuse(player, profile)
	end
	if type(index) ~= "number" or not Config.Trails[index] then
		return false, "Invalid request"
	end
	if action == "Buy" then
		if ownsTrail(profile, index) then
			return false, "Already owned"
		end
		if not spend(player, profile, Config.Trails[index].Cost) then
			return false, "Not enough cash"
		end
		table.insert(profile.Trails, index)
		profile.Trail = index
	elseif action == "Equip" then
		if not ownsTrail(profile, index) then
			return false, "Not owned"
		end
		profile.Trail = if profile.Trail == index then 0 else index
	else
		return false, "Invalid request"
	end
	applyTrail(player)
	sync(player)
	return true, if profile.Trail == index then Config.Trails[index].Name .. " trail equipped!" else "Trail unequipped"
end
ShopFunction.OnServerInvoke = handleShop

-- Robux developer products: trails, cash packs, speed packs and treadmill levels -------------

local function grantProduct(player: Player, profile: Data.Profile, kind: string, index: number): string
	if kind == "Trail" then
		local trail = Config.Trails[index]
		if not ownsTrail(profile, index) then
			table.insert(profile.Trails, index)
		end
		profile.Trail = index
		applyTrail(player)
		return trail.Name .. " trail unlocked!"
	elseif kind == "Cash" then
		local amount = Config.CashPacks[index].Amount
		profile.Cash += amount
		EffectEvent:FireClient(player, "Cash", amount)
		return "+$" .. Config.Format(amount) .. " added!"
	elseif kind == "Speed" then
		local amount = Config.SpeedPacks[index].Amount
		profile.BonusSpeed += amount
		return "+" .. amount .. " speed forever!"
	else
		if profile.TreadLevel &gt;= Config.MaxTreadLevel then
			-- Already maxed (bought twice quickly): pay out the last level's cash price instead.
			profile.Cash += Config.TreadCost(Config.MaxTreadLevel - 1)
			return "Treadmill already maxed — cash added instead"
		end
		profile.TreadLevel += 1
		local base = bases[player]
		if base then
			refreshTreadmill(base, player)
		end
		EffectEvent:FireClient(player, "TreadUp", profile.TreadLevel)
		return "Treadmill upgraded to level " .. profile.TreadLevel .. "!"
	end
end

local function findProduct(productId: number): (string?, number)
	for _, kind in { "Trail", "Cash", "Speed" } do
		local list = if kind == "Trail" then Config.Trails elseif kind == "Cash" then Config.CashPacks else Config.SpeedPacks
		for index in list do
			if Config.ProductFor(kind, index) == productId then
				return kind, index
			end
		end
	end
	if Config.ProductFor("Tread") == productId then
		return "Tread", 0
	end
	return nil, 0
end

MarketplaceService.ProcessReceipt = function(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	local profile = player and profiles[player]
	if not player or not profile then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(profile.Receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local kind, index = findProduct(receipt.ProductId)
	if not kind or receipt.ProductId == 0 then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local message = grantProduct(player, profile, kind, index)
	table.insert(profile.Receipts, receipt.PurchaseId)
	while #profile.Receipts &gt; 50 do
		table.remove(profile.Receipts, 1)
	end
	sync(player)
	EffectEvent:FireClient(player, "Purchase")
	notice(player, message, "rare")
	task.spawn(Data.Save, player, profile, false)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- Players ----------------------------------------------------------------------------

local function onCharacter(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	character:WaitForChild("HumanoidRootPart")
	dropEgg(player)
	sync(player)
	applyTrail(player)
	local base = bases[player]
	if base then
		-- Everyone spawns at their own base, facing the zones.
		local spawnAt = World.SpawnPoint(base:GetAttribute("Index") :: number)
		task.defer(function()
			character:PivotTo(CFrame.lookAt(spawnAt, spawnAt + Vector3.zAxis))
		end)
	end
	humanoid.Died:Connect(function()
		dropEgg(player)
	end)
end

local function onPlayerAdded(player: Player)
	local profile, persistent, kickMessage = Data.Load(player)
	if not profile then
		player:Kick(kickMessage)
		return
	end
	profile.Persistent = persistent
	if player.Parent ~= Players then
		Data.Save(player, profile, true)
		return
	end
	profiles[player] = profile
	local base = assignBase(player)
	if not base then
		Data.Save(player, profile, true)
		profiles[player] = nil
		player:Kick("This server is full. Please join another server.")
		return
	end
	player:SetAttribute("SaveStatus", if persistent then "Progress saved to cloud" else "STUDIO TEST: progress is temporary")
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Parent = stats
	local eggsValue = Instance.new("IntValue")
	eggsValue.Name = "Eggs"
	eggsValue.Parent = stats
	stats.Parent = player

	local offline = Data.OfflineEarnings(profile, incomeOf(profile))
	if offline &gt; 0 then
		profile.Cash += offline
		task.delay(3, notice, player, "Welcome back! Your eggs earned $" .. Config.Format(offline) .. " while you were away.", "good")
	end
	redrawBase(player)
	refreshTreadmill(base, player)
	sync(player)
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	if player.Character then
		task.spawn(onCharacter, player, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	dropEgg(player)
	local profile = profiles[player]
	if profile then
		Data.Save(player, profile, true)
	end
	releaseBase(player)
	profiles[player] = nil
end)

-- World setup ------------------------------------------------------------------------

for zone = 1, #Config.Zones do
	guardians[zone] = Guardian.new(zone, monsterFolder)
	for slot = 1, Config.NestSlots do
		spawnNestEgg(zone, slot)
	end
end

local function onRoar(guardian, raging: boolean)
	EffectEvent:FireAllClients("Roar", guardian.Model, raging)
end

-- Main loop --------------------------------------------------------------------------

local accumulated, ticks = 0, 0
local chaserText: { [Player]: string } = {}

RunService.Heartbeat:Connect(function(dt)
	dt = math.min(dt, 0.1)
	local now = os.clock()

	for player in carried do
		local root = rootOf(player)
		if not root then
			dropEgg(player)
		elseif root.Position.Z &lt;= Config.SafeZ and root.Position.Z &gt; Config.SanctuaryStart and math.abs(root.Position.X) &lt;= Config.HalfWidth then
			bank(player)
		end
	end

	local carriers = {}
	for player, item in carried do
		carriers[player] = { Zone = item.Zone, Rarity = item.Rarity }
	end
	local chased = {}
	for _, guardian in guardians do
		local victim = guardian:Update(dt, now, carriers, rootOf, onRoar)
		if victim then
			caught(victim, guardian)
			carriers[victim] = nil
		elseif guardian.Target and (guardian.State == "Chasing" or guardian.State == "Waking") then
			chased[guardian.Target] = guardian
		end
	end
	for player in profiles do
		local guardian = chased[player]
		local text = if guardian then Config.Zones[guardian.Zone].Monster else ""
		if chaserText[player] ~= text then
			chaserText[player] = text
			player:SetAttribute("Chaser", text)
		end
		local rage = if guardian then guardian.Rage else 0
		if player:GetAttribute("Rage") ~= rage then
			player:SetAttribute("Rage", rage)
		end
	end

	accumulated += dt
	if accumulated &lt; 1 then
		return
	end
	accumulated -= 1
	ticks += 1
	for player, profile in profiles do
		profile.Cash += incomeOf(profile)
		local root = rootOf(player)
		local base = bases[player]
		if root and base and not carried[player] then
			-- Only your own treadmill pays out.
			local offset = World.TreadmillCFrame(base:GetAttribute("Index") :: number):PointToObjectSpace(root.Position)
			if math.abs(offset.X) &lt; 4.6 and math.abs(offset.Z) &lt; 7.8 and offset.Y &lt; 7 and offset.Y &gt; 0 then
				profile.Training = math.min(profile.Training + Config.TreadPower(profile.TreadLevel), Config.TrainingCap * 10)
				local earned = Config.TreadCash(profile.TreadLevel, profile.SpeedLevel)
				profile.Cash += earned
				EffectEvent:FireClient(player, "Treadmill", earned, profile.TreadLevel)
			end
		end
		sync(player)
	end
	if ticks % 60 == 0 then
		for player, profile in profiles do
			task.spawn(function()
				local result = Data.Save(player, profile, false)
				if result == "lost" and player.Parent == Players then
					player:Kick("Your save session moved to another server. Please rejoin to protect your progress.")
				elseif result == "failed" then
					player:SetAttribute("SaveStatus", "Save delayed — retrying")
				elseif profile.Persistent then
					player:SetAttribute("SaveStatus", "Progress saved to cloud")
				end
			end)
		end
	end
end)

game:BindToClose(function()
	local pending = 0
	for player, profile in profiles do
		pending += 1
		task.spawn(function()
			Data.Save(player, profile, true)
			pending -= 1
		end)
	end
	local deadline = os.clock() + 25
	while pending &gt; 0 and os.clock() &lt; deadline do
		task.wait(0.1)
	end
end)

-- Studio-only test seam for tests/StudioSmoke.luau. Never created on live servers.
if RunService:IsStudio() then
	local qa = ServerStorage:FindFirstChild("MonsterEggStudioQA") or Instance.new("BindableFunction")
	qa.Name = "MonsterEggStudioQA"
	qa.Parent = ServerStorage
	qa.OnInvoke = function(action: string, player: Player, arg: any)
		local profile = assert(profiles[player], "Player profile not ready")
		assert(not profile.Persistent, "QA hook refuses cloud-backed profiles")
		if action == "GrantCash" then
			profile.Cash += arg
			sync(player)
			return profile.Cash
		elseif action == "Carry" then
			dropEgg(player)
			return attachEgg(player, arg.Zone, arg.Rarity)
		elseif action == "Steal" then
			local victim = arg :: Player
			local item = carried[victim]
			if item then
				item.Since -= Config.StealProtection
				steal(player, victim, item.Model)
			end
			return carried[player] ~= nil
		elseif action == "Snapshot" then
			return {
				Profile = profile,
				Carrying = carried[player] and { Zone = carried[player].Zone, Rarity = carried[player].Rarity } or nil,
				Base = bases[player],
			}
		elseif action == "Guardian" then
			local g = guardians[arg]
			return { State = g.State, Rage = g.Rage, Position = g.Root.Position, Target = g.Target }
		elseif action == "Purchase" then
			purchases[arg](player, profile)
			sync(player)
			return true
		elseif action == "Sell" then
			sellEgg(player, arg)
			return #profile.Eggs
		elseif action == "UpgradeTreadmill" then
			purchases.Treadmill(player, profile)
			sync(player)
			return profile.TreadLevel
		elseif action == "Shop" then
			return handleShop(player, arg.Action, arg.Index)
		elseif action == "Product" then
			local message = grantProduct(player, profile, arg.Kind, arg.Index)
			sync(player)
			return message
		elseif action == "SetEggs" then
			profile.Eggs = arg
			redrawBase(player)
			sync(player)
			return #profile.Eggs
		end
		error("Unknown QA action " .. tostring(action))
	end
end

print(string.format("[MonsterEgg] Ready: %d zones, %d nests, %d bases", #Config.Zones, #Config.Zones * Config.NestSlots, Config.MaxPlayers))
</ProtectedString>
      </Properties>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Data</string>
          <ProtectedString name="Source">-- Player progress with DataStore session locking. Unpublished Studio sessions fall back to
-- clearly-labelled temporary progress; live servers refuse to play on a failed load.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("MonsterEgg"):WaitForChild("Config"))

local Data = {}

local LOCK_EXPIRY = 180
local session = if game.JobId ~= "" then game.JobId else HttpService:GenerateGUID(false)
local store: DataStore? = nil
local storeError: string? = nil

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		storeError = tostring(result)
		warn("[MonsterEgg] DataStore unavailable: " .. storeError)
	end
end

export type Egg = { Z: number, R: number }
export type Profile = {
	Cash: number,
	SpeedLevel: number,
	Training: number,
	Capacity: number,
	TreadLevel: number,
	Trails: { number },
	Trail: number,
	Eggs: { Egg },
	Stats: { Banked: number, Stolen: number, Caught: number },
	LastSeen: number,
	LastReward: number, -- os.time() of the last free gift claim
	BonusSpeed: number, -- permanent walk speed from Robux speed packs
	Receipts: { string }, -- recent developer product PurchaseIds, so a receipt is never granted twice
	-- Runtime only
	Persistent: boolean?,
	Saving: boolean?,
}

function Data.Default(): Profile
	return {
		Cash = 0,
		SpeedLevel = 0,
		Training = 0,
		Capacity = Config.StartCapacity,
		TreadLevel = 1,
		Trails = {},
		Trail = 0,
		Eggs = {},
		Stats = { Banked = 0, Stolen = 0, Caught = 0 },
		LastSeen = 0,
		LastReward = 0,
		BonusSpeed = 0,
		Receipts = {},
	}
end

-- Fill fields missing from older saves and clamp anything out of range.
local function reconcile(saved: any): Profile
	local profile = Data.Default()
	if type(saved) ~= "table" then
		return profile
	end
	for key, value in saved do
		if key ~= "Lock" and profile[key] ~= nil and type(profile[key]) == type(value) then
			profile[key] = value
		end
	end
	profile.Capacity = math.clamp(profile.Capacity, Config.StartCapacity, Config.MaxCapacity)
	profile.SpeedLevel = math.clamp(profile.SpeedLevel, 0, Config.MaxSpeedLevel)
	profile.TreadLevel = math.clamp(math.floor(profile.TreadLevel), 1, Config.MaxTreadLevel)
	local eggs = {}
	for _, egg in profile.Eggs do
		if type(egg) == "table" and Config.Zones[egg.Z] and Config.Rarities[egg.R] and #eggs &lt; profile.Capacity then
			table.insert(eggs, { Z = egg.Z, R = egg.R })
		end
	end
	profile.Eggs = eggs
	if not Config.Trails[profile.Trail] then
		profile.Trail = 0
	end
	return profile
end

local function payload(profile: Profile)
	return {
		Cash = profile.Cash,
		SpeedLevel = profile.SpeedLevel,
		Training = profile.Training,
		Capacity = profile.Capacity,
		TreadLevel = profile.TreadLevel,
		Trails = table.clone(profile.Trails),
		Trail = profile.Trail,
		Eggs = table.clone(profile.Eggs),
		Stats = table.clone(profile.Stats),
		LastSeen = os.time(),
		LastReward = profile.LastReward,
		BonusSpeed = profile.BonusSpeed,
		Receipts = table.clone(profile.Receipts),
	}
end

-- Returns profile, persistent, kickMessage.
function Data.Load(player: Player): (Profile?, boolean, string?)
	local loaded
	local ok, err = pcall(function()
		assert(store, storeError or "DataStore unavailable")
		loaded = store:UpdateAsync("p" .. player.UserId, function(old)
			if old and old.Lock and old.Lock.Id ~= session and os.time() - old.Lock.Time &lt; LOCK_EXPIRY then
				return nil
			end
			old = old or {}
			old.Lock = { Id = session, Time = os.time() }
			return old
		end)
	end)
	if not ok then
		if RunService:IsStudio() then
			warn("[MonsterEgg] Studio temporary session: " .. tostring(err))
			return Data.Default(), false, nil
		end
		return nil, false, "Progress could not load. Please rejoin; your saved data is safe."
	end
	if not loaded then
		return nil, false, "Your progress is open on another server. Please rejoin in a moment."
	end
	return reconcile(loaded), true, nil
end

-- Writes progress if this server still owns the lock. Returns "ok", "failed" or "lost".
function Data.Save(player: Player, profile: Profile, release: boolean): string
	if not profile.Persistent or not store then
		return "ok"
	end
	while profile.Saving do
		task.wait(0.1)
	end
	profile.Saving = true
	local body = payload(profile)
	local written
	local ok, err = pcall(function()
		written = (store :: DataStore):UpdateAsync("p" .. player.UserId, function(old)
			if not old or not old.Lock or old.Lock.Id ~= session then
				return nil
			end
			body.Lock = if release then nil else { Id = session, Time = os.time() }
			return body
		end)
	end)
	profile.Saving = false
	if not ok then
		warn("[MonsterEgg] Save failed for " .. player.Name .. ": " .. tostring(err))
		return "failed"
	end
	if not written then
		profile.Persistent = false
		return "lost"
	end
	return "ok"
end

function Data.OfflineEarnings(profile: Profile, incomePerSecond: number): number
	if profile.LastSeen &lt;= 0 then
		return 0
	end
	local away = math.clamp(os.time() - profile.LastSeen, 0, Config.OfflineCapSeconds)
	return math.floor(away * incomePerSecond * Config.OfflineRate)
end

return Data
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Guardians</string>
          <ProtectedString name="Source">-- Guardian AI: sleeps beside its nest, wakes when one of its eggs is stolen, chases the carrier
-- (faster and angrier for rare eggs), stops at the safe zone and returns to sleep.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("MonsterEgg")
local Config = require(Shared.Config)
local Monsters = require(Shared.Monsters)

export type Carrier = { Zone: number, Rarity: number }

local Guardian = {}
Guardian.__index = Guardian

local STATUS = {
	Sleeping = { "Zzz", Color3.fromRGB(170, 220, 255) },
	Waking = { "!", Color3.fromRGB(255, 220, 80) },
	Chasing = { "!!", Color3.fromRGB(255, 140, 60) },
	Raging = { "RAGE!", Color3.fromRGB(255, 60, 60) },
	Returning = { "...", Color3.fromRGB(230, 230, 240) },
}

function Guardian.new(zone: number, parent: Instance)
	local home = Config.GuardianHome(zone)
	local model = Monsters.Build(zone, home, parent)
	local self = setmetatable({
		Zone = zone,
		Model = model,
		Root = model.PrimaryPart :: BasePart,
		Home = home,
		State = "",
		StateStart = 0,
		Target = nil :: Player?,
		TargetRarity = 1,
		ChaseStart = 0,
		NextCharge = 0,
		ChargeUntil = 0,
		Rage = 0,
		Status = "",
	}, Guardian)
	self:SetState("Sleeping", os.clock())
	return self
end

function Guardian:SetStatus(key: string)
	if self.Status ~= key then
		self.Status = key
		Monsters.SetStatus(self.Model, STATUS[key][1], STATUS[key][2])
	end
end

function Guardian:SetRage(value: number)
	value = math.floor(value * 20 + 0.5) / 20
	if self.Rage ~= value then
		local wasOn, isOn = self.Rage &gt; 0, value &gt; 0
		self.Rage = value
		self.Model:SetAttribute("Rage", value)
		if wasOn ~= isOn then
			Monsters.SetRage(self.Model, isOn)
		end
	end
end

function Guardian:SetState(state: string, now: number)
	self.State = state
	self.StateStart = now
	self.Model:SetAttribute("State", state)
	self.Model:SetAttribute("Sleeping", state == "Sleeping")
	if state == "Sleeping" then
		self.Root.CFrame = Monsters.SleepCFrame(self.Model, self.Home)
		self:SetRage(0)
		self:SetStatus("Sleeping")
	elseif state == "Waking" then
		self.WakeFrom = self.Root.CFrame
		self:SetStatus("Waking")
	elseif state == "Returning" then
		self:SetRage(0)
		self:SetStatus("Returning")
	end
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

-- Picks the closest living carrier of one of this guardian's eggs outside the safe zone.
function Guardian:FindTarget(carriers: { [Player]: Carrier }, rootOf: (Player) -&gt; BasePart?): (Player?, number)
	local best, bestDistance, rarity = nil, math.huge, 1
	local here = self.Root.Position
	for player, item in carriers do
		if item.Zone == self.Zone then
			local root = rootOf(player)
			if root and root.Position.Z &gt; Config.SafeZ then
				local d = (flat(root.Position) - flat(here)).Magnitude
				if d &lt; bestDistance then
					best, bestDistance, rarity = player, d, item.Rarity
				end
			end
		end
	end
	return best, rarity
end

-- Moves toward `goal` and returns the remaining flat distance.
function Guardian:Step(goal: Vector3, speed: number, dt: number): number
	local hip = self.Model:GetAttribute("Hip") :: number
	local pos = self.Root.Position
	local delta = flat(goal) - flat(pos)
	local distance = delta.Magnitude
	if distance &lt; 0.05 then
		return 0
	end
	local move = math.min(distance, speed * dt)
	local nextPos = flat(pos) + delta.Unit * move
	nextPos = Vector3.new(
		math.clamp(nextPos.X, -Config.HalfWidth + 7, Config.HalfWidth - 7),
		self.Home.Position.Y + hip,
		math.clamp(nextPos.Z, Config.SafeZ + 8, Config.ZoneStart(#Config.Zones + 1) - 6)
	)
	self.Root.CFrame = CFrame.lookAt(nextPos, nextPos + delta.Unit)
	return distance - move
end

-- Returns the player that was caught this frame, if any.
function Guardian:Update(dt: number, now: number, carriers: { [Player]: Carrier }, rootOf: (Player) -&gt; BasePart?, onRoar: (Guardian, boolean) -&gt; ()): Player?
	local target, rarity = self:FindTarget(carriers, rootOf)
	self.Target, self.TargetRarity = target, rarity

	if self.State == "Sleeping" then
		if target then
			self:SetState("Waking", now)
		end
		return nil
	end

	if self.State == "Waking" then
		local alpha = math.clamp((now - self.StateStart) / Config.WakeTime, 0, 1)
		local stand = Monsters.StandCFrame(self.Model, self.Home)
		self.Root.CFrame = self.WakeFrom:Lerp(stand, alpha * alpha * (3 - 2 * alpha))
		if alpha &gt;= 1 then
			if target then
				self:SetState("Chasing", now)
				self.ChaseStart = now
				self.NextCharge = now + 2.5
				onRoar(self, rarity &gt;= Config.RageRarity)
			else
				self:SetState("Returning", now)
			end
		end
		return nil
	end

	if self.State == "Returning" and target then
		self:SetState("Chasing", now)
		self.ChaseStart = now
	end

	if self.State == "Chasing" then
		if not target then
			self:SetState("Returning", now)
			return nil
		end
		local zone = Config.Zones[self.Zone]
		local chaseTime = now - self.ChaseStart
		local raging = rarity &gt;= Config.RageRarity
		local rage = if raging then math.clamp(0.45 + (rarity - Config.RageRarity) * 0.18 + chaseTime * 0.02, 0, 1) else 0
		self:SetRage(rage)
		self:SetStatus(if raging then "Raging" else "Chasing")
		local multiplier = 1 + math.max(0, rarity - 3) * 0.1 + math.min(chaseTime * 0.012, 0.2)
		local root = rootOf(target) :: BasePart
		local distance = (flat(root.Position) - flat(self.Root.Position)).Magnitude
		if rarity &gt;= Config.ChargeRarity and now &gt;= self.NextCharge and distance &lt; 70 then
			self.ChargeUntil = now + 0.8
			self.NextCharge = now + 5
			onRoar(self, true)
		end
		if now &lt; self.ChargeUntil then
			multiplier *= 1.75
		end
		self:Step(root.Position, zone.Speed * multiplier, dt)
		local reach = zone.Reach
		if (flat(root.Position) - flat(self.Root.Position)).Magnitude &lt;= reach then
			return target
		end
		return nil
	end

	if self.State == "Returning" then
		local remaining = self:Step(self.Home.Position, Config.ReturnSpeed, dt)
		if remaining &lt;= 0.5 then
			self:SetState("Sleeping", now)
		end
	end
	return nil
end

return Guardian
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript">
        <Properties>
          <string name="Name">MonsterEggClient</string>
          <ProtectedString name="Source">-- MONSTER EGG ESCAPE client: wires remotes, HUD, world effects and per-player world labels.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("MonsterEgg")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = Shared:WaitForChild("Remotes")
local Hud = require(script:WaitForChild("Hud"))
local Fx = require(script:WaitForChild("Fx"))

local player = Players.LocalPlayer
local world = Workspace:WaitForChild("MonsterEggEscape")
local sanctuary = world:WaitForChild("Sanctuary")
local runtime = world:WaitForChild("Runtime")

local ShopFunction = Remotes:WaitForChild("Shop") :: RemoteFunction
local NoticeEvent = Remotes:WaitForChild("Notice") :: RemoteEvent
local EffectEvent = Remotes:WaitForChild("Effect") :: RemoteEvent

local function invokeShop(action: string, index: any): (boolean, string)
	local ok, result, message = pcall(ShopFunction.InvokeServer, ShopFunction, action, index)
	if not ok then
		return false, "Shop is busy — try again"
	end
	return result, message
end

local function promptRobux(kind: string, index: number)
	local productId = Config.ProductFor(kind, index)
	if productId &gt; 0 then
		MarketplaceService:PromptProductPurchase(player, productId)
	else
		Hud.Toast("Robux purchases are not set up yet", "info")
	end
end

Hud.Build({
	Shop = invokeShop,
	Robux = promptRobux,
	Claim = function()
		return invokeShop("Claim", 0)
	end,
	Setting = function(name: string, enabled: boolean)
		if name == "Music" then
			Fx.SetMusicEnabled(enabled)
		else
			Fx.SetOption(name, enabled)
		end
	end,
})
Fx.Init(world)

-- Remotes ---------------------------------------------------------------------------

NoticeEvent.OnClientEvent:Connect(function(text: string, kind: string)
	Hud.Toast(text, kind)
end)

local effects = {}

function effects.Pickup(rarity: number)
	local info = Config.Rarities[rarity]
	Fx.Sound("Pickup")
	Fx.Burst(info.Color, 20 + rarity * 6, 0.8)
	if rarity &gt;= Config.RageRarity then
		Hud.Splash(info.Name:upper() .. " EGG!", "The guardian is enraged — RUN!", info.Color)
	end
end

function effects.Banked(rarity: number, bonus: number)
	local info = Config.Rarities[rarity]
	Fx.Sound("Bank")
	Fx.Burst(info.Color, 60, 1.4)
	Hud.Splash("SAFE!", "+$" .. Config.Format(bonus) .. "  •  " .. info.Name .. " egg banked", info.Color)
end

function effects.Caught(from: Vector3)
	Fx.Sound("Caught")
	Fx.Shake(2.2, 0.6)
	Fx.Knockback(from)
	Hud.Splash("CAUGHT!", "The egg returned to the guardian", Color3.fromRGB(255, 80, 90))
end

function effects.Stolen()
	Fx.Sound("Steal")
	Fx.Shake(1, 0.3)
end

function effects.Fused(rarity: number)
	local info = Config.Rarities[rarity]
	Fx.Sound("LevelUp")
	Fx.Burst(info.Color, 70, 1.4)
	Hud.Splash("FUSED!", info.Name .. " egg created", info.Color)
end

function effects.Purchase()
	Fx.Sound("Buy")
	Fx.Burst(Color3.fromRGB(255, 214, 80), 24, 0.8)
end

function effects.Cash(amount: number)
	Fx.Float("+$" .. Config.Format(amount), Color3.fromRGB(255, 214, 80))
end

function effects.Treadmill(earned: number, level: number)
	local design = Config.TreadmillDesigns[level]
	Fx.Float(string.format("+$%s  ⚡+%d", Config.Format(earned), level), design.Accent)
	Fx.RunBoost(design.Accent, level)
end

function effects.TreadUp(level: number)
	local design = Config.TreadmillDesigns[level]
	Fx.Sound("LevelUp")
	Fx.Burst(design.Accent, 80, 1.6)
	Fx.Shake(0.6, 0.3)
	Hud.Splash("TREADMILL LV " .. level .. "!", design.Name .. " design  •  +" .. Config.TreadSpeedPerLevel .. " walk speed", design.Accent)
end

function effects.Roar(model: Model, raging: boolean)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not model or not model.PrimaryPart or not root then
		return
	end
	local distance = (model.PrimaryPart.Position - root.Position).Magnitude
	if distance &lt; 160 then
		Fx.Sound("Roar", model.PrimaryPart)
		Fx.Shake(if raging then 1.6 else 0.8, if raging then 0.8 else 0.4)
	end
end

function effects.OpenShop()
	Hud.ToggleShop(true)
end

EffectEvent.OnClientEvent:Connect(function(name: string, ...)
	local handler = effects[name]
	if handler then
		handler(...)
	end
end)

-- Personal world labels: board prices and prompts that only the base owner sees -----

local boards = sanctuary:WaitForChild("Boards")

local function setPrice(model: Instance, text: string)
	local face = model:FindFirstChild("Board")
	local sign = face and face:FindFirstChild("Sign")
	local price = sign and sign:FindFirstChild("Price") :: TextLabel?
	if price then
		price.Text = text
	end
end

local function refreshWorldLabels()
	local speed = player:GetAttribute("SpeedLevel") or 0
	local capacity = player:GetAttribute("Capacity") or Config.StartCapacity
	setPrice(boards:WaitForChild("SpeedBoard"), if speed &gt;= Config.MaxSpeedLevel then "MAXED" else string.format("Lv %d → %d  •  $%s", speed, speed + 1, Config.Format(Config.SpeedCost(speed))))
	setPrice(boards:WaitForChild("StorageBoard"), if capacity &gt;= Config.MaxCapacity then "MAXED" else string.format("%d → %d eggs  •  $%s", capacity, capacity + Config.CapacityStep, Config.Format(Config.StorageCost(capacity))))
end

-- Hide the steal prompt on our own carried egg; sell and upgrade prompts only work in our own base.
local function configurePrompt(prompt: Instance)
	if not prompt:IsA("ProximityPrompt") then
		return
	end
	if prompt.Name == "StealPrompt" then
		local model = prompt:FindFirstAncestorOfClass("Model")
		prompt.Enabled = model == nil or model:GetAttribute("Carrier") ~= player.UserId
	elseif prompt.Name == "SellPrompt" or prompt.Name == "UpgradePrompt" or prompt.Name == "SellAllPrompt" or prompt.Name == "FusePrompt" then
		local base = prompt:FindFirstAncestor("Base" .. tostring(player:GetAttribute("Base") or 0))
		prompt.Enabled = base ~= nil
	end
end

for _, container in { runtime:WaitForChild("CarriedEggs"), sanctuary:WaitForChild("Bases") } do
	for _, item in container:GetDescendants() do
		configurePrompt(item)
	end
	container.DescendantAdded:Connect(function(item)
		if item:IsA("ProximityPrompt") then
			task.defer(configurePrompt, item)
		end
	end)
end

-- Treadmill upgrade boards: the clickable $ and R$ buttons only act on your own base.
for _, base in sanctuary.Bases:GetChildren() do
	local screen = base:WaitForChild("UpgradeBoard"):WaitForChild("Board"):WaitForChild("Screen")
	local function mine(): boolean
		return base.Name == "Base" .. tostring(player:GetAttribute("Base") or 0)
	end
	screen:WaitForChild("CashButton").Activated:Connect(function()
		if mine() then
			invokeShop("Upgrade", "Treadmill")
		end
	end)
	screen:WaitForChild("RobuxButton").Activated:Connect(function()
		if mine() and (player:GetAttribute("TreadLevel") or 1) &lt; Config.MaxTreadLevel then
			promptRobux("Tread", 0)
		end
	end)
end

-- Attributes and frame loop -----------------------------------------------------------

player.AttributeChanged:Connect(function(name)
	Hud.Update()
	if name == "SpeedLevel" or name == "Capacity" then
		refreshWorldLabels()
	elseif name == "Base" then
		for _, item in sanctuary.Bases:GetDescendants() do
			configurePrompt(item)
		end
	end
end)
Hud.Update()
refreshWorldLabels()

local currentZone = -1
RunService.RenderStepped:Connect(function(dt)
	local t = os.clock()
	Fx.Step(t, dt)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local safeDistance = nil
	if root then
		local zone = Config.ZoneAt(root.Position.Z)
		if zone ~= currentZone then
			currentZone = zone
			Fx.SetZone(zone)
			if zone == 0 then
				Hud.ZoneBanner("SAFE ZONE", "Monsters can't follow you here", Color3.fromRGB(110, 255, 170))
			else
				local info = Config.Zones[zone]
				Hud.ZoneBanner(info.Name:upper() .. " ZONE", "Guardian: " .. info.Monster .. "  •  Eggs from $" .. Config.Format(info.Income) .. "/s", info.Color)
			end
		end
		if (player:GetAttribute("Carrying") or "") ~= "" then
			safeDistance = math.max(0, root.Position.Z - Config.SafeZ)
		end
	end
	local danger = if (player:GetAttribute("Chaser") or "") ~= "" then 0.5 + 0.5 * (player:GetAttribute("Rage") or 0) else 0
	Hud.Frame(t, safeDistance, danger)
end)
</ProtectedString>
        </Properties>
        <Item class="ModuleScript">
          <Properties>
            <string name="Name">Hud</string>
            <ProtectedString name="Source">-- Binds behaviour to the HUD built by HudBuilder: stats, menu, Slow Mode, windows (Shop with
-- Robux packs and upgrades, Trail Shop, Index, Rewards, Settings), toasts, chase warning and carry card.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("MonsterEgg")
local Config = require(Shared:WaitForChild("Config"))
local Builder = require(script.Parent:WaitForChild("HudBuilder"))

local player = Players.LocalPlayer
local Hud = {}

export type Handlers = {
	Shop: (action: string, index: any) -&gt; (boolean, string),
	Robux: (kind: string, index: number) -&gt; (), -- kind: "Trail", "Cash", "Speed" or "Tread"
	Claim: () -&gt; (boolean, string),
	Setting: (name: string, enabled: boolean) -&gt; (),
}

local GREEN = Color3.fromRGB(120, 255, 170)
local RED = Color3.fromRGB(255, 90, 110)
local GOLD = Color3.fromRGB(255, 220, 90)

local gui: ScreenGui
local refs: { [string]: any } = {}
local handlers: Handlers
local openWindow: GuiObject? = nil
local settings = { Music = true, Sounds = true, Shake = true, Particles = true }

local function setPair(object: Instance, pair: { Color3 })
	local gloss = object:FindFirstChild("Gloss") :: UIGradient?
	if gloss then
		gloss.Color = ColorSequence.new(pair[1], pair[2])
	end
end

local function setLabel(button: Instance, value: string)
	local label = button:FindFirstChild("Label") :: TextLabel?
	if label then
		label.Text = value
	end
end

local function pop(object: GuiObject, from: number?)
	local scale = (object:FindFirstChild("Pop") or object:FindFirstChild("Press") or object:FindFirstChildOfClass("UIScale")) :: UIScale?
	if not scale then
		scale = Instance.new("UIScale")
		scale.Parent = object
	end
	local s = scale :: UIScale
	s.Scale = from or 0.85
	TweenService:Create(s, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- Hover/press bounce on every glossy button.
local function juice(button: GuiButton)
	local scale = button:FindFirstChild("Press") :: UIScale?
	if not scale then
		return
	end
	local function to(value: number)
		TweenService:Create(scale :: UIScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad), { Scale = value }):Play()
	end
	button.MouseEnter:Connect(function()
		to(1.06)
	end)
	button.MouseLeave:Connect(function()
		to(1)
	end)
	button.MouseButton1Down:Connect(function()
		to(0.9)
	end)
	button.MouseButton1Up:Connect(function()
		to(1.06)
	end)
end

-- Windows ------------------------------------------------------------------------------

function Hud.Open(name: string?)
	local target = name and gui:FindFirstChild(name) :: GuiObject?
	if openWindow and openWindow ~= target then
		openWindow.Visible = false
	end
	if not target or target == openWindow then
		if openWindow then
			openWindow.Visible = false
		end
		openWindow = nil
		return
	end
	openWindow = target
	target.Visible = true
	pop(target, 0.7)
	Hud.Update()
end

function Hud.ToggleShop(open: boolean)
	if open then
		if openWindow ~= gui:FindFirstChild("TrailsWindow") then
			Hud.Open("TrailsWindow")
		end
	elseif openWindow and openWindow.Name == "TrailsWindow" then
		Hud.Open(nil)
	end
end

local function setStatus(message: string, ok: boolean)
	local status = refs.TrailStatus :: TextLabel
	status.Text = message
	status.TextColor3 = if ok then GREEN else RED
end

-- Construction / binding ---------------------------------------------------------------

function Hud.Build(callbacks: Handlers)
	handlers = callbacks
	local playerGui = player:WaitForChild("PlayerGui")
	gui = (playerGui:FindFirstChild(Builder.Name) or playerGui:WaitForChild(Builder.Name, 3) or Builder.Build(playerGui)) :: ScreenGui

	local uiScale = gui:WaitForChild("Scale") :: UIScale
	local function rescale()
		local size = Workspace.CurrentCamera.ViewportSize
		uiScale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 760), 0.55, 1.15)
	end
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	local stats = gui:WaitForChild("Stats")
	refs.Cash = stats.Cash
	refs.Speed = stats.Speed
	refs.Eggs = stats.Eggs
	refs.GiftTimer = gui:WaitForChild("GiftTimer").Text
	refs.Slow = gui:WaitForChild("Menu").SlowMode.Switch
	refs.Vignette = gui:WaitForChild("Vignette"):GetChildren()
	refs.Save = gui:WaitForChild("SaveStatus")
	refs.Banner = gui:WaitForChild("ZoneBanner")
	refs.Chase = gui:WaitForChild("Chase")
	refs.Carry = gui:WaitForChild("Carry")
	refs.Toasts = gui:WaitForChild("Toasts")
	refs.Splash = gui:WaitForChild("Splash")
	refs.SplashSub = gui:WaitForChild("SplashSub")
	refs.Trails = gui:WaitForChild("TrailsWindow")
	refs.TrailStatus = refs.Trails.Body.Status
	refs.Shop = gui:WaitForChild("ShopWindow")
	refs.Rewards = gui:WaitForChild("RewardsWindow")
	refs.RewardBadge = gui.SideButtons.Rewards.Badge

	for _, item in gui:GetDescendants() do
		if item:IsA("TextButton") then
			juice(item)
		end
	end

	-- Side buttons and close buttons.
	local windows = { Shop = "ShopWindow", Index = "IndexWindow", Trails = "TrailsWindow", Rewards = "RewardsWindow", Settings = "SettingsWindow" }
	for buttonName, windowName in windows do
		local holder = if buttonName == "Rewards" or buttonName == "Settings" then gui.SideButtons else gui.Menu
		local sideButton = holder:WaitForChild(buttonName) :: TextButton
		sideButton.Activated:Connect(function()
			Hud.Open(windowName)
		end)
		local closeButton = gui:WaitForChild(windowName):WaitForChild("Close") :: TextButton
		closeButton.Activated:Connect(function()
			Hud.Open(nil)
		end)
	end

	-- Trail cards.
	for index = 1, #Config.Trails do
		local card = refs.Trails.Body.Cards:WaitForChild("Trail" .. index)
		card.BuyCash.Activated:Connect(function()
			local ok, message = handlers.Shop("Buy", index)
			setStatus(message, ok)
			pop(card, 0.92)
		end)
		card.BuyRobux.Activated:Connect(function()
			handlers.Robux("Trail", index)
		end)
		card.Equip.Activated:Connect(function()
			local ok, message = handlers.Shop("Equip", index)
			setStatus(message, ok)
			pop(card, 0.92)
		end)
	end

	-- Shop tabs and Robux packs.
	local pages = refs.Shop.Body.Pages
	refs.Upgrades = pages.Upgrades
	for _, tab in refs.Shop.Body.Tabs:GetChildren() do
		if tab:IsA("TextButton") then
			tab.Activated:Connect(function()
				for _, pageFrame in pages:GetChildren() do
					pageFrame.Visible = pageFrame.Name == tab.Name
				end
				Hud.Update()
			end)
		end
	end
	for kind, packs in { Cash = Config.CashPacks, Speed = Config.SpeedPacks } do
		for index = 1, #packs do
			pages[kind]:WaitForChild("Pack" .. index).Buy.Activated:Connect(function()
				handlers.Robux(kind, index)
			end)
		end
	end

	-- Slow Mode (server keeps the real walk speed so upgrades still count).
	refs.Slow.Activated:Connect(function()
		handlers.Shop("SlowMode", not player:GetAttribute("SlowMode"))
	end)

	-- Upgrades.
	for _, name in { "Speed", "Storage", "Treadmill" } do
		local card = refs.Upgrades:WaitForChild(name)
		card.Buy.Activated:Connect(function()
			-- The server sends its own notice toast for upgrades.
			handlers.Shop("Upgrade", name)
			pop(card, 0.94)
		end)
	end

	-- Rewards.
	refs.Rewards.Body.Claim.Activated:Connect(function()
		local ok, message = handlers.Claim()
		Hud.Toast(message, if ok then "rare" else "bad")
		if ok then
			Hud.Splash("FREE GIFT!", message, GOLD)
		end
	end)

	-- Settings toggles.
	for name in settings do
		local row = gui.SettingsWindow.Body:WaitForChild(name)
		local toggle = row.Toggle
		toggle.Activated:Connect(function()
			settings[name] = not settings[name]
			setLabel(toggle, if settings[name] then "ON" else "OFF")
			setPair(toggle, if settings[name] then Builder.Colors.Green else Builder.Colors.Grey)
			handlers.Setting(name, settings[name])
		end)
	end
	return gui
end

-- Updates ------------------------------------------------------------------------------

local function refreshTrails()
	local owned = string.split(player:GetAttribute("OwnedTrails") or "", ",")
	local equipped = player:GetAttribute("Trail") or 0
	local cash = player:GetAttribute("Cash") or 0
	for index, trail in Config.Trails do
		local card = refs.Trails.Body.Cards:FindFirstChild("Trail" .. index)
		if not card then
			continue
		end
		local isOwned = table.find(owned, tostring(index)) ~= nil
		card.BuyCash.Visible = not isOwned
		card.BuyRobux.Visible = not isOwned
		card.Equip.Visible = isOwned
		if isOwned then
			local isEquipped = index == equipped
			setLabel(card.Equip, if isEquipped then "EQUIPPED ✓" else "EQUIP")
			setPair(card.Equip, if isEquipped then Builder.Colors.Green else Builder.Colors.Blue)
			card.State.Text = if isEquipped then "IN USE" else "OWNED"
			card.State.TextColor3 = if isEquipped then GREEN else Color3.fromRGB(220, 215, 245)
		else
			setPair(card.BuyCash, if cash &gt;= trail.Cost then Builder.Colors.Gold else Builder.Colors.Grey)
			card.State.Text = if cash &gt;= trail.Cost then "CAN AFFORD!" else "NOT OWNED"
			card.State.TextColor3 = if cash &gt;= trail.Cost then GOLD else Color3.fromRGB(220, 215, 245)
		end
	end
end
Hud.RefreshShop = refreshTrails

local function refreshUpgrades()
	local speed = player:GetAttribute("SpeedLevel") or 0
	local capacity = player:GetAttribute("Capacity") or Config.StartCapacity
	local cash = player:GetAttribute("Cash") or 0
	local speedCard, storageCard = refs.Upgrades.Speed, refs.Upgrades.Storage
	local speedMax = speed &gt;= Config.MaxSpeedLevel
	speedCard.Level.Text = if speedMax then "MAX LEVEL" else string.format("LEVEL %d → %d", speed, speed + 1)
	speedCard.Progress.Fill.Size = UDim2.fromScale(speed / Config.MaxSpeedLevel, 1)
	setLabel(speedCard.Buy, if speedMax then "MAXED" else "$" .. Config.Format(Config.SpeedCost(speed)))
	setPair(speedCard.Buy, if not speedMax and cash &gt;= Config.SpeedCost(speed) then Builder.Colors.Green else Builder.Colors.Grey)
	local storageMax = capacity &gt;= Config.MaxCapacity
	storageCard.Level.Text = if storageMax then "MAX " .. capacity .. " EGGS" else string.format("%d → %d EGGS", capacity, capacity + Config.CapacityStep)
	storageCard.Progress.Fill.Size = UDim2.fromScale((capacity - Config.StartCapacity) / (Config.MaxCapacity - Config.StartCapacity), 1)
	setLabel(storageCard.Buy, if storageMax then "MAXED" else "$" .. Config.Format(Config.StorageCost(capacity)))
	setPair(storageCard.Buy, if not storageMax and cash &gt;= Config.StorageCost(capacity) then Builder.Colors.Green else Builder.Colors.Grey)
	local tread = player:GetAttribute("TreadLevel") or 1
	local treadCard = refs.Upgrades.Treadmill
	local treadMax = tread &gt;= Config.MaxTreadLevel
	treadCard.Level.Text = if treadMax then "MAX LEVEL" else string.format("LEVEL %d → %d", tread, tread + 1)
	treadCard.Progress.Fill.Size = UDim2.fromScale(tread / Config.MaxTreadLevel, 1)
	setLabel(treadCard.Buy, if treadMax then "MAXED" else "$" .. Config.Format(Config.TreadCost(tread)))
	setPair(treadCard.Buy, if not treadMax and cash &gt;= Config.TreadCost(tread) then Builder.Colors.Green else Builder.Colors.Grey)
end

function Hud.Update()
	if not gui then
		return
	end
	local cash = player:GetAttribute("Cash") or 0
	refs.Cash.Value.Text = "$" .. Config.Format(cash)
	refs.Cash.Sub.Text = "+$" .. Config.Format(player:GetAttribute("Income") or 0) .. " per second"
	local trail = Config.Trails[player:GetAttribute("Trail") or 0]
	local walk = player:GetAttribute("WalkSpeed") or Config.BaseWalkSpeed
	refs.Speed.Value.Text = if trail then string.format("%.1f (x%s)", walk, tostring(trail.Multiplier)) else string.format("%.1f", walk)
	local training = player:GetAttribute("Training") or 0
	refs.Speed.Sub.Text = if player:GetAttribute("SlowMode")
		then "SLOW MODE ON"
		else string.format("Treadmill Lv %d  •  Training %d/%d", player:GetAttribute("TreadLevel") or 1, math.min(training, Config.TrainingCap), Config.TrainingCap)
	refs.Speed.Progress.Fill.Size = UDim2.fromScale(math.clamp(training / Config.TrainingCap, 0, 1), 1)
	refs.Eggs.Value.Text = string.format("%d/%d", player:GetAttribute("EggCount") or 0, player:GetAttribute("Capacity") or Config.StartCapacity)
	refs.Eggs.Sub.Text = "eggs in your base"
	local slow = player:GetAttribute("SlowMode") == true
	local knob = refs.Slow.Knob
	knob.Position = UDim2.fromOffset(if slow then 41 else 3, 3)
	knob.BackgroundColor3 = if slow then Color3.fromRGB(110, 240, 90) else Color3.fromRGB(190, 190, 205)
	refs.Slow.BackgroundColor3 = if slow then Color3.fromRGB(40, 120, 50) else Color3.fromRGB(70, 74, 90)
	refs.Save.Text = player:GetAttribute("SaveStatus") or ""

	local carrying = player:GetAttribute("Carrying") or ""
	refs.Carry.Visible = carrying ~= ""
	if carrying ~= "" then
		local rarity = Config.Rarities[player:GetAttribute("CarryRarity") or 1]
		refs.Carry.Title.Text = carrying:upper()
		refs.Carry.Title.TextColor3 = rarity.Color
		setPair(refs.Carry, { rarity.Shade:Lerp(Color3.new(0, 0, 0), 0.3), Color3.fromRGB(30, 22, 64) })
	end

	local chaser = player:GetAttribute("Chaser") or ""
	local rage = player:GetAttribute("Rage") or 0
	refs.Chase.Visible = chaser ~= ""
	if chaser ~= "" then
		refs.Chase.Title.Text = chaser:upper() .. " IS CHASING YOU!"
		refs.Chase.Bar.Fill.Size = UDim2.fromScale(math.max(rage, 0.08), 1)
		refs.Chase.Bar.Text.Text = if rage &gt; 0 then string.format("MONSTER RAGE %d%%", math.floor(rage * 100)) else "RUN!"
	end
	if refs.Trails.Visible then
		refreshTrails()
	end
	if refs.Shop.Visible then
		refreshUpgrades()
	end
	refs.Rewards.Body.Amount.Text = "+$" .. Config.Format(Config.RewardCash(player:GetAttribute("Income") or 0))
end

-- Called every frame with the distance to safety (or nil when not carrying).
function Hud.Frame(t: number, safeDistance: number?, danger: number)
	if not gui then
		return
	end
	if safeDistance then
		refs.Carry.Hint.Text = if safeDistance &gt; 0 then string.format("↓ SAFE ZONE IN %d STUDS ↓", math.ceil(safeDistance)) else "SAFE!"
	end
	local pulse = 0.5 + 0.5 * math.sin(t * 8)
	for _, edge in refs.Vignette do
		edge.BackgroundTransparency = 1 - danger * (0.35 + 0.25 * pulse)
	end
	if refs.Chase.Visible then
		refs.Chase.Rotation = math.sin(t * 30) * (player:GetAttribute("Rage") or 0) * 1.5
	end
	local remaining = math.max(0, (player:GetAttribute("NextReward") or 0) - Workspace:GetServerTimeNow())
	local ready = remaining &lt;= 0
	refs.RewardBadge.Visible = ready
	if ready then
		refs.RewardBadge.Rotation = math.sin(t * 6) * 12
	end
	refs.GiftTimer.Text = if ready then "GIFT READY!" else string.format("in %dm %02ds", remaining // 60, math.floor(remaining % 60))
	refs.GiftTimer.TextColor3 = if ready then GOLD else Color3.new(1, 1, 1)
	local claim = refs.Rewards.Body.Claim
	setLabel(claim, if ready then "CLAIM!" else string.format("%d:%02d", remaining // 60, math.floor(remaining % 60)))
	setPair(claim, if ready then Builder.Colors.Green else Builder.Colors.Grey)
end

function Hud.ZoneBanner(title: string, subtitle: string, color: Color3)
	local banner = refs.Banner
	banner.Title.Text = title
	banner.Sub.Text = subtitle
	setPair(banner, { color:Lerp(Color3.new(1, 1, 1), 0.25), color:Lerp(Color3.new(0, 0, 0), 0.35) })
	TweenService:Create(banner, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 12) }):Play()
	local token = {}
	refs.BannerToken = token
	task.delay(2.6, function()
		if refs.BannerToken == token then
			TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0.5, 0, 0, -200) }):Play()
		end
	end)
end

local TOAST_COLORS = {
	good = Builder.Colors.Green,
	bad = Builder.Colors.Red,
	info = Builder.Colors.Blue,
	rare = Builder.Colors.Gold,
}
local toastOrder = 0

function Hud.Toast(message: string, kind: string?)
	if not gui then
		return
	end
	toastOrder += 1
	local toast = Builder.Panel(refs.Toasts, "Toast", TOAST_COLORS[kind or "info"] or TOAST_COLORS.info, UDim2.fromOffset(500, 48), UDim2.new(), 16)
	toast.LayoutOrder = -toastOrder
	local label = Builder.Text({ Name = "Text", Text = message, Font = Builder.Font, Size = UDim2.new(1, -24, 1, -12), Position = UDim2.fromOffset(12, 6), Parent = toast })
	pop(toast)
	local items = {}
	for _, child in refs.Toasts:GetChildren() do
		if child:IsA("Frame") then
			table.insert(items, child)
		end
	end
	table.sort(items, function(a, b)
		return a.LayoutOrder &lt; b.LayoutOrder
	end)
	for n = 5, #items do
		items[n]:Destroy()
	end
	task.delay(4, function()
		if toast.Parent then
			TweenService:Create(toast, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
			TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			task.wait(0.4)
			toast:Destroy()
		end
	end)
end

function Hud.Splash(title: string, sub: string, color: Color3)
	refs.Splash.Text = title
	refs.Splash.TextColor3 = color
	refs.SplashSub.Text = sub
	refs.Splash.Visible = true
	refs.SplashSub.Visible = true
	pop(refs.Splash)
	local token = {}
	refs.SplashToken = token
	task.delay(1.8, function()
		if refs.SplashToken == token then
			refs.Splash.Visible = false
			refs.SplashSub.Visible = false
		end
	end)
end

return Hud
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript">
          <Properties>
            <string name="Name">HudBuilder</string>
            <ProtectedString name="Source">-- Builds the MONSTER EGG ESCAPE interface as real GUI objects with stable names.
-- Run once in Studio (Edit mode) to place it in StarterGui, where it can be inspected and tweaked;
-- the Hud module binds behaviour to these objects at runtime and rebuilds them only if missing.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("MonsterEgg"):WaitForChild("Config"))

local Builder = {}

Builder.Name = "MonsterEggHUD"
Builder.TitleFont = Enum.Font.LuckiestGuy
Builder.Font = Enum.Font.FredokaOne
Builder.Ink = Color3.fromRGB(25, 18, 48)

local INK = Builder.Ink
local WHITE = Color3.new(1, 1, 1)

-- Two-stop gradients per accent: light top, rich bottom.
Builder.Colors = {
	Gold = { Color3.fromRGB(255, 236, 120), Color3.fromRGB(255, 166, 30) },
	Blue = { Color3.fromRGB(130, 230, 255), Color3.fromRGB(40, 120, 255) },
	Pink = { Color3.fromRGB(255, 170, 230), Color3.fromRGB(225, 70, 185) },
	Green = { Color3.fromRGB(150, 245, 110), Color3.fromRGB(40, 170, 60) },
	Purple = { Color3.fromRGB(200, 160, 255), Color3.fromRGB(115, 60, 220) },
	Orange = { Color3.fromRGB(255, 190, 90), Color3.fromRGB(240, 90, 50) },
	Steel = { Color3.fromRGB(190, 205, 235), Color3.fromRGB(85, 105, 155) },
	Red = { Color3.fromRGB(255, 130, 130), Color3.fromRGB(215, 35, 60) },
	Teal = { Color3.fromRGB(120, 255, 220), Color3.fromRGB(20, 160, 150) },
	Grey = { Color3.fromRGB(170, 170, 185), Color3.fromRGB(95, 95, 115) },
	Window = { Color3.fromRGB(70, 55, 130), Color3.fromRGB(30, 22, 64) },
	Lime = { Color3.fromRGB(190, 255, 90), Color3.fromRGB(70, 200, 40) },
	Cash = { Color3.fromRGB(130, 235, 100), Color3.fromRGB(30, 150, 60) },
	Sky = { Color3.fromRGB(110, 210, 255), Color3.fromRGB(20, 110, 230) },
}

local function make(class: string, props: { [string]: any }, children: { Instance }?): any
	local item = Instance.new(class)
	for key, value in props do
		if key ~= "Parent" then
			(item :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = item
	end
	item.Parent = props.Parent
	return item
end
Builder.Make = make

local function corner(radius: number)
	return make("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function outline(thickness: number, color: Color3?)
	return make("UIStroke", { Thickness = thickness, Color = color or INK, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, LineJoinMode = Enum.LineJoinMode.Round })
end

-- Vertical glossy gradient for a colour pair.
function Builder.Gradient(pair: { Color3 }, rotation: number?)
	return make("UIGradient", { Name = "Gloss", Color = ColorSequence.new(pair[1], pair[2]), Rotation = rotation or 90 })
end

-- White highlight across the top half, the classic "glossy button" look.
local function shine(parent: Instance, radius: number)
	return make("Frame", {
		Name = "Shine", BackgroundColor3 = WHITE, BackgroundTransparency = 0.55, BorderSizePixel = 0,
		Position = UDim2.new(0, 5, 0, 4), Size = UDim2.new(1, -10, 0.42, 0), ZIndex = 2, Parent = parent,
	}, {
		corner(radius),
		make("UIGradient", { Rotation = 90, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) }) }),
	})
end

-- Big cartoon text with a thick dark outline.
function Builder.Text(props: { [string]: any }): TextLabel
	local thickness = props.Outline or 3
	props.Outline = nil
	props.BackgroundTransparency = 1
	props.Font = props.Font or Builder.TitleFont
	props.TextScaled = true
	props.TextColor3 = props.TextColor3 or WHITE
	props.ZIndex = props.ZIndex or 3
	return make("TextLabel", props, { make("UIStroke", { Thickness = thickness, Color = INK, LineJoinMode = Enum.LineJoinMode.Round }) })
end
local text = Builder.Text

local function icon(parent: Instance, name: string, id: string, size: UDim2, position: UDim2, fallback: string): GuiObject
	if id:match("^rbxassetid://%d+$") then
		return make("ImageLabel", {
			Name = name, Image = id, ScaleType = Enum.ScaleType.Fit, BackgroundTransparency = 1,
			Size = size, Position = position, ZIndex = 4, Parent = parent,
		})
	end
	return text({ Name = name, Text = fallback, Size = size, Position = position, ZIndex = 4, Parent = parent })
end

-- Glossy, outlined button with a centred label.
function Builder.Button(parent: Instance, name: string, pair: { Color3 }, size: UDim2, position: UDim2, label: string, radius: number?): TextButton
	local r = radius or 14
	local button = make("TextButton", {
		Name = name, Text = "", AutoButtonColor = false, BackgroundColor3 = WHITE, Size = size, Position = position, Parent = parent,
	}, { corner(r), outline(3.5), Builder.Gradient(pair), make("UIScale", { Name = "Press" }) })
	shine(button, r - 4)
	text({ Name = "Label", Text = label, Size = UDim2.new(1, -14, 1, -10), Position = UDim2.fromOffset(7, 5), Font = Builder.TitleFont, Parent = button })
	return button
end
local button = Builder.Button

-- Rounded panel with gloss and a thick outline.
local function panel(parent: Instance, name: string, pair: { Color3 }, size: UDim2, position: UDim2, radius: number?): Frame
	local r = radius or 18
	local frame = make("Frame", {
		Name = name, BackgroundColor3 = WHITE, Size = size, Position = position, Parent = parent,
	}, { corner(r), outline(4), Builder.Gradient(pair) })
	shine(frame, r - 4)
	return frame
end
Builder.Panel = panel

-- HUD -------------------------------------------------------------------------------

local LEFT = Enum.TextXAlignment.Left

-- Big outlined stat line in the bottom-left corner, e.g. [cash icon] $49.2B.
local function stat(parent: Instance, name: string, iconId: string, fallback: string, color: Color3, order: number)
	local row = make("Frame", { Name = name, BackgroundTransparency = 1, Size = UDim2.fromOffset(360, 52), LayoutOrder = order, Parent = parent })
	icon(row, "Icon", iconId, UDim2.fromOffset(52, 52), UDim2.new(), fallback)
	text({ Name = "Value", Text = "0", TextColor3 = color, TextXAlignment = LEFT, Size = UDim2.new(1, -62, 0, 36), Position = UDim2.fromOffset(60, 0), Outline = 3.5, Parent = row })
	text({ Name = "Sub", Text = "", Font = Builder.Font, Outline = 2, TextXAlignment = LEFT, Size = UDim2.new(1, -62, 0, 16), Position = UDim2.fromOffset(62, 35), Parent = row })
	return row
end

-- Wide menu button with an icon on the left: [cart] Shop.
local function menuButton(parent: Instance, name: string, label: string, pair: { Color3 }, iconId: string, fallback: string, order: number)
	local b = button(parent, name, pair, UDim2.fromOffset(176, 58), UDim2.new(), "", 14)
	b.LayoutOrder = order
	b.Label:Destroy()
	icon(b, "Icon", iconId, UDim2.fromOffset(48, 48), UDim2.fromOffset(8, 5), fallback)
	text({ Name = "Label", Text = label, TextXAlignment = LEFT, Size = UDim2.new(1, -70, 0, 34), Position = UDim2.fromOffset(62, 12), Parent = b })
	return b
end

-- Square icon button for the right edge.
local function squareButton(parent: Instance, name: string, label: string, pair: { Color3 }, iconId: string, fallback: string, order: number)
	local b = button(parent, name, pair, UDim2.fromOffset(84, 84), UDim2.new(), "", 18)
	b.LayoutOrder = order
	b.Label:Destroy()
	icon(b, "Icon", iconId, UDim2.fromOffset(56, 56), UDim2.fromOffset(14, 4), fallback)
	text({ Name = "Label", Text = label, Size = UDim2.new(1, -8, 0, 20), Position = UDim2.new(0, 4, 1, -24), Parent = b })
	return b
end

-- Window ------------------------------------------------------------------------------

local function window(parent: Instance, name: string, title: string, pair: { Color3 }, size: Vector2): (Frame, Frame)
	local w = panel(parent, name, Builder.Colors.Window, UDim2.fromOffset(size.X, size.Y), UDim2.fromScale(0.5, 0.52), 24)
	w.AnchorPoint = Vector2.new(0.5, 0.5)
	w.Visible = false
	w.ZIndex = 10
	make("UIScale", { Name = "Pop", Parent = w })
	local header = panel(w, "Header", pair, UDim2.new(1, -40, 0, 70), UDim2.fromOffset(20, -30), 22)
	text({ Name = "Title", Text = title, Size = UDim2.new(1, -40, 1, -14), Position = UDim2.fromOffset(20, 7), Outline = 4, Parent = header })
	local close = button(w, "Close", Builder.Colors.Red, UDim2.fromOffset(58, 58), UDim2.new(1, -38, 0, -24), "X", 29)
	close.ZIndex = 12
	local body = make("Frame", {
		Name = "Body", BackgroundTransparency = 1, Size = UDim2.new(1, -40, 1, -70), Position = UDim2.fromOffset(20, 52), Parent = w,
	})
	return w, body
end

-- Tall trail card in the style of the big simulators: colour fill, name, rarity, x speed, $ and R$ buttons.
local function trailCard(parent: Instance, index: number)
	local trail = Config.Trails[index]
	local rarity = Config.RarityInfo(trail.Rarity)
	local card = panel(parent, "Trail" .. index, { trail.Colors[1], trail.Colors[2] }, UDim2.fromOffset(200, 340), UDim2.new(), 18)
	card.LayoutOrder = index
	text({ Name = "Name", Text = trail.Name:upper() .. " TRAIL", Size = UDim2.new(1, -20, 0, 32), Position = UDim2.fromOffset(10, 10), Outline = 3.5, Parent = card })
	text({ Name = "Rarity", Text = trail.Rarity, Font = Builder.Font, TextColor3 = rarity.Color, Size = UDim2.new(1, -40, 0, 22), Position = UDim2.fromOffset(20, 42), Parent = card })
	local preview = icon(card, "Preview", Config.Icons.Trail, UDim2.fromOffset(130, 130), UDim2.new(0.5, -65, 0, 66), "✨")
	preview.Rotation = -8
	if preview:IsA("ImageLabel") then
		preview.ImageColor3 = trail.Colors[1]:Lerp(Color3.new(1, 1, 1), 0.35)
	end
	local pill = make("Frame", {
		Name = "Multiplier", BackgroundColor3 = INK, BackgroundTransparency = 0.35, Size = UDim2.new(1, -24, 0, 40), Position = UDim2.fromOffset(12, 204), ZIndex = 3, Parent = card,
	}, { corner(12) })
	text({ Name = "Text", Text = string.format("x%s Speed", tostring(trail.Multiplier)), Size = UDim2.new(1, -16, 1, -8), Position = UDim2.fromOffset(8, 4), Parent = pill })
	button(card, "BuyCash", Builder.Colors.Lime, UDim2.new(0.58, -16, 0, 46), UDim2.new(0, 12, 0, 254), "$" .. Config.Format(trail.Cost), 12)
	button(card, "BuyRobux", Builder.Colors.Pink, UDim2.new(0.42, -8, 0, 46), UDim2.new(0.58, -4, 0, 254), "R$" .. trail.Robux, 12)
	local equip = button(card, "Equip", Builder.Colors.Blue, UDim2.new(1, -24, 0, 46), UDim2.fromOffset(12, 254), "EQUIP", 12)
	equip.Visible = false
	text({ Name = "State", Text = "NOT OWNED", Font = Builder.Font, Outline = 2, TextColor3 = Color3.fromRGB(240, 235, 255), Size = UDim2.new(1, -24, 0, 18), Position = UDim2.fromOffset(12, 308), Parent = card })
	return card
end

-- Robux pack card: big art, amount, green price button.
local function packCard(parent: Instance, name: string, pair: { Color3 }, iconId: string, fallback: string, title: string, robux: number, order: number)
	local card = panel(parent, name, pair, UDim2.new(), UDim2.new(), 16)
	card.LayoutOrder = order
	icon(card, "Icon", iconId, UDim2.fromOffset(104, 104), UDim2.new(0.5, -52, 0, 6), fallback)
	local amount = text({ Name = "Amount", Text = title, RichText = true, Size = UDim2.new(1, -20, 0, 34), Position = UDim2.fromOffset(10, 108), Outline = 3.5, Parent = card })
	amount.ZIndex = 5
	button(card, "Buy", Builder.Colors.Lime, UDim2.new(1, -40, 0, 40), UDim2.new(0, 20, 1, -48), "R$ " .. robux, 12)
	return card
end

local function upgradeCard(parent: Instance, name: string, title: string, desc: string, pair: { Color3 }, iconId: string, fallback: string, order: number)
	local card = panel(parent, name, pair, UDim2.new(1 / 3, -14, 1, -10), UDim2.new(), 20)
	card.LayoutOrder = order
	icon(card, "Icon", iconId, UDim2.fromOffset(88, 88), UDim2.new(0.5, -44, 0, 12), fallback)
	text({ Name = "Title", Text = title, Size = UDim2.new(1, -24, 0, 34), Position = UDim2.fromOffset(12, 104), Parent = card })
	text({ Name = "Level", Text = "LEVEL 0", Font = Builder.Font, Outline = 2, Size = UDim2.new(1, -24, 0, 24), Position = UDim2.fromOffset(12, 140), Parent = card })
	local track = make("Frame", { Name = "Progress", BackgroundColor3 = INK, Size = UDim2.new(1, -40, 0, 16), Position = UDim2.fromOffset(20, 170), ZIndex = 3, Parent = card }, { corner(8) })
	make("Frame", { Name = "Fill", BackgroundColor3 = WHITE, Size = UDim2.fromScale(0, 1), ZIndex = 4, Parent = track }, { corner(8), Builder.Gradient(Builder.Colors.Green, 0) })
	text({ Name = "Desc", Text = desc, Font = Builder.Font, Outline = 2, TextColor3 = Color3.fromRGB(255, 250, 230), Size = UDim2.new(1, -24, 0, 36), Position = UDim2.fromOffset(12, 192), TextWrapped = true, Parent = card })
	button(card, "Buy", Builder.Colors.Green, UDim2.new(1, -40, 0, 46), UDim2.new(0, 20, 1, -58), "BUY", 14)
	return card
end

local function toggleRow(parent: Instance, name: string, label: string, order: number)
	local row = panel(parent, name, Builder.Colors.Window, UDim2.new(1, -8, 0, 58), UDim2.new(), 16)
	row.LayoutOrder = order
	text({ Name = "Label", Text = label, TextXAlignment = LEFT, Size = UDim2.new(1, -150, 0, 34), Position = UDim2.fromOffset(18, 12), Parent = row })
	local toggle = button(row, "Toggle", Builder.Colors.Green, UDim2.fromOffset(110, 42), UDim2.new(1, -124, 0, 8), "ON", 21)
	return row, toggle
end

local function page(parent: Instance, name: string, cell: Vector2?): GuiObject
	if not cell then
		return make("Frame", {
			Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = parent,
		}, { make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 20), HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }) })
	end
	return make("ScrollingFrame", {
		Name = name, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = false,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 8, ScrollBarImageColor3 = WHITE, Parent = parent,
	}, {
		make("UIGridLayout", { CellSize = UDim2.fromOffset(cell.X, cell.Y), CellPadding = UDim2.fromOffset(14, 14), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
		make("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }),
	})
end

-- Build everything ---------------------------------------------------------------------

function Builder.Build(parent: Instance): ScreenGui
	local old = parent:FindFirstChild(Builder.Name)
	if old then
		old:Destroy()
	end
	local gui = make("ScreenGui", {
		Name = Builder.Name, ResetOnSpawn = false, IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
	})
	make("UIScale", { Name = "Scale", Parent = gui })

	-- Red danger edges while being chased.
	local vignette = make("Frame", { Name = "Vignette", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0, Parent = gui })
	for n, edge in { { 0, 0, 1, 0.22, 90 }, { 0, 0.78, 1, 0.22, -90 }, { 0, 0, 0.16, 1, 0 }, { 0.84, 0, 0.16, 1, 180 } } do
		make("Frame", {
			Name = "Edge" .. n, Position = UDim2.fromScale(edge[1], edge[2]), Size = UDim2.fromScale(edge[3], edge[4]),
			BackgroundColor3 = Color3.fromRGB(255, 50, 70), BackgroundTransparency = 1, BorderSizePixel = 0, Parent = vignette,
		}, { make("UIGradient", { Rotation = edge[5], Transparency = NumberSequence.new(0, 1) }) })
	end

	-- Stats (bottom left): eggs, speed, cash.
	local stats = make("Frame", {
		Name = "Stats", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -30), Size = UDim2.fromOffset(360, 180), Parent = gui,
	}, { make("UIListLayout", { Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Bottom, SortOrder = Enum.SortOrder.LayoutOrder }) })
	stat(stats, "Eggs", Config.Icons.Egg, "🥚", Color3.fromRGB(255, 170, 230), 1)
	local speed = stat(stats, "Speed", Config.Icons.Speed, "⚡", Color3.fromRGB(150, 120, 255), 2)
	local track = make("Frame", { Name = "Progress", BackgroundColor3 = INK, BackgroundTransparency = 0.2, Size = UDim2.fromOffset(150, 6), Position = UDim2.new(1, -150, 0, 42), ZIndex = 3, Parent = speed }, { corner(3) })
	make("Frame", { Name = "Fill", BackgroundColor3 = Color3.fromRGB(150, 120, 255), Size = UDim2.fromScale(0, 1), ZIndex = 4, Parent = track }, { corner(3) })
	stat(stats, "Cash", Config.Icons.Coin, "$", Color3.fromRGB(110, 255, 90), 3)

	-- Menu (left): Shop, Index, Trails and the Slow Mode switch.
	local menu = make("Frame", {
		Name = "Menu", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 14, 0.4, 0), Size = UDim2.fromOffset(186, 250), Parent = gui,
	}, { make("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }) })
	menuButton(menu, "Shop", "Shop", Builder.Colors.Green, Config.Icons.Shop, "🛒", 1)
	menuButton(menu, "Index", "Index", Builder.Colors.Blue, Config.Icons.Index, "📖", 2)
	menuButton(menu, "Trails", "Trails", Builder.Colors.Pink, Config.Icons.Trail, "✨", 3)
	local slow = make("Frame", { Name = "SlowMode", BackgroundTransparency = 1, Size = UDim2.fromOffset(186, 36), LayoutOrder = 4, Parent = menu })
	local switch = make("TextButton", {
		Name = "Switch", Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(70, 74, 90), Size = UDim2.fromOffset(70, 32), Position = UDim2.fromOffset(2, 2), Parent = slow,
	}, { corner(16), outline(3), make("UIScale", { Name = "Press" }) })
	make("Frame", { Name = "Knob", BackgroundColor3 = Color3.fromRGB(190, 190, 205), Size = UDim2.fromOffset(26, 26), Position = UDim2.fromOffset(3, 3), ZIndex = 2, Parent = switch }, { corner(13) })
	text({ Name = "Label", Text = "Slow Mode", Font = Builder.Font, Outline = 2, TextXAlignment = LEFT, Size = UDim2.fromOffset(104, 24), Position = UDim2.fromOffset(82, 6), Parent = slow })

	-- Right edge: free gift and settings.
	local side = make("Frame", {
		Name = "SideButtons", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.42, 0), Size = UDim2.fromOffset(84, 184), Parent = gui,
	}, { make("UIListLayout", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder }) })
	local rewards = squareButton(side, "Rewards", "GIFT", Builder.Colors.Orange, Config.Icons.Rewards, "🎁", 1)
	local badge = panel(rewards, "Badge", Builder.Colors.Red, UDim2.fromOffset(30, 30), UDim2.new(1, -20, 0, -10), 15)
	badge.ZIndex = 6
	text({ Name = "Text", Text = "1", Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4), ZIndex = 7, Parent = badge })
	squareButton(side, "Settings", "SETTINGS", Builder.Colors.Steel, Config.Icons.Settings, "⚙", 2)

	-- Free gift countdown (top right).
	local timer = make("Frame", {
		Name = "GiftTimer", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 10), Size = UDim2.fromOffset(230, 40), Parent = gui,
	})
	icon(timer, "Icon", Config.Icons.Rewards, UDim2.fromOffset(40, 40), UDim2.new(), "🎁")
	text({ Name = "Text", Text = "", TextXAlignment = LEFT, Size = UDim2.new(1, -48, 0, 30), Position = UDim2.fromOffset(48, 5), Parent = timer })

	text({ Name = "SaveStatus", Text = "", Font = Builder.Font, Outline = 1.5, TextXAlignment = LEFT, TextColor3 = Color3.fromRGB(210, 210, 235), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -8), Size = UDim2.fromOffset(330, 18), Parent = gui })

	-- Zone banner, chase warning and carried egg.
	local banner = panel(gui, "ZoneBanner", Builder.Colors.Green, UDim2.fromOffset(440, 84), UDim2.new(0.5, 0, 0, -200), 22)
	banner.AnchorPoint = Vector2.new(0.5, 0)
	text({ Name = "Title", Text = "SAFE ZONE", Size = UDim2.new(1, -30, 0, 48), Position = UDim2.fromOffset(15, 6), Outline = 4, Parent = banner })
	text({ Name = "Sub", Text = "", Font = Builder.Font, Outline = 2, Size = UDim2.new(1, -30, 0, 22), Position = UDim2.fromOffset(15, 54), Parent = banner })

	local chase = panel(gui, "Chase", Builder.Colors.Red, UDim2.fromOffset(470, 78), UDim2.new(0.5, 0, 0, 100), 22)
	chase.AnchorPoint = Vector2.new(0.5, 0)
	chase.Visible = false
	text({ Name = "Title", Text = "", Size = UDim2.new(1, -70, 0, 34), Position = UDim2.fromOffset(52, 6), Outline = 3.5, Parent = chase })
	local rageTrack = make("Frame", { Name = "Bar", BackgroundColor3 = INK, Size = UDim2.new(1, -70, 0, 20), Position = UDim2.fromOffset(52, 46), ZIndex = 3, Parent = chase }, { corner(10) })
	make("Frame", { Name = "Fill", BackgroundColor3 = WHITE, Size = UDim2.fromScale(0, 1), ZIndex = 4, Parent = rageTrack }, { corner(10), Builder.Gradient({ Color3.fromRGB(255, 220, 70), Color3.fromRGB(255, 40, 60) }, 0) })
	text({ Name = "Text", Text = "", Font = Builder.Font, Outline = 2, Size = UDim2.new(1, -8, 1, -2), Position = UDim2.fromOffset(4, 1), ZIndex = 5, Parent = rageTrack })
	icon(chase, "RageIcon", Config.Icons.Rage, UDim2.fromOffset(84, 84), UDim2.fromOffset(-36, -4), "!")

	local carry = panel(gui, "Carry", Builder.Colors.Window, UDim2.fromOffset(440, 96), UDim2.new(0.5, 0, 1, -100), 22)
	carry.AnchorPoint = Vector2.new(0.5, 1)
	carry.Visible = false
	text({ Name = "Header", Text = "CARRYING", Font = Builder.Font, Outline = 2, TextColor3 = Color3.fromRGB(210, 205, 240), Size = UDim2.new(1, -30, 0, 20), Position = UDim2.fromOffset(15, 6), Parent = carry })
	text({ Name = "Title", Text = "", Size = UDim2.new(1, -30, 0, 36), Position = UDim2.fromOffset(15, 26), Outline = 3.5, Parent = carry })
	text({ Name = "Hint", Text = "", Font = Builder.Font, Outline = 2, TextColor3 = Color3.fromRGB(120, 255, 170), Size = UDim2.new(1, -30, 0, 22), Position = UDim2.fromOffset(15, 64), Parent = carry })

	make("Frame", {
		Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 186), Size = UDim2.fromOffset(520, 260), Parent = gui,
	}, { make("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }) })
	text({ Name = "Splash", Text = "", Visible = false, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.fromOffset(560, 96), Outline = 5, Parent = gui })
	text({ Name = "SplashSub", Text = "", Visible = false, Font = Builder.Font, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(460, 40), Outline = 3, TextColor3 = Color3.fromRGB(255, 220, 90), Parent = gui })

	-- Windows ---------------------------------------------------------------------------
	local _, trailBody = window(gui, "TrailsWindow", "TRAIL SHOP", Builder.Colors.Pink, Vector2.new(780, 480))
	make("ScrollingFrame", {
		Name = "Cards", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 1, -32), ScrollingDirection = Enum.ScrollingDirection.X,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollBarThickness = 8, ScrollBarImageColor3 = Color3.fromRGB(255, 170, 230), Parent = trailBody,
	}, {
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 14), VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
		make("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }),
	})
	for index = 1, #Config.Trails do
		trailCard(trailBody.Cards, index)
	end
	text({ Name = "Status", Text = "Trails multiply your running speed!", Font = Builder.Font, Outline = 2, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 26), Parent = trailBody })

	local _, shopBody = window(gui, "ShopWindow", "SHOP", Builder.Colors.Green, Vector2.new(760, 540))
	local tabs = make("Frame", { Name = "Tabs", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), Parent = shopBody }, {
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 12), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	for n, tab in { { "Cash", "CASH", Builder.Colors.Green }, { "Speed", "SPEED", Builder.Colors.Blue }, { "Upgrades", "UPGRADES", Builder.Colors.Orange } } do
		button(tabs, tab[1], tab[3], UDim2.fromOffset(170, 44), UDim2.new(), tab[2], 14).LayoutOrder = n
	end
	local pages = make("Frame", { Name = "Pages", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -60), Position = UDim2.fromOffset(0, 58), Parent = shopBody })
	local cashPage = page(pages, "Cash", Vector2.new(216, 196))
	cashPage.Visible = true
	for n, pack in Config.CashPacks do
		packCard(cashPage, "Pack" .. n, Builder.Colors.Cash, Config.Icons[pack.Icon] or "", "💵", "$" .. Config.Format(pack.Amount), pack.Robux, n)
	end
	local speedPage = page(pages, "Speed", Vector2.new(216, 196))
	for n, pack in Config.SpeedPacks do
		packCard(speedPage, "Pack" .. n, Builder.Colors.Sky, Config.Icons[pack.Icon] or "", "👟", string.format('&lt;font color="#7CFF5A"&gt;+%d&lt;/font&gt; SPEED', pack.Amount), pack.Robux, n)
	end
	local upgradePage = page(pages, "Upgrades")
	upgradeCard(upgradePage, "Speed", "SPEED", "+" .. Config.SpeedPerLevel .. " walk speed per level", Builder.Colors.Blue, Config.Icons.Speed, "⚡", 1)
	upgradeCard(upgradePage, "Storage", "STORAGE", "+" .. Config.CapacityStep .. " egg slots in your base", Builder.Colors.Pink, Config.Icons.Egg, "🥚", 2)
	upgradeCard(upgradePage, "Treadmill", "TREADMILL", "New design and +" .. Config.TreadSpeedPerLevel .. " speed per level", Builder.Colors.Purple, Config.Icons.Treadmill or "", "🏃", 3)

	local _, indexBody = window(gui, "IndexWindow", "EGG INDEX", Builder.Colors.Blue, Vector2.new(640, 520))
	make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = indexBody })
	local headerRow = make("Frame", { Name = "Header", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 0, Parent = indexBody })
	for n, column in { { "RARITY", 0.06, 0.34 }, { "INCOME", 0.4, 0.18 }, { "FOREST", 0.6, 0.18 }, { "SHADOW", 0.8, 0.18 } } do
		text({ Name = "Col" .. n, Text = column[1], Font = Builder.Font, Outline = 2, TextColor3 = Color3.fromRGB(220, 210, 255), Position = UDim2.fromScale(column[2], 0), Size = UDim2.fromScale(column[3], 1), Parent = headerRow })
	end
	local forest, shadowW = Config.RarityWeights(1), Config.RarityWeights(#Config.Zones)
	local forestTotal, shadowTotal = 0, 0
	for i = 1, #forest do
		forestTotal += forest[i]
		shadowTotal += shadowW[i]
	end
	for i, rarity in Config.Rarities do
		local row = panel(indexBody, rarity.Name, { rarity.Color:Lerp(Color3.new(0, 0, 0), 0.25), rarity.Shade:Lerp(Color3.new(0, 0, 0), 0.6) }, UDim2.new(1, -8, 0, 52), UDim2.new(), 14)
		row.LayoutOrder = i
		icon(row, "Egg", Config.Icons.Egg, UDim2.fromOffset(44, 44), UDim2.fromOffset(6, 4), "🥚")
		text({ Name = "Name", Text = rarity.Name:upper(), TextXAlignment = LEFT, Position = UDim2.new(0.06, 26, 0, 10), Size = UDim2.new(0.34, -26, 0, 32), Parent = row })
		text({ Name = "Income", Text = "x" .. rarity.Multiplier, Position = UDim2.new(0.4, 0, 0, 10), Size = UDim2.new(0.18, 0, 0, 32), Parent = row })
		text({ Name = "Forest", Text = string.format("%.1f%%", forest[i] / forestTotal * 100), Font = Builder.Font, Position = UDim2.new(0.6, 0, 0, 12), Size = UDim2.new(0.18, 0, 0, 28), Parent = row })
		text({ Name = "Shadow", Text = string.format("%.1f%%", shadowW[i] / shadowTotal * 100), Font = Builder.Font, Position = UDim2.new(0.8, 0, 0, 12), Size = UDim2.new(0.18, 0, 0, 28), Parent = row })
	end

	local _, rewardsBody = window(gui, "RewardsWindow", "FREE GIFT", Builder.Colors.Orange, Vector2.new(460, 440))
	icon(rewardsBody, "Gift", Config.Icons.Rewards, UDim2.fromOffset(150, 150), UDim2.new(0.5, -75, 0, 18), "🎁")
	text({ Name = "Info", Text = "Claim a cash gift every 15 minutes!", Font = Builder.Font, Outline = 2, Position = UDim2.fromOffset(10, 176), Size = UDim2.new(1, -20, 0, 26), Parent = rewardsBody })
	text({ Name = "Amount", Text = "+$500", TextColor3 = Color3.fromRGB(255, 225, 90), Position = UDim2.fromOffset(10, 206), Size = UDim2.new(1, -20, 0, 48), Outline = 4, Parent = rewardsBody })
	button(rewardsBody, "Claim", Builder.Colors.Green, UDim2.new(1, -80, 0, 60), UDim2.new(0, 40, 0, 270), "CLAIM", 18)

	local _, settingsBody = window(gui, "SettingsWindow", "SETTINGS", Builder.Colors.Steel, Vector2.new(480, 400))
	make("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = settingsBody })
	make("UIPadding", { PaddingTop = UDim.new(0, 16), Parent = settingsBody })
	toggleRow(settingsBody, "Music", "MUSIC", 1)
	toggleRow(settingsBody, "Sounds", "SOUND EFFECTS", 2)
	toggleRow(settingsBody, "Shake", "CAMERA SHAKE", 3)
	toggleRow(settingsBody, "Particles", "ZONE PARTICLES", 4)

	gui.Parent = parent
	return gui
end

return Builder
</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript">
          <Properties>
            <string name="Name">Fx</string>
            <ProtectedString name="Source">-- Client-side world effects: monster animation, treadmill belts, sounds, camera shake,
-- knockback, particle bursts and per-zone lighting.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("MonsterEgg")
local Config = require(Shared:WaitForChild("Config"))
local Monsters = require(Shared:WaitForChild("Monsters"))

local player = Players.LocalPlayer
local Fx = {}

type Tracked = { Pose: Monsters.Pose, Root: BasePart, Last: Vector3, Speed: number, Sleep: number }
local tracked: { [Model]: Tracked } = {}
local belts: { Texture } = {}
local shake = { Strength = 0, Until = 0 }
local boostUntil, boostLevel = 0, 0

local function track(model: Instance)
	if not model:IsA("Model") or tracked[model] then
		return
	end
	local root = model:WaitForChild("Root", 5) :: BasePart?
	if not root then
		return
	end
	tracked[model] = {
		Pose = Monsters.Collect(model),
		Root = root,
		Last = root.Position,
		Speed = 0,
		Sleep = if model:GetAttribute("Sleeping") then 1 else 0,
	}
end

function Fx.Init(world: Instance)
	local monsterFolder = world:WaitForChild("Runtime"):WaitForChild("Monsters")
	for _, model in monsterFolder:GetChildren() do
		task.spawn(track, model)
	end
	monsterFolder.ChildAdded:Connect(function(model)
		task.wait(0.2)
		track(model)
	end)
	monsterFolder.ChildRemoved:Connect(function(model)
		tracked[model :: Model] = nil
	end)
	-- Treadmills are rebuilt on every upgrade, so keep collecting their belt textures.
	local bases = world:WaitForChild("Sanctuary"):WaitForChild("Bases")
	local function addBelt(item: Instance)
		if item:IsA("Texture") and item.Name == "Stripes" then
			table.insert(belts, item)
		end
	end
	for _, item in bases:GetDescendants() do
		addBelt(item)
	end
	bases.DescendantAdded:Connect(addBelt)
	RunService:BindToRenderStep("MonsterEggShake", Enum.RenderPriority.Camera.Value + 1, function()
		local now = os.clock()
		if now &lt; shake.Until then
			local fade = (shake.Until - now)
			local s = shake.Strength * math.min(fade * 2, 1)
			local camera = Workspace.CurrentCamera
			camera.CFrame *= CFrame.Angles(math.noise(now * 25, 1) * s * 0.05, math.noise(now * 25, 2) * s * 0.05, 0)
		end
	end)
end

function Fx.Step(t: number, dt: number)
	local camera = Workspace.CurrentCamera.CFrame.Position
	for model, info in tracked do
		if not model.Parent then
			tracked[model] = nil
			continue
		end
		local position = info.Root.Position
		local velocity = (Vector3.new(position.X, 0, position.Z) - Vector3.new(info.Last.X, 0, info.Last.Z)).Magnitude / math.max(dt, 1e-3)
		info.Last = position
		info.Speed += (velocity - info.Speed) * math.min(dt * 8, 1)
		local target = if model:GetAttribute("Sleeping") then 1 else 0
		info.Sleep += (target - info.Sleep) * math.min(dt * 2.5, 1)
		if (position - camera).Magnitude &lt; 420 then
			Monsters.Animate(info.Pose, t, info.Sleep, math.clamp(info.Speed / 22, 0, 1), (model:GetAttribute("Rage") or 0) :: number)
		end
	end
	for i = #belts, 1, -1 do
		local texture = belts[i]
		if texture.Parent then
			texture.OffsetStudsV = (texture.OffsetStudsV - dt * 9) % 3
		else
			table.remove(belts, i)
		end
	end
	local camera = Workspace.CurrentCamera
	local targetFov = if os.clock() &lt; boostUntil then 70 + boostLevel * 0.8 else 70
	camera.FieldOfView += (targetFov - camera.FieldOfView) * math.min(dt * 4, 1)
end

-- Player settings (from the HUD Settings window) -------------------------------------

local options = { Sounds = true, Shake = true, Particles = true }

-- Ambient zone particles are part of the shared map, so they are only switched off locally.
local function setAmbient(enabled: boolean)
	local world = Workspace:FindFirstChild("MonsterEggEscape")
	if not world then
		return
	end
	for _, item in world:GetDescendants() do
		if item:IsA("ParticleEmitter") and item.Name == "Ambient" then
			item.Enabled = enabled
		end
	end
end

function Fx.SetOption(name: string, enabled: boolean)
	options[name] = enabled
	if name == "Particles" then
		setAmbient(enabled)
	end
end

-- Sounds ---------------------------------------------------------------------------

function Fx.Sound(name: string, at: Instance?)
	local info = Config.Sounds[name]
	if not info or not options.Sounds then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = info.Id
	sound.PlaybackSpeed = info.Pitch or 1
	sound.Volume = info.Volume
	if at then
		sound.RollOffMaxDistance = 260
	end
	sound.Parent = at or Workspace.CurrentCamera
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	task.delay(8, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

function Fx.Shake(strength: number, duration: number)
	if not options.Shake then
		return
	end
	local now = os.clock()
	if now + duration &gt; shake.Until or strength &gt; shake.Strength then
		shake.Strength = math.max(strength, if now &lt; shake.Until then shake.Strength else 0)
		shake.Until = now + duration
	end
end

local function rootPart(): BasePart?
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

function Fx.Burst(color: Color3, count: number, size: number?)
	local root = rootPart()
	if not root or not options.Particles then
		return
	end
	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size or 1.2), NumberSequenceKeypoint.new(1, 0) })
	emitter.Speed = NumberRange.new(14, 28)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Acceleration = Vector3.new(0, -20, 0)
	emitter.Rate = 0
	emitter.Parent = attachment
	emitter:Emit(count)
	task.delay(2, function()
		attachment:Destroy()
	end)
end

-- Little "+$5" popups above the player's head.
function Fx.Float(text: string, color: Color3)
	local root = rootPart()
	if not root then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(160, 40)
	gui.StudsOffsetWorldSpace = Vector3.new(math.random(-15, 15) / 10, 3.5, 0)
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Adornee = root
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color
	label.Parent = gui
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(20, 14, 40)
	stroke.Parent = label
	gui.Parent = player:WaitForChild("PlayerGui")
	TweenService:Create(gui, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffsetWorldSpace = gui.StudsOffsetWorldSpace + Vector3.new(0, 3, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(1.1), { TextTransparency = 1 }):Play()
	TweenService:Create(stroke, TweenInfo.new(1.1), { Transparency = 1 }):Play()
	task.delay(1.2, function()
		gui:Destroy()
	end)
end

-- Running on your own treadmill: speed lines at your feet and a slightly wider view.
function Fx.RunBoost(color: Color3, level: number)
	boostUntil = os.clock() + 1.3
	boostLevel = level
	local root = rootPart()
	if not root then
		return
	end
	local emitter = root:FindFirstChild("SpeedLines", true) :: ParticleEmitter?
	if not emitter then
		local attachment = Instance.new("Attachment")
		attachment.Name = "SpeedLinesAt"
		attachment.Position = Vector3.new(0, -2.6, 0.8)
		attachment.Parent = root
		local e = Instance.new("ParticleEmitter")
		e.Name = "SpeedLines"
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Rate = 0
		e.Speed = NumberRange.new(10, 18)
		e.EmissionDirection = Enum.NormalId.Back
		e.SpreadAngle = Vector2.new(15, 15)
		e.Lifetime = NumberRange.new(0.3, 0.5)
		e.LightEmission = 1
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
		e.Parent = attachment
		emitter = e
	end
	local e = emitter :: ParticleEmitter
	e.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	e:Emit(6 + level * 2)
end

function Fx.Knockback(from: Vector3)
	local root = rootPart()
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		return
	end
	local away = Vector3.new(root.Position.X - from.X, 0, root.Position.Z - from.Z)
	if away.Magnitude &lt; 0.1 then
		away = Vector3.new(0, 0, -1)
	end
	humanoid:ChangeState(Enum.HumanoidStateType.FallingDown)
	root.AssemblyLinearVelocity = away.Unit * 70 + Vector3.new(0, 45, 0)
	task.delay(1.1, function()
		if humanoid.Health &gt; 0 then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

-- Music: one looping track per zone, cross-faded when you change zone ----------------

local musicTracks: { [string]: Sound } = {}
local currentTrack: Sound? = nil
local musicEnabled = true

local function musicTrack(id: string): Sound?
	if not id:match("^rbxassetid://%d+$") then
		return nil
	end
	local sound = musicTracks[id]
	if not sound then
		local s = Instance.new("Sound")
		s.Name = "ZoneMusic"
		s.SoundId = id
		s.Looped = true
		s.Volume = 0
		s.Parent = game:GetService("SoundService")
		musicTracks[id] = s
		sound = s
	end
	return sound
end

function Fx.PlayMusic(zone: number)
	local id = if zone == 0 then Config.Music.Sanctuary else Config.Music.Zones[zone]
	local nextTrack = id and musicTrack(id)
	if nextTrack == currentTrack then
		return
	end
	local fade = TweenInfo.new(1.5, Enum.EasingStyle.Quad)
	local previous = currentTrack
	if previous then
		local out = TweenService:Create(previous, fade, { Volume = 0 })
		out.Completed:Once(function()
			if currentTrack ~= previous then
				previous:Pause()
			end
		end)
		out:Play()
	end
	currentTrack = nextTrack
	if nextTrack then
		if not nextTrack.IsPlaying then
			nextTrack:Play()
		end
		TweenService:Create(nextTrack, fade, { Volume = if musicEnabled then Config.Music.Volume else 0 }):Play()
	end
end

function Fx.SetMusicEnabled(enabled: boolean)
	musicEnabled = enabled
	if currentTrack then
		TweenService:Create(currentTrack, TweenInfo.new(0.4), { Volume = if enabled then Config.Music.Volume else 0 }):Play()
	end
end

-- Zone ambience ---------------------------------------------------------------------

local SANCTUARY_FOG = Color3.fromRGB(200, 230, 255)

function Fx.SetZone(index: number)
	local atmosphere = Lighting:FindFirstChild("EggAtmosphere") :: Atmosphere?
	local cc = Lighting:FindFirstChild("EggColor") :: ColorCorrectionEffect?
	local zone = Config.Zones[index]
	local fog = if zone then zone.Fog else SANCTUARY_FOG
	local tint = if zone then Color3.new(1, 1, 1):Lerp(zone.Fog, 0.12) else Color3.new(1, 1, 1)
	local info = TweenInfo.new(1.2, Enum.EasingStyle.Quad)
	if atmosphere then
		TweenService:Create(atmosphere, info, { Color = fog, Density = if index &gt;= 4 then 0.32 else 0.22 }):Play()
	end
	if cc then
		TweenService:Create(cc, info, { TintColor = tint }):Play()
	end
	TweenService:Create(Lighting, info, { ClockTime = if index == 6 then 18.6 elseif index &gt;= 4 then 16.5 else 14.2 }):Play()
	Fx.PlayMusic(index)
end

return Fx
</ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>